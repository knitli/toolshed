{
  "name": "@knitli/toolshed",
  "displayName": "Knitli Agent Toolshed",
  "private": true,
  "description": "A marketplace of tools and plugins for AI agents like Claude. Browse, install, and manage a curated collection of MCP tools, context hygiene plugins, security utilities, and more to supercharge your AI-assisted workflows.",
  "keywords": [
    "claude",
    "tools",
    "plugins",
    "mcp",
    "marketplace",
    "security",
    "context",
    "hygiene",
    "skills"
  ],
  "version": "1.0.0",
  "homepage": "https://knitli.com",
  "bugs": {
    "url": "https://github.com/knitli/toolshed/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knitli/toolshed"
  },
  "license": "MIT OR Apache-2.0",
  "author": {
    "name": "Knitli Inc.",
    "email": "hello@knitli.com"
  },
  "workspaces": {
    "packages": [
      "plugins/*",
      "packages/*"
    ],
    "catalog": {
      "bun": "^1.3.12",
      "node": "^24.0.0"
    },
    "catalogs": {
      "release": {
        "semantic-release": "^25.0.9",
        "semantic-release-monorepo": "^8.0.2",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@commitlint/resolve-extends": "^21.2.2"
      },
      "typing": {
        "typescript": "^7.0.2"
      }
    }
  },
  "scripts": {
    "generate": "bun scripts/generate.mts",
    "validate": "./scripts/validate-marketplace.sh && bun scripts/generate.mts --check"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:release",
    "@commitlint/config-conventional": "catalog:release",
    "@commitlint/resolve-extends": "catalog:release",
    "@semantic-release/changelog": "catalog:release",
    "@semantic-release/commit-analyzer": "catalog:release",
    "@semantic-release/git": "catalog:release",
    "@semantic-release/github": "catalog:release",
    "@semantic-release/npm": "catalog:release",
    "@semantic-release/release-notes-generator": "catalog:release",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "semantic-release": "catalog:release",
    "semantic-release-monorepo": "catalog:release"
  },
  "engines": {
    "node": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "catalog:",
      "onFail": "download"
    },
    "runtime": {
      "name": "bun",
      "version": "catalog:",
      "onFail": "download"
    }
  },
  "icon": "https://knitli.com/favicon.ico",
  "readme": "./README.md"
}
