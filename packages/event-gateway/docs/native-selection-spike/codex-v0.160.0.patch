diff --git a/codex-rs/tui/src/app/selection_witness.rs b/codex-rs/tui/src/app/selection_witness.rs
new file mode 100644
index 0000000..7b52a75
--- /dev/null
+++ b/codex-rs/tui/src/app/selection_witness.rs
@@ -0,0 +1,251 @@
+//! Unix-only, disposable observation witness. This grants no ingress or execution authority.
+//! The UI loop owns publication and heartbeats; no independent helper can extend its lease.
+
+use super::*;
+use serde::Serialize;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::os::unix::fs::FileTypeExt;
+use std::os::unix::fs::OpenOptionsExt;
+use uuid::Uuid;
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct SelectionState {
+    client_id: Uuid,
+    backend_pid: Option<u32>,
+    connection_id: Option<Uuid>,
+    thread_id: Option<ThreadId>,
+    generation: u64,
+    eligible: bool,
+    sequence: u64,
+    cause: &'static str,
+}
+
+impl SelectionState {
+    fn new() -> Self {
+        Self {
+            client_id: Uuid::new_v4(),
+            backend_pid: None,
+            connection_id: None,
+            thread_id: None,
+            generation: 0,
+            eligible: false,
+            sequence: 0,
+            cause: "startup",
+        }
+    }
+
+    fn select(&mut self, thread: Option<ThreadId>, ready: bool) -> bool {
+        let eligible = ready && thread.is_some() && self.backend_pid.is_some();
+        if self.thread_id == thread && self.eligible == eligible {
+            return false;
+        }
+        self.generation += 1;
+        self.thread_id = thread;
+        self.eligible = eligible;
+        true
+    }
+
+    fn expire_after_loop_gap(&mut self, elapsed: Duration) -> bool {
+        if elapsed >= Duration::from_millis(/*millis*/ 750) {
+            return self.select(self.thread_id, false);
+        }
+        false
+    }
+
+    fn connected(&mut self, pid: Option<u32>) {
+        self.generation += 1;
+        self.backend_pid = pid;
+        self.connection_id = Some(Uuid::new_v4());
+        self.eligible = false;
+    }
+}
+
+pub(super) struct SelectionWitness {
+    output: Option<File>,
+    state: SelectionState,
+    last_emission: Instant,
+}
+
+impl SelectionWitness {
+    pub(super) fn from_env() -> Self {
+        let output = std::env::var_os("CODEX_SELECTION_WITNESS_PIPE").and_then(|path| {
+            let metadata = std::fs::symlink_metadata(&path).ok()?;
+            if !metadata.file_type().is_fifo() {
+                return None;
+            }
+            OpenOptions::new()
+                .write(true)
+                .custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW)
+                .open(path)
+                .ok()
+        });
+        let mut witness = Self {
+            output,
+            state: SelectionState::new(),
+            last_emission: Instant::now(),
+        };
+        witness.emit("startup");
+        witness
+    }
+
+    pub(super) async fn connected(&mut self, server: &AppServerSession) {
+        self.revoke("connecting");
+        if self.output.is_none() {
+            return;
+        }
+        let handle = server.request_handle();
+        let request = codex_app_server_protocol::ClientRequest::ServerDiagnostics {
+            request_id: codex_app_server_protocol::RequestId::String(format!(
+                "selection-witness-{}",
+                Uuid::new_v4()
+            )),
+            params: codex_app_server_protocol::ServerDiagnosticsParams::default(),
+        };
+        let response: Result<codex_app_server_protocol::ServerDiagnosticsResponse, _> =
+            match tokio::time::timeout(
+                Duration::from_secs(/*secs*/ 2),
+                handle.request_typed(request),
+            )
+            .await
+            {
+                Ok(result) => result,
+                Err(_) => {
+                    self.state.connected(None);
+                    self.emit("diagnostics-timeout");
+                    return;
+                }
+            };
+        self.state
+            .connected(response.ok().map(|response| response.process.id));
+        self.emit("connected");
+    }
+
+    pub(super) fn publish(&mut self, thread: Option<ThreadId>, ready: bool) {
+        if self.state.select(thread, ready) {
+            self.emit("state");
+        }
+    }
+
+    pub(super) fn revoke(&mut self, cause: &'static str) {
+        if self.state.select(self.state.thread_id, false) {
+            self.emit(cause);
+        }
+    }
+
+    pub(super) fn emit(&mut self, cause: &'static str) {
+        let Some(output) = self.output.as_mut() else {
+            return;
+        };
+        let cause = if self
+            .state
+            .expire_after_loop_gap(self.last_emission.elapsed())
+        {
+            "loop-gap"
+        } else {
+            cause
+        };
+        self.last_emission = Instant::now();
+        self.state.sequence += 1;
+        self.state.cause = cause;
+        let Ok(mut line) = serde_json::to_vec(&self.state) else {
+            self.output = None;
+            return;
+        };
+        line.push(b'\n');
+        // ponytail: one small atomic nonblocking FIFO write; any failure ends this witness.
+        // The receiver expires its lease; production would need an authenticated native contract.
+        if line.len() > 512 || output.write(&line).ok() != Some(line.len()) {
+            self.output = None;
+        }
+    }
+}
+
+impl Drop for SelectionWitness {
+    fn drop(&mut self) {
+        self.revoke("exit");
+    }
+}
+
+impl App {
+    pub(super) fn selection_witness_ready(&self) -> bool {
+        self.active_thread_id.is_some_and(|id| {
+            self.chat_widget.thread_id() == Some(id)
+                && self
+                    .thread_event_channels
+                    .get(&id)
+                    .is_some_and(|channel| channel.attachment() == ThreadEventAttachment::Live)
+        }) && self
+            .active_thread_rx
+            .as_ref()
+            .is_some_and(tokio::sync::mpsc::Receiver::is_empty)
+            && self.chat_widget.selection_witness_ready()
+            && self.overlay.is_none()
+            && !self.reconnect.offline
+            && !self.reconnect.failed
+            && self.pending_thread_switch_resets == 0
+            && !self.pending_open_resume_picker
+            && self.pending_working_directory_change.is_none()
+            && self.pending_start_managed_worktree.is_none()
+            && !self.pending_managed_worktree_creation
+            && self.pending_managed_worktree_created.is_none()
+            && self.pending_managed_worktree_transition.is_none()
+            && self.pending_managed_worktree_attach.is_none()
+            && self.pending_shutdown_exit_thread_id.is_none()
+            && !self.pending_startup_thread_start
+            && !self.startup_pending_protected_request
+            && !self.has_queued_startup_protected_request()
+            && self.pending_primary_events.is_empty()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn delayed_loop_revokes_before_renewal() {
+        let mut state = SelectionState::new();
+        let thread = Some(ThreadId::new());
+        state.connected(Some(123));
+        state.select(thread, true);
+        let selected = state.generation;
+        assert!(!state.expire_after_loop_gap(Duration::from_millis(/*millis*/ 749)));
+        assert!(state.eligible);
+        assert!(state.expire_after_loop_gap(Duration::from_millis(/*millis*/ 750)), "delayed loop must revoke before renewing");
+        assert!(!state.eligible, "delayed loop must revoke before renewing");
+        assert!(state.generation > selected);
+        let revoked = state.generation;
+        state.select(thread, true);
+        assert!(state.eligible && state.generation > revoked);
+    }
+
+    #[test]
+    fn revocation_and_reconnect_never_reuse_selection_generation() {
+        let mut state = SelectionState::new();
+        let thread = Some(ThreadId::new());
+        state.select(thread, true);
+        assert!(!state.eligible, "no backend identity means unavailable");
+        state.connected(Some(123));
+        let connection = state.connection_id;
+        state.select(thread, true);
+        let selected = state.generation;
+        assert!(state.eligible);
+        state.select(thread, false);
+        assert!(!state.eligible, "revocation must clear eligibility");
+        assert!(state.generation > selected);
+        let revoked = state.generation;
+        state.select(thread, true);
+        assert!(state.eligible && state.generation > revoked);
+        state.connected(Some(123));
+        assert!(
+            !state.eligible,
+            "reconnect never inherits selected authority"
+        );
+        assert_ne!(state.connection_id, connection);
+        state.select(None, true);
+        assert!(!state.eligible, "no selected thread means unavailable");
+    }
+}
