(version 1)
(deny default)
(deny network*)
(deny process-fork)
(allow process-exec (literal "/Users/adampoulemanos/.local/share/mise/installs/node/24.21.0/bin/node"))
(allow process-info* (target self))
(allow sysctl-read)
(allow file-read-metadata
  (literal "/")
  (literal "/Users")
  (literal "/Users/adampoulemanos")
  (literal "/Users/adampoulemanos/.local")
  (literal "/Users/adampoulemanos/.local/share")
  (literal "/Users/adampoulemanos/.local/share/mise")
  (literal "/Users/adampoulemanos/.local/share/mise/installs")
  (literal "/Users/adampoulemanos/.local/share/mise/installs/node")
  (literal "/Users/adampoulemanos/.local/share/mise/installs/node/24.21.0")
  (literal "/Users/adampoulemanos/.local/share/mise/installs/node/24.21.0/bin")
  (literal "/private")
  (literal "/private/tmp")
  (literal "/private/tmp/reviewer-sdk-process-protocol-20261017")
  (literal "/private/tmp/reviewer-sdk-process-protocol-20261017/frozen"))
(allow file-read*
  (literal "/private/tmp/reviewer-sdk-process-protocol-20261017/fixture.mjs")
  (literal "/private/tmp/reviewer-sdk-process-protocol-20261017/frozen/sdk.mjs")
  (literal "/private/tmp/reviewer-sdk-process-protocol-20261017/frozen/reviewer-completion-driver.mjs")
  (literal "/Users/adampoulemanos/.local/share/mise/installs/node/24.21.0/bin/node")
  (subpath "/System/Library")
  (subpath "/usr/lib")
  (subpath "/private/var/db/dyld")
  (literal "/dev/urandom")
  (literal "/dev/random")
  (literal "/dev/null"))
(allow file-read* (subpath (param "SCRATCH")))
(allow file-write* (subpath (param "SCRATCH")))
(allow file-map-executable
  (literal "/Users/adampoulemanos/.local/share/mise/installs/node/24.21.0/bin/node")
  (subpath "/System/Library")
  (subpath "/usr/lib")
  (subpath "/private/var/db/dyld"))

(allow file-read-data (literal "/"))
