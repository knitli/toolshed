(version 1)
(deny default)
; Unqualified policy: do not widen after a failure without separate review.
(allow process-fork)
(allow process-exec
  (literal "/Users/adampoulemanos/.local/share/mise/installs/node/24.21.0/bin/node")
  (literal "/Applications/Docker.app/Contents/Resources/bin/docker"))
(allow process-info* (target self))
(allow sysctl-read)
(allow file-read-metadata
  (literal "/")
  (literal "/Applications")
  (literal "/Applications/Docker.app")
  (literal "/Applications/Docker.app/Contents")
  (literal "/Applications/Docker.app/Contents/Resources")
  (literal "/Applications/Docker.app/Contents/Resources/bin")
  (literal "/Users")
  (literal "/Users/adampoulemanos")
  (literal "/Users/adampoulemanos/.docker")
  (literal "/Users/adampoulemanos/.docker/run")
  (literal "/Users/adampoulemanos/.local")
  (literal "/Users/adampoulemanos/.local/share")
  (literal "/Users/adampoulemanos/.local/share/mise")
  (literal "/Users/adampoulemanos/.local/share/mise/installs")
  (literal "/Users/adampoulemanos/.local/share/mise/installs/node")
  (literal "/Users/adampoulemanos/.local/share/mise/installs/node/24.21.0")
  (literal "/Users/adampoulemanos/.local/share/mise/installs/node/24.21.0/bin")
  (literal "/private")
  (literal "/private/tmp")
  (literal "/private/tmp/reviewer-docker-sdk-adapter-20261017")
  (literal "/private/tmp/reviewer-docker-sdk-integration-20261017")
  (literal "/private/tmp/reviewer-sdk-process-protocol-20261017")
  (literal "/private/tmp/reviewer-sdk-process-protocol-20261017/frozen")
  (literal "/usr")
  (literal "/usr/local")
  (literal "/usr/local/bin"))
(allow file-read*
  (literal "/private/tmp/reviewer-docker-sdk-integration-20261017/fixture.mjs")
  (literal "/private/tmp/reviewer-sdk-process-protocol-20261017/frozen/sdk.mjs")
  (literal "/private/tmp/reviewer-sdk-process-protocol-20261017/frozen/reviewer-completion-driver.mjs")
  (literal "/private/tmp/reviewer-docker-sdk-adapter-20261017/adapter.mjs")
  (literal "/Users/adampoulemanos/.local/share/mise/installs/node/24.21.0/bin/node")
  (literal "/Applications/Docker.app/Contents/Resources/bin/docker")
  (literal "/usr/local/bin/docker")
  (literal "/dev/urandom")
  (literal "/dev/random")
  (literal "/dev/null")
  (subpath "/System/Library")
  (subpath "/usr/lib")
  (subpath "/private/var/db/dyld"))
(allow file-map-executable
  (literal "/Users/adampoulemanos/.local/share/mise/installs/node/24.21.0/bin/node")
  (literal "/Applications/Docker.app/Contents/Resources/bin/docker")
  (subpath "/System/Library")
  (subpath "/usr/lib")
  (subpath "/private/var/db/dyld"))
(allow file-read-data (literal "/"))
(allow file-read* (subpath (param "SCRATCH")))
(allow file-write* (subpath (param "SCRATCH")))
(allow file-read-metadata (literal "/Users/adampoulemanos/.docker/run/docker.sock"))
; Default deny excludes IP and every other Unix socket.
(allow network-outbound (remote unix-socket (literal "/Users/adampoulemanos/.docker/run/docker.sock")))
