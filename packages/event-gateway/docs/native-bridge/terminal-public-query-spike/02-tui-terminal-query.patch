+#[test]
+fn terminal_evidence_validates_native_identity_and_echoes_original_attempt() {
+    use codex_app_server_protocol::NativeTurnTerminalStatus;
+    use codex_app_server_protocol::ThreadTerminalEvidenceResponse;
+    let event = event();
+    let receipt_id = Uuid::now_v7().to_string();
+    let item_id = Uuid::now_v7().to_string();
+    for status in [
+        NativeTurnTerminalStatus::Completed,
+        NativeTurnTerminalStatus::Failed,
+        NativeTurnTerminalStatus::Canceled,
+    ] {
+        let response = ThreadTerminalEvidenceResponse::Terminal {
+            item_id: item_id.clone(),
+            replayed: true,
+            turn_id: event.client_user_message_id.clone(),
+            receipt_id: receipt_id.clone(),
+            terminal_status: status,
+        };
+        let bytes = event.receipt(
+            42,
+            native_terminal_outcome(response, &event.client_user_message_id),
+            ReceiptVersion::V3,
+        );
+        let wire: serde_json::Value = serde_json::from_slice(&bytes).unwrap();
+        assert_eq!(
+            wire,
+            serde_json::json!({
+                "version": 3, "nonce": 42, "receipt": {
+                    "clientId": event.client_id, "generation": event.generation,
+                    "serverInstanceId": event.server_instance_id, "serverGeneration": event.server_generation,
+                    "threadId": event.thread_id, "attemptId": event.attempt_id, "deliveryId": event.delivery_id,
+                    "clientUserMessageId": event.client_user_message_id, "permitId": event.permit_id,
+                    "permitIssuedAt": event.permit_issued_at, "permitExpiresAt": event.permit_expires_at,
+                    "outcome": {"status": "terminal", "turnId": event.client_user_message_id,
+                        "receiptId": receipt_id, "terminalStatus": status, "itemId": item_id, "replayed": true}
+                }
+            })
+        );
+    }
+    for (turn_id, receipt_id) in [
+        (Uuid::new_v4().to_string(), receipt_id),
+        (event.client_user_message_id.clone(), "invalid".to_owned()),
+    ] {
+        assert_eq!(
+            native_terminal_outcome(
+                ThreadTerminalEvidenceResponse::Terminal {
+                    item_id: item_id.clone(),
+                    replayed: true,
+                    turn_id,
+                    receipt_id,
+                    terminal_status: NativeTurnTerminalStatus::Completed,
+                },
+                &event.client_user_message_id
+            ),
+            Outcome::Unknown
+        );
+    }
+    assert_eq!(
+        native_terminal_outcome(
+            ThreadTerminalEvidenceResponse::Unknown,
+            &event.client_user_message_id
+        ),
+        Outcome::Unknown
+    );
+    for (item_id, replayed) in [
+        (item_id, false),
+        ("invalid".to_owned(), true),
+        (event.client_user_message_id.clone(), true),
+    ] {
+        assert_eq!(
+            native_terminal_outcome(
+                ThreadTerminalEvidenceResponse::Terminal {
+                    turn_id: event.client_user_message_id.clone(),
+                    item_id,
+                    replayed,
+                    receipt_id: Uuid::now_v7().to_string(),
+                    terminal_status: NativeTurnTerminalStatus::Completed,
+                },
+                &event.client_user_message_id
+            ),
+            Outcome::Unknown
+        );
+    }
+}
