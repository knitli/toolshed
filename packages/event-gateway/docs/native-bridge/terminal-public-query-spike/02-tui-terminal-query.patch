+#[test]
+fn terminal_evidence_transport_requires_v3_and_preserves_original_identity() {
+    use std::os::fd::IntoRawFd;
+    let event = event();
+    for version in [ReceiptVersion::V2, ReceiptVersion::V3] {
+        let (mut parent, child) = UnixStream::pair().unwrap();
+        let mut transport = Transport::from_inherited_fd(child.into_raw_fd()).unwrap();
+        let mut state = SelectionState::new();
+        let frame = serde_json::json!({"nonce": 1, "terminalEvidence": event});
+        writeln!(parent, "{frame}").unwrap();
+        let result = transport.poll(&mut state, None, Some(version));
+        if version == ReceiptVersion::V2 {
+            assert_eq!(result.err().unwrap().stage, "challenge-size");
+            assert!(transport.operation.is_none());
+        } else {
+            assert!(
+                result.is_ok(),
+                "historical queries need no current selection binding"
+            );
+            let Some((nonce, Operation::TerminalEvidence(received))) = transport.operation.take()
+            else {
+                panic!("expected dedicated terminal evidence operation");
+            };
+            assert_eq!(nonce, 1);
+            assert_eq!(received, event);
+            assert_eq!(received.params(version), event.params(version));
+            writeln!(parent, "{frame}").unwrap();
+            assert_eq!(
+                transport
+                    .poll(&mut state, None, Some(version))
+                    .err()
+                    .unwrap()
+                    .stage,
+                "challenge-nonce"
+            );
+        }
+    }
+    // With native binding enabled, v2 reaches the operation guard rather than the frame cap.
+    let (mut parent, child) = UnixStream::pair().unwrap();
+    let mut transport = Transport::from_inherited_fd(child.into_raw_fd()).unwrap();
+    let binding = NativeBinding {
+        enabled: true,
+        ..Default::default()
+    };
+    writeln!(
+        parent,
+        "{}",
+        serde_json::json!({"nonce":1,"terminalEvidence":event})
+    )
+    .unwrap();
+    assert_eq!(
+        transport
+            .poll(
+                &mut SelectionState::new(),
+                binding.view(),
+                Some(ReceiptVersion::V2)
+            )
+            .err()
+            .unwrap()
+            .stage,
+        "challenge-operation"
+    );
+    assert!(transport.operation.is_none());
+}
