+fn native_terminal_outcome(
+    response: codex_app_server_protocol::ThreadTerminalEvidenceResponse,
+    expected_turn_id: &str,
+) -> Outcome {
+    match response {
+        codex_app_server_protocol::ThreadTerminalEvidenceResponse::Terminal {
+            turn_id,
+            item_id,
+            replayed: true,
+            receipt_id,
+            terminal_status,
+        } if turn_id == expected_turn_id
+            && canonical_uuid(&receipt_id)
+            && canonical_uuid(&item_id)
+            && item_id != expected_turn_id =>
+        {
+            Outcome::Terminal {
+                turn_id,
+                item_id,
+                replayed: true,
+                receipt_id,
+                terminal_status,
+            }
+        }
+        _ => Outcome::Unknown,
+    }
