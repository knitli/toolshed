+#[test]
+fn terminal_evidence_transport_rejects_mixed_operations() {
+    use std::os::fd::IntoRawFd;
+    let (mut parent, child) = UnixStream::pair().unwrap();
+    let mut transport = Transport::from_inherited_fd(child.into_raw_fd()).unwrap();
+    let frame = serde_json::json!({"nonce": 1, "terminalEvidence": event(), "receipt": event()});
+    writeln!(parent, "{frame}").unwrap();
+    assert_eq!(
+        transport
+            .poll(&mut SelectionState::new(), None, Some(ReceiptVersion::V3))
+            .err()
+            .unwrap()
+            .stage,
+        "challenge-operation"
+    );
+    assert!(transport.operation.is_none());
+}
