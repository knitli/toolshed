+#[tokio::test]
+async fn terminal_evidence_bridge_tick_bypasses_cached_input_without_start_or_selection_renewal() {
+    use codex_app_server_client::AppServerClient;
+    use codex_app_server_client::RemoteAppServerClient;
+    use codex_app_server_client::RemoteAppServerConnectArgs;
+    use codex_app_server_client::RemoteAppServerEndpoint;
+    use futures::SinkExt;
+    use futures::StreamExt;
+    use std::os::fd::IntoRawFd;
+    use tokio_tungstenite::tungstenite::Message;
+    let event = event();
+    let item_id = Uuid::now_v7().to_string();
+    let expected_params = serde_json::to_value(event.params(ReceiptVersion::V3).unwrap()).unwrap();
+    let terminal = serde_json::json!({"status":"terminal", "turnId":event.client_user_message_id,
+        "itemId":item_id, "receiptId":Uuid::now_v7().to_string(), "terminalStatus":"completed", "replayed":true});
+    let native_terminal = terminal.clone();
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let websocket_url = format!("ws://{}", listener.local_addr().unwrap());
+    let (finish, finished) = tokio::sync::oneshot::channel::<()>();
+    let peer = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+        let initialize: serde_json::Value =
+            serde_json::from_str(ws.next().await.unwrap().unwrap().to_text().unwrap()).unwrap();
+        assert_eq!(initialize["method"], "initialize");
+        ws.send(Message::Text(
+            serde_json::json!({"id":initialize["id"], "result":{"userAgent":"fixture"}})
+                .to_string()
+                .into(),
+        ))
+        .await
+        .unwrap();
+        let initialized: serde_json::Value =
+            serde_json::from_str(ws.next().await.unwrap().unwrap().to_text().unwrap()).unwrap();
+        assert_eq!(initialized["method"], "initialized");
+        let query: serde_json::Value =
+            serde_json::from_str(ws.next().await.unwrap().unwrap().to_text().unwrap()).unwrap();
+        assert_eq!(
+            query["method"], "thread/terminalEvidence",
+            "must not start or renew selection"
+        );
+        assert_eq!(query["params"], expected_params);
+        ws.send(Message::Text(
+            serde_json::json!({"id":query["id"], "result":native_terminal})
+                .to_string()
+                .into(),
+        ))
+        .await
+        .unwrap();
+        tokio::select! {
+            _ = finished => {},
+            extra = ws.next() => panic!("unexpected additional native RPC: {extra:?}"),
+        }
+    });
+    let client = RemoteAppServerClient::connect(RemoteAppServerConnectArgs {
+        endpoint: RemoteAppServerEndpoint::WebSocket {
+            websocket_url,
+            auth_token: None,
+        },
+        client_name: "terminal-evidence-test".to_owned(),
+        client_version: "0.0.0".to_owned(),
+        experimental_api: true,
+        mcp_server_openai_form_elicitation: false,
+        opt_out_notification_methods: Vec::new(),
+        channel_capacity: 8,
+    })
+    .await
+    .unwrap();
+    let server = AppServerSession::new(
+        AppServerClient::Remote(client),
+        crate::app_server_session::ThreadParamsMode::Remote,
+    );
+    let (mut parent, child) = UnixStream::pair().unwrap();
+    parent
+        .set_read_timeout(Some(Duration::from_secs(2)))
+        .unwrap();
+    let mut witness = SelectionWitness {
+        transport: Some(Transport::from_inherited_fd(child.into_raw_fd()).unwrap()),
+        receipt_version: Some(ReceiptVersion::V3),
+        state: SelectionState::new(),
+        last_poll: Instant::now(),
+        binding: NativeBinding {
+            enabled: true,
+            response: None,
+            sent_at: Some(Instant::now()),
+        },
+        attempts: AttemptLedger::default(),
+    };
+    witness.attempts.reserve(&event).unwrap();
+    let cached = Outcome::InputRecorded {
+        turn_id: event.client_user_message_id.clone(),
+        item_id,
+        replayed: true,
+    };
+    witness
+        .attempts
+        .cache_receipt_lookup_response(&event, cached.clone());
+    let selection = (
+        witness.state.thread_id,
+        witness.state.generation,
+        witness.state.eligible,
+    );
+    let lease = witness.binding.sent_at;
+    writeln!(
+        parent,
+        "{}",
+        serde_json::json!({"nonce":42,"terminalEvidence":event})
+    )
+    .unwrap();
+    tokio::time::timeout(Duration::from_secs(3), witness.bridge_tick(&server))
+        .await
+        .unwrap();
+    let mut line = String::new();
+    std::io::BufRead::read_line(&mut std::io::BufReader::new(&mut parent), &mut line).unwrap();
+    let wire: serde_json::Value = serde_json::from_str(&line).unwrap();
+    assert_eq!(wire["receipt"]["outcome"], terminal);
+    assert_eq!(wire["nonce"], 42);
+    assert_eq!(
+        (
+            witness.state.thread_id,
+            witness.state.generation,
+            witness.state.eligible
+        ),
+        selection
+    );
+    assert_eq!(witness.binding.sent_at, lease);
+    assert_eq!(witness.attempts.receipt(&event), Some(cached));
+    finish.send(()).unwrap();
+    peer.await.unwrap();
+}
