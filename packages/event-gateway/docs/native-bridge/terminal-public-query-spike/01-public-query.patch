+        "bridgeClientId":identity.bridge_client_id,"bridgeClientGeneration":identity.bridge_client_generation});
+    let mut previous = None;
+    for _ in 0..2 {
+        let mut app = TestAppServer::builder().with_codex_home(home.path()).without_auto_env().without_managed_config()
+            .with_env_overrides(&[("OPENAI_API_KEY", None), ("CODEX_SQLITE_HOME", None)])
+            .build_initialized().await?;
+        let selection = json!({"expectedGeneration":0,"threadId":null,"ready":false});
+        let id = app.send_request("client/selection/update", Some(selection.clone())).await?;
+        let before: ClientSelectionUpdateResponse = app.read_response(id).await?;
+        let id = app.send_request("thread/terminalEvidence", Some(params.clone())).await?;
+        let evidence: ThreadTerminalEvidenceResponse = app.read_response(id).await?;
+        let proof = db.get_native_turn_terminal_proof(&identity).await?.expect("native proof");
+        assert_eq!(evidence, ThreadTerminalEvidenceResponse::Terminal {
+            turn_id: identity.client_user_message_id.clone(), item_id: item_id.clone(), receipt_id: proof.receipt_id,
+            terminal_status: NativeTurnTerminalStatus::Completed, replayed: true,
+        });
+        if let Some(previous) = previous { assert_eq!(evidence, previous); }
+        previous = Some(evidence);
+        let id = app.send_request("client/selection/update", Some(selection)).await?;
+        assert_eq!(app.read_response::<ClientSelectionUpdateResponse>(id).await?, before);
+        let id = app.send_request("thread/loaded/list", Some(json!({}))).await?;
+        assert_eq!(app.read_response::<ThreadLoadedListResponse>(id).await?, ThreadLoadedListResponse { data: vec![], next_cursor: None });
+        let mut wrong = params.clone(); wrong["input"] = json!("different input");
+        let id = app.send_request("thread/terminalEvidence", Some(wrong)).await?;
+        assert_eq!(app.read_response::<ThreadTerminalEvidenceResponse>(id).await?, ThreadTerminalEvidenceResponse::Unknown);
+        assert_eq!(std::fs::read(&rollout)?, bytes);
+        assert!(app.shutdown_gracefully().await?.success());
+    }
+    Ok(())
+    }).await?
+}
