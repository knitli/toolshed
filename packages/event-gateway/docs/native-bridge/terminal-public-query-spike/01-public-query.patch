+async fn fixture() -> (
+    TempDir,
+    StateDbHandle,
+    LocalThreadStore,
+    ThreadStartIfIdleParams,
+    std::path::PathBuf,
+) {
+    let home = TempDir::new().unwrap();
+    let sqlite = SqliteConfig::new_for_testing(home.path().abs());
+    let state = StateRuntime::init(sqlite.clone(), "test-provider".into())
+        .await
+        .unwrap();
+    let params = ThreadStartIfIdleParams {
+        server_instance_id: Uuid::now_v7().to_string(),
+        expected_generation: 4,
+        thread_id: ThreadId::new().to_string(),
+        attempt_id: "attempt".into(),
+        delivery_id: "delivery".into(),
+        client_user_message_id: Uuid::now_v7().to_string(),
+        permit_id: "permit".into(),
+        permit_issued_at: 1,
+        permit_expires_at: 5001,
+        input: "exact historical input".into(),
+        bridge_client_id: Some(Uuid::now_v7().to_string()),
+        bridge_client_generation: Some(7),
+    };
+    state
+        .begin_native_turn_start(&identity_from_params(&params), &[])
+        .await
+        .unwrap();
+    let path = home.path().join("rollout.jsonl");
+    let thread_id = ThreadId::from_string(&params.thread_id).unwrap();
+    let mut metadata = codex_state::ThreadMetadataBuilder::new(
+        thread_id,
+        path.clone(),
+        chrono::Utc::now(),
+        SessionSource::Cli,
+    )
+    .build("test-provider");
+    metadata.history_mode = ThreadHistoryMode::Paginated;
+    state.upsert_thread(&metadata).await.unwrap();
+    let store = LocalThreadStore::new(
+        LocalThreadStoreConfig {
+            codex_home: home.path().to_owned(),
+            sqlite,
+            default_model_provider_id: "test-provider".into(),
+        },
+        Some(state.clone()),
+    );
+    (home, state, store, params, path)
+}
+
+fn history(params: &ThreadStartIfIdleParams, terminal: serde_json::Value) -> Vec<u8> {
+    let meta = SessionMeta {
+        id: ThreadId::from_string(&params.thread_id).unwrap(),
+        session_id: ThreadId::new().into(),
+        history_mode: ThreadHistoryMode::Paginated,
+        ..Default::default()
+    };
+    let records = [
+        serde_json::to_value(RolloutItem::SessionMeta(SessionMetaLine {
+            meta,
+            git: None,
+        }))
+        .unwrap(),
+        json!({"type":"event_msg","payload":{"type":"item_completed",
+            "thread_id":params.thread_id,"turn_id":params.client_user_message_id,
+            "item":{"type":"UserMessage","id":Uuid::now_v7().to_string(),"client_id":params.client_user_message_id,
+            "content":[{"type":"text","text":params.input,"text_elements":[]}]},"completed_at_ms":1}}),
+        json!({"type":"event_msg","payload":terminal}),
+    ];
+    let mut bytes = Vec::new();
+    for (ordinal, mut record) in records.into_iter().enumerate() {
+        record["timestamp"] = json!("2026-10-17T00:00:00Z");
+        record["ordinal"] = json!(ordinal);
+        serde_json::to_writer(&mut bytes, &record).unwrap();
+        bytes.push(b'\n');
+    }
+    bytes
+}
+
+#[tokio::test]
+async fn terminal_query_recovers_all_outcomes_and_replays_durable_evidence() {
+    for status in [
+        NativeTurnTerminalStatus::Completed,
+        NativeTurnTerminalStatus::Failed,
+        NativeTurnTerminalStatus::Canceled,
+    ] {
+        let (home, state, store, params, path) = fixture().await;
+        let terminal = match status {
+            NativeTurnTerminalStatus::Completed => {
+                json!({"type":"task_complete","turn_id":params.client_user_message_id,"last_agent_message":null})
+            }
+            NativeTurnTerminalStatus::Failed => {
+                json!({"type":"task_complete","turn_id":params.client_user_message_id,"last_agent_message":null,"error":{"message":"failure","codex_error_info":null}})
+            }
+            NativeTurnTerminalStatus::Canceled => {
+                json!({"type":"turn_aborted","turn_id":params.client_user_message_id,"reason":"interrupted"})
+            }
+        };
+        let bytes = history(&params, terminal);
+        tokio::fs::write(&path, &bytes).await.unwrap();
+        let first = terminal_evidence(Some(&state), &store, &params).await;
+        let ThreadTerminalEvidenceResponse::Terminal {
+            ref turn_id,
+            ref receipt_id,
+            ref item_id,
+            terminal_status,
+            replayed,
+        } = first
+        else {
+            panic!("expected terminal evidence")
+        };
+        assert_eq!(turn_id, &params.client_user_message_id);
+        assert_eq!(terminal_status, status);
+        assert!(replayed);
+        assert!(Uuid::parse_str(item_id).is_ok());
+        assert_ne!(item_id, turn_id);
+        assert!(Uuid::parse_str(receipt_id).is_ok());
+        assert_eq!(tokio::fs::read(&path).await.unwrap(), bytes);
+        // Once committed, a new DB handle can answer without reading the rollout again.
+        tokio::fs::remove_file(&path).await.unwrap();
+        let reopened = StateRuntime::init(
+            SqliteConfig::new_for_testing(home.path().abs()),
+            "test-provider".into(),
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            terminal_evidence(Some(&reopened), &store, &params).await,
+            first
+        );
+    }
+}
+
+#[tokio::test]
+async fn terminal_query_rejects_every_changed_identity_and_v2_without_committing() {
+    let (_home, state, store, params, path) = fixture().await;
+    let bytes = history(
+        &params,
+        json!({"type":"task_complete","turn_id":params.client_user_message_id,"last_agent_message":null}),
+    );
+    tokio::fs::write(&path, bytes).await.unwrap();
+    let original = serde_json::to_value(&params).unwrap();
+    for (key, value) in [
+        ("serverInstanceId", json!(Uuid::now_v7().to_string())),
+        ("expectedGeneration", json!(5)),
+        ("threadId", json!(ThreadId::new().to_string())),
+        ("attemptId", json!("other")),
+        ("deliveryId", json!("other")),
+        ("clientUserMessageId", json!(Uuid::now_v7().to_string())),
+        ("permitId", json!("other")),
+        ("permitIssuedAt", json!(2)),
+        ("permitExpiresAt", json!(5002)),
+        ("input", json!("changed input")),
+        ("bridgeClientId", json!(Uuid::now_v7().to_string())),
+        ("bridgeClientGeneration", json!(8)),
+    ] {
+        let mut changed = original.clone();
+        changed[key] = value;
+        let changed = serde_json::from_value(changed).unwrap();
+        assert_eq!(
+            terminal_evidence(Some(&state), &store, &changed).await,
+            ThreadTerminalEvidenceResponse::Unknown,
+            "{key}"
+        );
+    }
+    let mut v2 = params.clone();
+    v2.bridge_client_id = None;
+    v2.bridge_client_generation = None;
+    assert_eq!(
+        terminal_evidence(Some(&state), &store, &v2).await,
+        ThreadTerminalEvidenceResponse::Unknown
+    );
+    assert_eq!(
+        state
+            .get_native_turn_start_proof(&identity_from_params(&params))
+            .await
+            .unwrap(),
+        Some(NativeTurnStartProof::Pending)
+    );
+    assert_eq!(
+        terminal_evidence(None, &store, &params).await,
+        ThreadTerminalEvidenceResponse::Unknown
+    );
+}
+
+#[tokio::test]
+async fn terminal_query_does_not_accept_incomplete_history_or_caller_proof() {
