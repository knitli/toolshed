+use super::NativeSelectionRequestProcessor;
+use super::identity_from_params;
+use super::valid_start_params;
+use codex_app_server_protocol::NativeTurnTerminalStatus;
+use codex_app_server_protocol::ThreadStartIfIdleParams;
+use codex_app_server_protocol::ThreadTerminalEvidenceResponse;
+use codex_rollout::StateDbHandle;
+use codex_thread_store::LocalThreadStore;
+use codex_thread_store::ThreadStore;
+
+impl NativeSelectionRequestProcessor {
+    pub(crate) async fn thread_terminal_evidence(
+        &self,
+        params: &ThreadStartIfIdleParams,
+    ) -> ThreadTerminalEvidenceResponse {
+        terminal_evidence(self.state_db.as_ref(), self.thread_store.as_ref(), params).await
+    }
+}
+
+// This query may persist recovered evidence, but never loads a live thread, submits input,
+// renews a selection, or changes a cloud claim. Only the shared local store owns recovery locks.
+async fn terminal_evidence(
+    state: Option<&StateDbHandle>,
+    store: &dyn ThreadStore,
+    params: &ThreadStartIfIdleParams,
+) -> ThreadTerminalEvidenceResponse {
+    if !valid_start_params(params) || params.bridge_client_id.is_none() {
+        return ThreadTerminalEvidenceResponse::Unknown;
+    }
+    let Some(state) = state else {
+        return ThreadTerminalEvidenceResponse::Unknown;
+    };
+    let identity = identity_from_params(params);
+    let proof = match state.get_native_turn_terminal_proof(&identity).await {
+        Ok(Some(proof)) => Some(proof),
+        Ok(None) => {
+            let Some(local) = store.as_any().downcast_ref::<LocalThreadStore>() else {
+                return ThreadTerminalEvidenceResponse::Unknown;
+            };
+            local
+                .recover_native_terminal_history(&identity)
+                .await
+                .ok()
+                .flatten()
+        }
+        Err(_) => None,
+    };
+    let Some(proof) = proof else {
+        return ThreadTerminalEvidenceResponse::Unknown;
+    };
+    // A terminal row alone may be anchored only to Started. Expose it only with the
+    // exact durable input item; these immutable proofs cannot be evicted or rebound.
+    let Ok(Some(codex_state::NativeTurnStartProof::InputRecorded { turn_id, item_id })) =
+        state.get_native_turn_start_proof(&identity).await
+    else {
+        return ThreadTerminalEvidenceResponse::Unknown;
+    };
+    if turn_id != proof.turn_id {
+        return ThreadTerminalEvidenceResponse::Unknown;
+    }
+    ThreadTerminalEvidenceResponse::Terminal {
+        turn_id,
+        item_id,
+        receipt_id: proof.receipt_id,
+        terminal_status: match proof.status {
+            codex_state::NativeTurnTerminalStatus::Completed => NativeTurnTerminalStatus::Completed,
+            codex_state::NativeTurnTerminalStatus::Failed => NativeTurnTerminalStatus::Failed,
+            codex_state::NativeTurnTerminalStatus::Canceled => NativeTurnTerminalStatus::Canceled,
+        },
+        replayed: true,
+    }
+}
+
+#[cfg(test)]
+#[path = "terminal_query_tests.rs"]
+mod tests;
