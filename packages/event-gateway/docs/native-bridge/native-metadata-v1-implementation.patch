+#[derive(Debug, Clone)]
+struct NativeReceipt {
+    server_instance_id: String,
+    selection_generation: u64,
+    attempt_id: String,
+    delivery_id: String,
+    thread_id: String,
+    client_user_message_id: String,
+    permit_id: String,
+    permit_issued_at: u64,
+    permit_expires_at: u64,
