+}
+
+enum DurableStartLookup {
+    Missing,
+    Pending,
+    Positive(String),
+    Unavailable,
+}
+
+#[derive(Debug, Default)]
+struct ReceiptStore {
+    by_delivery: HashMap<String, NativeReceipt>,
+    by_attempt: HashMap<String, String>,
+    by_client_user_message_id: HashMap<String, String>,
+    terminal_by_attempt: HashMap<String, TerminalNoStartReceipt>,
+}
+
+impl ReceiptStore {
+    fn len(&self) -> usize {
+        self.by_delivery.len() + self.terminal_by_attempt.len()
+    }
+}
+
+#[derive(Debug)]
+struct GuardRejection(Mutex<Option<ThreadStartIfIdleNotStartedReason>>);
+
+impl GuardRejection {
+    fn set(&self, reason: ThreadStartIfIdleNotStartedReason) {
+        *lock(&self.0) = Some(reason);
+    }
+
+    fn get(&self) -> Option<ThreadStartIfIdleNotStartedReason> {
+        lock(&self.0).clone()
+    }
+}
+
+#[derive(Debug)]
+struct NativeTurnStartGuard {
+    selection: Arc<Mutex<SelectionState>>,
+    receipts: Arc<Mutex<ReceiptStore>>,
+    expected_generation: u64,
+    thread_id: String,
+    permit_deadline: Instant,
+    receipt: NativeReceipt,
+    rejection: GuardRejection,
+}
+
+impl TurnStartGuard for NativeTurnStartGuard {
+    fn commit_start(&self, turn_id: &str, commit: &mut dyn FnMut()) -> TurnStartGuardCommit {
+        let selection = lock(&self.selection);
+        let mut receipts = lock(&self.receipts);
+        if let Some(existing) = receipts.by_delivery.get(&self.receipt.delivery_id) {
+            if receipt_matches(existing, &self.receipt) {
+                return TurnStartGuardCommit::AlreadyCommitted {
+                    turn_id: existing.turn_id.clone(),
+                };
+            }
+            self.rejection
+                .set(ThreadStartIfIdleNotStartedReason::DuplicateConflict);
+            return TurnStartGuardCommit::Rejected;
+        }
+        if let Some(existing) = receipts.terminal_by_attempt.get(&self.receipt.attempt_id) {
+            if receipt_matches_params(&self.receipt, &existing.params) {
+                self.rejection.set(existing.reason.clone());
+            } else {
+                self.rejection
+                    .set(ThreadStartIfIdleNotStartedReason::DuplicateConflict);
+            }
+            return TurnStartGuardCommit::Rejected;
+        }
+        if receipts.by_attempt.contains_key(&self.receipt.attempt_id)
+            || receipts.by_delivery.contains_key(&self.receipt.delivery_id)
+            || receipts
+                .by_delivery
+                .values()
+                .any(|receipt| receipt.permit_id == self.receipt.permit_id)
+            || receipts
+                .terminal_by_attempt
+                .values()
+                .any(|receipt| receipt.params.permit_id == self.receipt.permit_id)
+            || receipts
+                .by_client_user_message_id
+                .contains_key(&self.receipt.client_user_message_id)
+            || receipts.terminal_by_attempt.values().any(|receipt| {
+                receipt.params.client_user_message_id == self.receipt.client_user_message_id
+                    && receipt.params.delivery_id != self.receipt.delivery_id
+            })
+        {
+            self.rejection
+                .set(ThreadStartIfIdleNotStartedReason::DuplicateConflict);
+            return TurnStartGuardCommit::Rejected;
+        }
+        let now = Instant::now();
+        if selection.closed {
+            self.rejection
+                .set(ThreadStartIfIdleNotStartedReason::ConnectionClosed);
+            return TurnStartGuardCommit::Rejected;
+        }
+        if self.permit_deadline <= now {
+            self.rejection
+                .set(ThreadStartIfIdleNotStartedReason::PermitExpired);
+            return TurnStartGuardCommit::Rejected;
+        }
+        if selection.generation != self.expected_generation
+            || selection.thread_id.as_deref() != Some(self.thread_id.as_str())
+            || !selection.ready
+        {
+            self.rejection
+                .set(ThreadStartIfIdleNotStartedReason::SelectionChanged);
+            return TurnStartGuardCommit::Rejected;
+        }
+        if selection
+            .expires_at
+            .is_none_or(|expires_at| expires_at <= now)
+        {
+            self.rejection
+                .set(ThreadStartIfIdleNotStartedReason::SelectionExpired);
+            return TurnStartGuardCommit::Rejected;
+        }
+
+        if receipts.len() >= MAX_RECEIPTS {
+            self.rejection
+                .set(ThreadStartIfIdleNotStartedReason::ReceiptCapacity);
+            return TurnStartGuardCommit::Rejected;
+        }
+
+        let mut receipt = self.receipt.clone();
+        receipt.turn_id = turn_id.to_string();
+        receipts
+            .by_attempt
+            .insert(receipt.attempt_id.clone(), receipt.delivery_id.clone());
+        receipts.by_client_user_message_id.insert(
+            receipt.client_user_message_id.clone(),
+            receipt.delivery_id.clone(),
+        );
+        let delivery_id = receipt.delivery_id.clone();
+        receipts.by_delivery.insert(delivery_id, receipt);
+        commit();
+        TurnStartGuardCommit::Committed
+    }
+}
