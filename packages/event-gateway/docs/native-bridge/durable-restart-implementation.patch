+const SELECTION_LEASE: Duration = Duration::from_millis(750);
+const MAX_PERMIT_LIFETIME_MS: u64 = 5_000;
+// Durable rows retain the exact input permanently in this spike. Do not raise or evict until a
+// production retention policy is defined.
+const MAX_RECEIPTS: usize = MAX_NATIVE_TURN_START_RECEIPTS;
+const MAX_ID_BYTES: usize = 128;
+const MAX_INPUT_BYTES: usize = 4_096;
+
+#[derive(Debug, Default)]
+struct SelectionState {
+    generation: u64,
+    thread_id: Option<String>,
+    ready: bool,
+    expires_at: Option<Instant>,
+    closed: bool,
+}
+
+#[derive(Debug, Default)]
+struct ConnectionSelections {
+    by_connection: HashMap<crate::outgoing_message::ConnectionId, Arc<Mutex<SelectionState>>>,
+}
+
+impl ConnectionSelections {
+    fn get_or_insert(
+        &mut self,
+        connection_id: crate::outgoing_message::ConnectionId,
+    ) -> Arc<Mutex<SelectionState>> {
+        self.by_connection.entry(connection_id).or_default().clone()
+    }
+
+    fn close(&mut self, connection_id: crate::outgoing_message::ConnectionId) {
+        let selection = self.get_or_insert(connection_id);
+        let mut selection = lock(&selection);
+        if selection.closed {
+            return;
+        }
+        selection.thread_id = None;
+        selection.ready = false;
+        selection.expires_at = None;
+        selection.closed = true;
+        selection.generation = selection.generation.saturating_add(1);
+    }
+
+    fn drained(&mut self, connection_id: crate::outgoing_message::ConnectionId) {
+        if self
+            .by_connection
+            .get(&connection_id)
+            .is_some_and(|selection| lock(selection).closed)
+        {
+            self.by_connection.remove(&connection_id);
+        }
+    }
+}
