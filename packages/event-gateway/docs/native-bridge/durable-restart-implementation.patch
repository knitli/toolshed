+    }
+}
+
+impl NativeSelectionRequestProcessor {
+    pub(crate) fn new(
+        thread_manager: Arc<ThreadManager>,
+        thread_state_manager: crate::thread_state::ThreadStateManager,
+        state_db: Option<StateDbHandle>,
+    ) -> Self {
+        let receipts = Arc::new(Mutex::new(ReceiptStore::default()));
+        let observer_receipts = Arc::clone(&receipts);
+        let observer_state_db = state_db.clone();
+        thread_state_manager.set_core_item_completed_observer(Arc::new(move |event| {
+            let observer_receipts = Arc::clone(&observer_receipts);
+            let observer_state_db = observer_state_db.clone();
+            Box::pin(async move {
+                persist_core_item_completed(observer_receipts, observer_state_db, event).await;
+            })
+        }));
+        Self {
+            server_instance_id: Uuid::now_v7().to_string(),
+            thread_manager,
+            state_db,
+            connections: Mutex::new(ConnectionSelections::default()),
+            receipts,
+        }
+    }
+
+    pub(crate) fn client_selection_update(
+        &self,
+        connection_id: crate::outgoing_message::ConnectionId,
