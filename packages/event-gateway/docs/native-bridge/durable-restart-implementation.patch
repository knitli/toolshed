+#[tokio::test]
+async fn native_receipt_reopens_exact_identity_and_keeps_input_recorded_ahead_of_started()
+-> anyhow::Result<()> {
+    let codex_home = unique_temp_dir();
+    let first_runtime = runtime(&codex_home).await?;
+    let request = identity(1);
+    assert_eq!(
+        first_runtime.begin_native_turn_start(&request, &[]).await?,
+        NativeTurnStartBegin::Created
+    );
+    assert_eq!(
+        first_runtime.get_native_turn_start_proof(&request).await?,
+        Some(NativeTurnStartProof::Pending)
+    );
+
+    let turn_id = request.client_user_message_id.clone();
+    let item_id = "00000000-0000-7fff-8000-000000000001".to_string();
+    let recorded = first_runtime
+        .record_native_turn_input(&request, &turn_id, &item_id)
+        .await?;
+    assert_eq!(
+        recorded,
+        NativeTurnStartProof::InputRecorded {
+            turn_id: turn_id.clone(),
+            item_id: item_id.clone(),
+        }
+    );
+    assert_eq!(
+        first_runtime
+            .record_native_turn_started(&request, &turn_id)
+            .await?,
+        recorded,
+        "a late Started write must preserve earlier authentic InputRecorded proof"
+    );
+
+    first_runtime.close().await;
+    let reopened = runtime(&codex_home).await?;
+    assert_eq!(
+        reopened.get_native_turn_start_proof(&request).await?,
+        Some(recorded)
+    );
+
+    let mut mismatches = Vec::new();
+    let mut changed = request.clone();
+    changed.server_instance_id.push_str("-changed");
+    mismatches.push(changed);
+    let mut changed = request.clone();
+    changed.selection_generation += 1;
+    mismatches.push(changed);
+    let mut changed = request.clone();
+    changed.attempt_id.push_str("-changed");
+    mismatches.push(changed);
+    let mut changed = request.clone();
+    changed.delivery_id.push_str("-changed");
+    mismatches.push(changed);
+    let mut changed = request.clone();
+    changed.thread_id.push_str("-changed");
+    mismatches.push(changed);
+    let mut changed = request.clone();
+    changed.client_user_message_id.push_str("-changed");
+    mismatches.push(changed);
+    let mut changed = request.clone();
+    changed.permit_id.push_str("-changed");
+    mismatches.push(changed);
+    let mut changed = request.clone();
+    changed.permit_issued_at += 1;
+    mismatches.push(changed);
+    let mut changed = request.clone();
+    changed.permit_expires_at += 1;
+    mismatches.push(changed);
+    let mut changed = request.clone();
+    changed.input.push_str("-changed");
+    mismatches.push(changed);
+    for mismatch in mismatches {
+        assert_eq!(
+            reopened.get_native_turn_start_proof(&mismatch).await?,
+            None,
+            "a changed request tuple must not recover a receipt"
+        );
+    }
+    Ok(())
+}
