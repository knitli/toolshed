+#[tokio::test]
+async fn native_receipt_capacity_is_permanent_and_fails_closed_without_eviction()
+-> anyhow::Result<()> {
+    let codex_home = unique_temp_dir();
+    let first_runtime = runtime(&codex_home).await?;
+    for index in 0..MAX_NATIVE_TURN_START_RECEIPTS {
+        assert_eq!(
+            first_runtime
+                .begin_native_turn_start(&identity(index), &[])
+                .await?,
+            NativeTurnStartBegin::Created
+        );
+    }
+    let overflow = identity(MAX_NATIVE_TURN_START_RECEIPTS);
+    assert_eq!(
+        first_runtime
+            .begin_native_turn_start(&overflow, &[])
+            .await?,
+        NativeTurnStartBegin::Capacity
+    );
+    assert_eq!(
+        first_runtime
+            .get_native_turn_start_proof(&identity(0))
+            .await?,
+        Some(NativeTurnStartProof::Pending),
+        "capacity handling must not evict old evidence"
+    );
+    assert_eq!(
+        first_runtime.get_native_turn_start_proof(&overflow).await?,
+        None,
+        "a full store must not reserve a new request"
+    );
+    first_runtime.close().await;
+
+    let reopened = runtime(&codex_home).await?;
+    assert_eq!(
+        reopened.get_native_turn_start_proof(&identity(0)).await?,
+        Some(NativeTurnStartProof::Pending),
+        "restart must retain the oldest row instead of evicting it to free capacity"
+    );
+    assert_eq!(
+        reopened.begin_native_turn_start(&overflow, &[]).await?,
+        NativeTurnStartBegin::Capacity,
+        "the permanent 256-row ceiling must survive restart"
+    );
+    Ok(())
+}
