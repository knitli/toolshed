+    let runtime = runtime(&unique_temp_dir()).await?;
+    let first = identity(5);
+    assert_eq!(
+        runtime.begin_native_turn_start(&first, &[]).await?,
+        NativeTurnStartBegin::Created
+    );
+
+    let mut retry = first.clone();
+    retry.attempt_id = "attempt-5-retry".to_string();
+    retry.client_user_message_id = "00000000-0000-7000-8000-000000000051".to_string();
+    retry.permit_id = "permit-5-retry".to_string();
+    retry.selection_generation += 1;
+    retry.permit_issued_at += 1;
+    retry.permit_expires_at += 1;
+    assert_eq!(
+        runtime.begin_native_turn_start(&retry, &[]).await?,
+        NativeTurnStartBegin::Conflict,
+        "a pending attempt is not permission to retry"
+    );
+    assert_eq!(
+        runtime
+            .begin_native_turn_start(&retry, &[first.attempt_id.clone()])
+            .await?,
+        NativeTurnStartBegin::Created,
+        "only a separately established terminal no-start may authorize a fresh attempt"
+    );
+    assert_eq!(
+        runtime.get_native_turn_start_proof(&first).await?,
+        Some(NativeTurnStartProof::Pending)
+    );
+    assert_eq!(
+        runtime.get_native_turn_start_proof(&retry).await?,
+        Some(NativeTurnStartProof::Pending)
+    );
+    assert_eq!(
+        runtime.begin_native_turn_start(&retry, &[]).await?,
+        NativeTurnStartBegin::Existing(NativeTurnStartProof::Pending),
+        "an exact older attempt remains an ambiguous replay even beside later attempts"
+    );
+
+    let third = {
+        let mut third = retry.clone();
+        third.attempt_id = "attempt-5-third".to_string();
+        third.client_user_message_id = "00000000-0000-7000-8000-000000000052".to_string();
+        third.permit_id = "permit-5-third".to_string();
+        third
+    };
+    assert_eq!(
+        runtime
+            .begin_native_turn_start(
+                &third,
+                &[first.attempt_id.clone(), retry.attempt_id.clone()],
+            )
+            .await?,
+        NativeTurnStartBegin::Created,
+        "all rows for a reused delivery must have a current-process terminal proof"
+    );
+
+    let mut changed_delivery_content = third.clone();
+    changed_delivery_content.attempt_id = "attempt-5-changed-content".to_string();
+    changed_delivery_content.client_user_message_id =
+        "00000000-0000-7000-8000-000000000053".to_string();
+    changed_delivery_content.permit_id = "permit-5-changed-content".to_string();
+    changed_delivery_content.input.push_str(" changed");
+    assert_eq!(
+        runtime
+            .begin_native_turn_start(
+                &changed_delivery_content,
+                &[
+                    first.attempt_id.clone(),
+                    retry.attempt_id.clone(),
+                    third.attempt_id.clone(),
+                ],
+            )
+            .await?,
+        NativeTurnStartBegin::Conflict,
+        "a terminal attempt cannot authorize changed delivery content"
+    );
+
+    let positive = identity(6);
+    assert_eq!(
+        runtime.begin_native_turn_start(&positive, &[]).await?,
+        NativeTurnStartBegin::Created
+    );
+    runtime
+        .record_native_turn_started(&positive, &positive.client_user_message_id)
+        .await?;
+    let mut forbidden_retry = positive.clone();
+    forbidden_retry.attempt_id = "attempt-6-retry".to_string();
+    forbidden_retry.client_user_message_id = "00000000-0000-7000-8000-000000000061".to_string();
+    forbidden_retry.permit_id = "permit-6-retry".to_string();
+    assert_eq!(
+        runtime
+            .begin_native_turn_start(&forbidden_retry, &[positive.attempt_id.clone()])
+            .await?,
+        NativeTurnStartBegin::Conflict,
+        "positive evidence can never be shadowed by a new attempt"
+    );
+    assert_eq!(
+        runtime.get_native_turn_start_proof(&positive).await?,
+        Some(NativeTurnStartProof::Started {
+            turn_id: positive.client_user_message_id.clone()
+        })
+    );
+    Ok(())
+}
