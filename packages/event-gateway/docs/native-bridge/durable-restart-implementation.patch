+//! Durable, bounded anchors for experimental native turn starts.
+
+use super::StateRuntime;
+use anyhow::Context;
+use anyhow::bail;
+use sqlx::Row;
+use uuid::Uuid;
+
+/// The permanent row ceiling for this experimental receipt store.
+///
+/// Rows contain the caller's exact input and are not evicted. Reaching this
+/// ceiling disables further native starts until a production retention policy
+/// is defined.
+// ponytail: 256 permanent records; define safe retention before relaxing this ceiling.
+pub const MAX_NATIVE_TURN_START_RECEIPTS: usize = 256;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct NativeTurnStartIdentity {
+    pub server_instance_id: String,
+    pub selection_generation: u64,
+    pub attempt_id: String,
+    pub delivery_id: String,
+    pub thread_id: String,
+    pub client_user_message_id: String,
+    pub permit_id: String,
+    pub permit_issued_at: u64,
+    pub permit_expires_at: u64,
+    pub input: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum NativeTurnStartProof {
+    Pending,
+    Started { turn_id: String },
+    InputRecorded { turn_id: String, item_id: String },
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum NativeTurnStartBegin {
+    Created,
+    Existing(NativeTurnStartProof),
+    Conflict,
+    Capacity,
+}
+
+impl StateRuntime {
+    /// Durably reserves one exact native start identity before Core is called.
+    ///
+    /// Pending rows are deliberately not positive receipts. They prevent an
+    /// ambiguous request from being submitted again after restart.
+    pub async fn begin_native_turn_start(
+        &self,
+        identity: &NativeTurnStartIdentity,
+        retryable_delivery_attempt_ids: &[String],
+    ) -> anyhow::Result<NativeTurnStartBegin> {
+        Uuid::parse_str(&identity.client_user_message_id)
+            .context("native receipt client message ID is invalid")?;
+        let mut transaction = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let rows = sqlx::query(
+            "SELECT * FROM native_turn_start_receipts WHERE delivery_id = ? OR attempt_id = ? OR client_user_message_id = ? OR permit_id = ?",
+        )
+        .bind(&identity.delivery_id)
+        .bind(&identity.attempt_id)
+        .bind(&identity.client_user_message_id)
+        .bind(&identity.permit_id)
+        .fetch_all(&mut *transaction)
+        .await?;
+        if !rows.is_empty() {
+            let exact = rows.iter().find_map(|row| {
+                identity_from_row(row)
+                    .ok()
+                    .filter(|existing| existing == identity)
+                    .map(|_| row)
+            });
+            if let Some(row) = exact {
+                transaction.commit().await?;
+                return Ok(NativeTurnStartBegin::Existing(proof_from_row(row)?));
+            }
+            if !retryable_delivery_attempts_allow(&rows, identity, retryable_delivery_attempt_ids)?
+            {
+                transaction.commit().await?;
+                return Ok(NativeTurnStartBegin::Conflict);
+            }
+        }
+
+        let count = sqlx::query_scalar::<_, i64>("SELECT COUNT(*) FROM native_turn_start_receipts")
+            .fetch_one(&mut *transaction)
+            .await?;
+        if usize::try_from(count)? >= MAX_NATIVE_TURN_START_RECEIPTS {
+            transaction.commit().await?;
+            return Ok(NativeTurnStartBegin::Capacity);
+        }
+
+        sqlx::query(
+            "INSERT INTO native_turn_start_receipts (delivery_id, server_instance_id, selection_generation, attempt_id, thread_id, client_user_message_id, permit_id, permit_issued_at, permit_expires_at, input, stage, turn_id, input_item_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', NULL, NULL)",
+        )
+        .bind(&identity.delivery_id)
+        .bind(&identity.server_instance_id)
+        .bind(identity.selection_generation.to_string())
+        .bind(&identity.attempt_id)
+        .bind(&identity.thread_id)
+        .bind(&identity.client_user_message_id)
+        .bind(&identity.permit_id)
+        .bind(identity.permit_issued_at.to_string())
+        .bind(identity.permit_expires_at.to_string())
+        .bind(&identity.input)
+        .execute(&mut *transaction)
+        .await?;
+        transaction.commit().await?;
+        Ok(NativeTurnStartBegin::Created)
+    }
+
+    /// Commits a positive Core-start receipt without demoting InputRecorded.
+    pub async fn record_native_turn_started(
+        &self,
+        identity: &NativeTurnStartIdentity,
+        turn_id: &str,
+    ) -> anyhow::Result<NativeTurnStartProof> {
+        validate_started_turn(identity, turn_id)?;
+        let mut transaction = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let row = exact_native_receipt_row(&mut transaction, identity).await?;
+        let proof = proof_from_row(&row)?;
+        let updated = match proof {
+            NativeTurnStartProof::Pending => {
+                update_native_receipt(&mut transaction, identity, "started", turn_id, None).await?;
+                NativeTurnStartProof::Started {
+                    turn_id: turn_id.to_string(),
+                }
+            }
+            NativeTurnStartProof::Started { turn_id: existing } if existing == turn_id => {
+                NativeTurnStartProof::Started { turn_id: existing }
+            }
+            NativeTurnStartProof::InputRecorded {
+                turn_id: existing,
+                item_id,
+            } if existing == turn_id => NativeTurnStartProof::InputRecorded {
+                turn_id: existing,
+                item_id,
+            },
+            _ => bail!("native receipt start proof conflicts with committed identity"),
+        };
+        transaction.commit().await?;
+        Ok(updated)
+    }
+
+    /// Commits genuine Core ItemCompleted evidence, monotonically upgrading the row.
+    pub async fn record_native_turn_input(
+        &self,
+        identity: &NativeTurnStartIdentity,
+        turn_id: &str,
+        item_id: &str,
+    ) -> anyhow::Result<NativeTurnStartProof> {
+        validate_started_turn(identity, turn_id)?;
+        validate_core_item_id(turn_id, item_id)?;
+        let mut transaction = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let row = exact_native_receipt_row(&mut transaction, identity).await?;
+        let proof = proof_from_row(&row)?;
+        let updated = match proof {
+            NativeTurnStartProof::Pending => {
+                update_native_receipt(
+                    &mut transaction,
+                    identity,
+                    "input_recorded",
+                    turn_id,
+                    Some(item_id),
+                )
+                .await?;
+                NativeTurnStartProof::InputRecorded {
+                    turn_id: turn_id.to_string(),
+                    item_id: item_id.to_string(),
+                }
+            }
+            NativeTurnStartProof::Started { turn_id: existing } if existing == turn_id => {
+                update_native_receipt(
+                    &mut transaction,
+                    identity,
+                    "input_recorded",
+                    turn_id,
+                    Some(item_id),
+                )
+                .await?;
+                NativeTurnStartProof::InputRecorded {
+                    turn_id: existing,
+                    item_id: item_id.to_string(),
+                }
+            }
+            NativeTurnStartProof::InputRecorded {
+                turn_id: existing,
+                item_id: existing_item,
+            } if existing == turn_id && existing_item == item_id => {
+                NativeTurnStartProof::InputRecorded {
+                    turn_id: existing,
+                    item_id: existing_item,
+                }
+            }
+            _ => bail!("native input evidence conflicts with committed identity"),
+        };
+        transaction.commit().await?;
+        Ok(updated)
+    }
+
+    /// Reads proof only for the exact immutable request identity; absence stays unknown.
+    pub async fn get_native_turn_start_proof(
+        &self,
+        identity: &NativeTurnStartIdentity,
+    ) -> anyhow::Result<Option<NativeTurnStartProof>> {
+        let row = sqlx::query("SELECT * FROM native_turn_start_receipts WHERE attempt_id = ?")
+            .bind(&identity.attempt_id)
+            .fetch_optional(self.pool.as_ref())
+            .await?;
+        let Some(row) = row else {
+            return Ok(None);
+        };
+        if identity_from_row(&row)? != *identity {
+            return Ok(None);
+        }
+        Ok(Some(proof_from_row(&row)?))
+    }
+}
+
+async fn exact_native_receipt_row(
+    transaction: &mut sqlx::Transaction<'_, sqlx::Sqlite>,
+    identity: &NativeTurnStartIdentity,
+) -> anyhow::Result<sqlx::sqlite::SqliteRow> {
+    let row = sqlx::query("SELECT * FROM native_turn_start_receipts WHERE attempt_id = ?")
+        .bind(&identity.attempt_id)
+        .fetch_optional(&mut **transaction)
+        .await?
+        .context("native receipt reservation is missing")?;
+    if identity_from_row(&row)? != *identity {
+        bail!("native receipt identity does not match its reservation");
+    }
+    Ok(row)
+}
+
+async fn update_native_receipt(
+    transaction: &mut sqlx::Transaction<'_, sqlx::Sqlite>,
+    identity: &NativeTurnStartIdentity,
+    stage: &str,
+    turn_id: &str,
+    item_id: Option<&str>,
+) -> anyhow::Result<()> {
+    sqlx::query(
+        "UPDATE native_turn_start_receipts SET stage = ?, turn_id = ?, input_item_id = ? WHERE attempt_id = ?",
+    )
+    .bind(stage)
+    .bind(turn_id)
+    .bind(item_id)
+    .bind(&identity.attempt_id)
+    .execute(&mut **transaction)
+    .await?;
+    Ok(())
+}
+
+fn identity_from_row(row: &sqlx::sqlite::SqliteRow) -> anyhow::Result<NativeTurnStartIdentity> {
+    Ok(NativeTurnStartIdentity {
+        server_instance_id: row.try_get("server_instance_id")?,
+        selection_generation: row
+            .try_get::<String, _>("selection_generation")?
+            .parse()
+            .context("invalid native receipt selection generation")?,
+        attempt_id: row.try_get("attempt_id")?,
+        delivery_id: row.try_get("delivery_id")?,
+        thread_id: row.try_get("thread_id")?,
+        client_user_message_id: row.try_get("client_user_message_id")?,
+        permit_id: row.try_get("permit_id")?,
+        permit_issued_at: row
+            .try_get::<String, _>("permit_issued_at")?
+            .parse()
+            .context("invalid native receipt permit issue time")?,
+        permit_expires_at: row
+            .try_get::<String, _>("permit_expires_at")?
+            .parse()
+            .context("invalid native receipt permit expiry time")?,
+        input: row.try_get("input")?,
+    })
+}
+
+fn retryable_delivery_attempts_allow(
+    rows: &[sqlx::sqlite::SqliteRow],
+    identity: &NativeTurnStartIdentity,
+    retryable_attempt_ids: &[String],
+) -> anyhow::Result<bool> {
+    if retryable_attempt_ids.is_empty() {
+        return Ok(false);
+    }
+    for row in rows {
+        let existing = identity_from_row(row)?;
+        let stage: String = row.try_get("stage")?;
+        if existing.delivery_id != identity.delivery_id
+            || existing.attempt_id == identity.attempt_id
+            || existing.client_user_message_id == identity.client_user_message_id
+            || existing.permit_id == identity.permit_id
+            || existing.server_instance_id != identity.server_instance_id
+            || existing.thread_id != identity.thread_id
+            || existing.input != identity.input
+            || stage != "pending"
+            || !retryable_attempt_ids
+                .iter()
+                .any(|attempt_id| attempt_id == &existing.attempt_id)
+        {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+
+fn proof_from_row(row: &sqlx::sqlite::SqliteRow) -> anyhow::Result<NativeTurnStartProof> {
+    let stage: String = row.try_get("stage")?;
+    let turn_id: Option<String> = row.try_get("turn_id")?;
+    let item_id: Option<String> = row.try_get("input_item_id")?;
+    let client_user_message_id: String = row.try_get("client_user_message_id")?;
+    Uuid::parse_str(&client_user_message_id)
+        .context("native receipt client message ID is invalid")?;
+    match (stage.as_str(), turn_id, item_id) {
+        ("pending", None, None) => Ok(NativeTurnStartProof::Pending),
+        ("started", Some(turn_id), None) if turn_id == client_user_message_id => {
+            Ok(NativeTurnStartProof::Started { turn_id })
+        }
+        ("input_recorded", Some(turn_id), Some(item_id))
+            if turn_id == client_user_message_id
+                && validate_core_item_id(&turn_id, &item_id).is_ok() =>
+        {
+            Ok(NativeTurnStartProof::InputRecorded { turn_id, item_id })
+        }
+        _ => bail!("invalid native receipt proof state"),
+    }
+}
+
+fn validate_started_turn(identity: &NativeTurnStartIdentity, turn_id: &str) -> anyhow::Result<()> {
+    Uuid::parse_str(&identity.client_user_message_id)
+        .context("native receipt client message ID is invalid")?;
+    if turn_id != identity.client_user_message_id {
+        bail!("native Core turn ID does not match its reserved submission ID");
+    }
+    Ok(())
+}
+
+fn validate_core_item_id(turn_id: &str, item_id: &str) -> anyhow::Result<()> {
+    let parsed = Uuid::parse_str(item_id).context("native Core item ID is invalid")?;
+    if item_id == turn_id || parsed.get_version_num() != 7 {
+        bail!("native Core item ID does not match expected generated identity");
+    }
+    Ok(())
+}
