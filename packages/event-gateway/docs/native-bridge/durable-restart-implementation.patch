+
+    pub(crate) fn connection_closed(&self, connection_id: crate::outgoing_message::ConnectionId) {
+        let mut connections = lock(&self.connections);
+        connections.close(connection_id);
+    }
+
+    pub(crate) fn connection_drained(&self, connection_id: crate::outgoing_message::ConnectionId) {
+        let mut connections = lock(&self.connections);
+        connections.drained(connection_id);
+    }
+
+    pub(crate) async fn thread_start_if_idle(
+        &self,
+        connection_id: crate::outgoing_message::ConnectionId,
+        params: ThreadStartIfIdleParams,
+    ) -> ThreadStartIfIdleResponse {
+        if !valid_start_params(&params) {
+            return not_started(ThreadStartIfIdleNotStartedReason::InputInvalid);
+        }
+        if params.server_instance_id != self.server_instance_id {
+            return ThreadStartIfIdleResponse::Unknown;
+        }
+        match self
+            .durable_start_lookup(&identity_from_params(&params))
+            .await
+        {
+            DurableStartLookup::Positive(turn_id) => {
+                return ThreadStartIfIdleResponse::Started {
+                    turn_id,
+                    replayed: true,
+                };
+            }
+            DurableStartLookup::Pending | DurableStartLookup::Unavailable => {
+                if let Some(response) =
+                    terminal_no_start_response_from(&lock(&self.receipts), &params, true)
+                {
+                    return response;
+                }
+                return ThreadStartIfIdleResponse::Unknown;
+            }
+            DurableStartLookup::Missing => {}
+        }
+        if let Some(response) = self.duplicate_response(&params) {
+            return response;
+        }
+        let prepared = validate_permit_then(
+            params.permit_issued_at,
+            params.permit_expires_at,
+            || {
+                let monotonic_now = Instant::now();
+                let unix_now_ms = unix_time_ms();
+                (monotonic_now, unix_now_ms)
+            },
+            async {
+                let selection = self.selection_for(connection_id);
+                {
+                    let selection_state = lock(&selection);
+                    if selection_state.closed {
+                        return Err(ThreadStartIfIdleNotStartedReason::ConnectionClosed);
+                    }
+                    if selection_state.generation != params.expected_generation
+                        || selection_state.thread_id.as_deref() != Some(params.thread_id.as_str())
+                        || !selection_state.ready
+                    {
+                        return Err(ThreadStartIfIdleNotStartedReason::SelectionChanged);
+                    }
+                    if selection_state
+                        .expires_at
+                        .is_none_or(|expires_at| expires_at <= Instant::now())
+                    {
+                        return Err(ThreadStartIfIdleNotStartedReason::SelectionExpired);
+                    }
+                }
+                let thread_id = ThreadId::from_string(&params.thread_id)
+                    .map_err(|_| ThreadStartIfIdleNotStartedReason::ThreadUnavailable)?;
+                let thread = self
+                    .thread_manager
+                    .get_thread(thread_id)
+                    .await
+                    .map_err(|_| ThreadStartIfIdleNotStartedReason::ThreadUnavailable)?;
+                if ensure_direct_input_allowed(thread.as_ref()).await.is_err() {
+                    return Err(ThreadStartIfIdleNotStartedReason::InputInvalid);
+                }
+                Ok((selection, thread))
+            },
+        )
+        .await;
+        let (permit_deadline, (selection, thread)) = match prepared {
+            Ok(prepared) => prepared,
+            Err(reason) => return self.refusal_response(&params, reason),
+        };
+
+        let native_identity = identity_from_params(&params);
+        let Some(state_db) = self.state_db.as_ref() else {
+            return ThreadStartIfIdleResponse::Unknown;
+        };
+        let retryable_attempt_ids = retryable_terminal_attempt_ids(&lock(&self.receipts), &params);
+        match state_db
+            .begin_native_turn_start(&native_identity, &retryable_attempt_ids)
+            .await
+        {
+            Ok(NativeTurnStartBegin::Created) => {}
+            Ok(NativeTurnStartBegin::Existing(NativeTurnStartProof::Pending)) => {
+                return ThreadStartIfIdleResponse::Unknown;
+            }
+            Ok(NativeTurnStartBegin::Existing(proof)) => {
+                return start_response_from_proof(proof);
+            }
+            Ok(NativeTurnStartBegin::Conflict) => {
+                return self.refusal_response(
+                    &params,
+                    ThreadStartIfIdleNotStartedReason::DuplicateConflict,
+                );
+            }
+            Ok(NativeTurnStartBegin::Capacity) => {
+                return self
+                    .refusal_response(&params, ThreadStartIfIdleNotStartedReason::ReceiptCapacity);
+            }
+            Err(_) => return ThreadStartIfIdleResponse::Unknown,
+        }
+
+        let receipt = NativeReceipt {
+            server_instance_id: params.server_instance_id.clone(),
+            selection_generation: params.expected_generation,
+            attempt_id: params.attempt_id.clone(),
+            delivery_id: params.delivery_id.clone(),
+            thread_id: params.thread_id.clone(),
+            client_user_message_id: params.client_user_message_id.clone(),
+            permit_id: params.permit_id.clone(),
+            permit_issued_at: params.permit_issued_at,
+            permit_expires_at: params.permit_expires_at,
+            input: params.input.clone(),
+            turn_id: params.client_user_message_id.clone(),
+            input_recorded_item_id: None,
+        };
+        let guard = Arc::new(NativeTurnStartGuard {
+            selection,
+            receipts: Arc::clone(&self.receipts),
+            expected_generation: params.expected_generation,
+            thread_id: params.thread_id.clone(),
+            permit_deadline,
+            receipt: receipt.clone(),
+            rejection: GuardRejection(Mutex::new(None)),
+        });
+        let response_params = params.clone();
+        let request = TurnInputRequest::new(TurnInput::UserInput {
+            content: vec![UserInput::Text {
+                text: params.input,
+                text_elements: Vec::new(),
+            }],
+            client_id: Some(params.client_user_message_id.clone()),
+        })
+        .on_start(TurnStartOptions {
+            turn_trigger: Some("event_gateway".to_string()),
+            ..Default::default()
+        })
+        .with_start_guard(guard.clone())
+        .with_submission_id(params.client_user_message_id);
+        match thread.start_turn_if_idle(request).await {
+            Ok(StartIfIdleSubmission::Started { turn_id }) => {
+                let proof = match state_db
+                    .record_native_turn_started(&native_identity, &turn_id)
+                    .await
+                {
+                    Ok(proof) => Some(proof),
+                    Err(_) => state_db
+                        .get_native_turn_start_proof(&native_identity)
+                        .await
+                        .ok()
+                        .flatten(),
+                };
+                match proof {
+                    Some(NativeTurnStartProof::Started {
+                        turn_id: saved_turn_id,
+                    }) if saved_turn_id == turn_id => ThreadStartIfIdleResponse::Started {
+                        turn_id,
+                        replayed: false,
+                    },
+                    Some(NativeTurnStartProof::InputRecorded {
+                        turn_id: saved_turn_id,
+                        ..
+                    }) if saved_turn_id == turn_id => ThreadStartIfIdleResponse::Started {
+                        turn_id,
+                        replayed: false,
+                    },
+                    _ => ThreadStartIfIdleResponse::Unknown,
+                }
+            }
+            Ok(StartIfIdleSubmission::NotSubmitted { reason }) => {
+                if let Some(response) = self.recorded_response(&native_identity).await {
+                    return response;
+                }
+                if self.has_in_memory_start_receipt(&response_params) {
+                    return ThreadStartIfIdleResponse::Unknown;
+                }
+                if let Some(rejection) = guard.rejection.get() {
+                    return self.refusal_response(&response_params, rejection);
+                }
+                let reason = match reason {
+                    codex_core::NotSubmittedReason::ServerDraining => {
+                        ThreadStartIfIdleNotStartedReason::ServerDraining
+                    }
+                    _ => ThreadStartIfIdleNotStartedReason::Busy,
+                };
+                self.refusal_response(&response_params, reason)
+            }
+            Err(_) => self
+                .recorded_response(&native_identity)
+                .await
+                .unwrap_or(ThreadStartIfIdleResponse::Unknown),
+        }
+    }
+
+    /// Records a definite app-server admission refusal without entering Core.
+    /// The shared receipt lock arbitrates it against a concurrently committing start.
+    pub(crate) fn thread_start_if_idle_not_submitted(
+        &self,
+        params: &ThreadStartIfIdleParams,
+        reason: ThreadStartIfIdleNotStartedReason,
+    ) -> ThreadStartIfIdleResponse {
+        if !valid_start_params(params) {
+            return not_started(ThreadStartIfIdleNotStartedReason::InputInvalid);
+        }
+        if params.server_instance_id != self.server_instance_id {
+            return ThreadStartIfIdleResponse::Unknown;
+        }
+        if let Err(reason) = validate_permit_window(
+            params.permit_issued_at,
+            params.permit_expires_at,
+            unix_time_ms(),
+        ) {
+            if reason == ThreadStartIfIdleNotStartedReason::PermitInvalid {
+                return not_started(reason);
+            }
+            return self.refusal_response(params, reason);
+        }
+        self.refusal_response(params, reason)
+    }
+
+    /// Reads an exact committed receipt without ever submitting or replaying the turn request.
+    pub(crate) async fn thread_start_receipt(
+        &self,
+        params: &ThreadStartIfIdleParams,
+    ) -> ThreadStartReceiptResponse {
+        if let Some(state_db) = self.state_db.as_ref() {
+            match state_db
+                .get_native_turn_start_proof(&identity_from_params(params))
+                .await
+            {
+                Ok(Some(proof @ NativeTurnStartProof::Started { .. }))
+                | Ok(Some(proof @ NativeTurnStartProof::InputRecorded { .. })) => {
+                    return receipt_response_from_proof(proof);
+                }
+                Ok(Some(NativeTurnStartProof::Pending)) | Ok(None) | Err(_) => {}
+            }
+        }
+        start_receipt_response_from(&lock(&self.receipts), params)
+    }
+
+    async fn durable_start_lookup(&self, identity: &NativeTurnStartIdentity) -> DurableStartLookup {
+        let Some(state_db) = self.state_db.as_ref() else {
+            return DurableStartLookup::Unavailable;
+        };
+        match state_db.get_native_turn_start_proof(identity).await {
+            Ok(None) => DurableStartLookup::Missing,
+            Ok(Some(NativeTurnStartProof::Pending)) => DurableStartLookup::Pending,
+            Ok(Some(NativeTurnStartProof::Started { turn_id }))
+            | Ok(Some(NativeTurnStartProof::InputRecorded { turn_id, .. })) => {
+                DurableStartLookup::Positive(turn_id)
+            }
+            Err(_) => DurableStartLookup::Unavailable,
+        }
+    }
+
+    async fn recorded_response(
+        &self,
+        identity: &NativeTurnStartIdentity,
+    ) -> Option<ThreadStartIfIdleResponse> {
+        let state_db = self.state_db.as_ref()?;
+        let proof = state_db
+            .get_native_turn_start_proof(identity)
+            .await
+            .ok()??;
+        match proof {
+            NativeTurnStartProof::Pending => None,
+            NativeTurnStartProof::Started { turn_id }
+            | NativeTurnStartProof::InputRecorded { turn_id, .. } => {
+                Some(ThreadStartIfIdleResponse::Started {
+                    turn_id,
+                    replayed: true,
+                })
+            }
+        }
+    }
+
+    fn has_in_memory_start_receipt(&self, params: &ThreadStartIfIdleParams) -> bool {
+        lock(&self.receipts)
+            .by_delivery
+            .get(&params.delivery_id)
+            .is_some_and(|receipt| receipt_matches_params(receipt, params))
+    }
+
+    fn selection_for(
+        &self,
+        connection_id: crate::outgoing_message::ConnectionId,
+    ) -> Arc<Mutex<SelectionState>> {
+        let mut connections = lock(&self.connections);
+        connections.get_or_insert(connection_id)
+    }
+
+    fn duplicate_response(
+        &self,
+        params: &ThreadStartIfIdleParams,
+    ) -> Option<ThreadStartIfIdleResponse> {
+        let receipts = lock(&self.receipts);
+        duplicate_response_from(&receipts, params)
+    }
+
+    fn refusal_response(
+        &self,
+        params: &ThreadStartIfIdleParams,
+        reason: ThreadStartIfIdleNotStartedReason,
+    ) -> ThreadStartIfIdleResponse {
+        match reason {
+            ThreadStartIfIdleNotStartedReason::DuplicateConflict => not_started(reason),
+            ThreadStartIfIdleNotStartedReason::ReceiptCapacity => {
+                ThreadStartIfIdleResponse::Unknown
+            }
+            ThreadStartIfIdleNotStartedReason::PermitInvalid => not_started(reason),
+            _ => {
+                let mut receipts = lock(&self.receipts);
+                terminalize_no_start(&mut receipts, params, reason)
+            }
+        }
+    }
+}
+
+fn apply_selection_update(
+    selection: &mut SelectionState,
+    params: ClientSelectionUpdateParams,
+) -> ClientSelectionUpdateStatus {
+    if selection.closed {
+        return ClientSelectionUpdateStatus::Rejected;
+    }
+    let now = Instant::now();
+    if selection
+        .expires_at
+        .is_some_and(|expires_at| expires_at <= now)
+    {
+        selection.thread_id = None;
+        selection.ready = false;
+        selection.expires_at = None;
+        selection.generation = selection.generation.saturating_add(1);
+    }
+
+    let requested_is_valid = match (params.thread_id.as_deref(), params.ready) {
+        (Some(thread_id), true) => ThreadId::from_string(thread_id).is_ok(),
+        (None, false) => true,
+        _ => false,
+    };
+    let direct_switch = selection.thread_id.is_some()
+        && params.thread_id.is_some()
+        && selection.thread_id != params.thread_id;
+    if params.expected_generation != selection.generation {
+        return ClientSelectionUpdateStatus::Stale;
+    }
+    if !requested_is_valid || direct_switch {
+        return ClientSelectionUpdateStatus::Rejected;
+    }
+    if selection.thread_id != params.thread_id || selection.ready != params.ready {
+        selection.generation = selection.generation.saturating_add(1);
+        selection.thread_id = params.thread_id;
+        selection.ready = params.ready;
+    }
+    selection.expires_at = selection.ready.then(|| Instant::now() + SELECTION_LEASE);
+    ClientSelectionUpdateStatus::Updated
+}
+
+fn start_receipt_response_from(
+    receipts: &ReceiptStore,
+    params: &ThreadStartIfIdleParams,
+) -> ThreadStartReceiptResponse {
+    if receipts
+        .by_delivery
+        .get(&params.delivery_id)
+        .is_some_and(|receipt| receipt_matches_params(receipt, params))
+    {
+        return ThreadStartReceiptResponse::Unknown;
+    }
+    match terminal_no_start_response_from(receipts, params, true) {
+        Some(ThreadStartIfIdleResponse::TerminalNotStarted {
+            reason,
+            receipt_id,
+            replayed,
+        }) => ThreadStartReceiptResponse::TerminalNotStarted {
+            reason,
+            receipt_id,
+            replayed,
+        },
+        _ => ThreadStartReceiptResponse::Unknown,
+    }
+}
+
+fn core_item_completed_candidate(
+    receipts: &Arc<Mutex<ReceiptStore>>,
+    event: &EventMsg,
+) -> Option<(NativeTurnStartIdentity, String, String)> {
+    let EventMsg::ItemCompleted(payload) = event else {
+        return None;
+    };
+    let CoreTurnItem::UserMessage(item) = &payload.item else {
+        return None;
+    };
+    let Some(client_id) = item.client_id.as_deref() else {
+        return None;
+    };
+    let receipts = lock(receipts);
+    let delivery_id = receipts.by_client_user_message_id.get(client_id)?;
+    let receipt = receipts.by_delivery.get(delivery_id)?;
+    let content_matches = matches!(
+        item.content.as_slice(),
+        [UserInput::Text { text, text_elements }]
+            if text == &receipt.input && text_elements.is_empty()
+    );
+    if receipt.thread_id == payload.thread_id.to_string()
+        && receipt.turn_id == payload.turn_id
+        && content_matches
+        && receipt.input_recorded_item_id.is_none()
+    {
+        Some((
+            identity_from_receipt(receipt),
+            payload.turn_id.clone(),
+            item.id.clone(),
+        ))
+    } else {
+        None
+    }
+}
+
+async fn persist_core_item_completed(
+    receipts: Arc<Mutex<ReceiptStore>>,
+    state_db: Option<StateDbHandle>,
+    event: EventMsg,
+) {
+    let Some(state_db) = state_db else {
+        return;
+    };
+    let Some((identity, turn_id, item_id)) = core_item_completed_candidate(&receipts, &event)
+    else {
+        return;
+    };
+    let Ok(NativeTurnStartProof::InputRecorded {
+        turn_id: saved_turn_id,
+        item_id: saved_item_id,
+    }) = state_db
+        .record_native_turn_input(&identity, &turn_id, &item_id)
+        .await
+    else {
+        return;
+    };
+    if saved_turn_id != turn_id || saved_item_id != item_id {
+        return;
+    }
+    let mut receipts = lock(&receipts);
+    let Some(receipt) = receipts.by_delivery.get_mut(&identity.delivery_id) else {
+        return;
+    };
+    if receipt_matches_identity(receipt, &identity)
+        && receipt.turn_id == turn_id
+        && receipt.input_recorded_item_id.is_none()
+    {
+        receipt.input_recorded_item_id = Some(item_id);
+    }
+}
+
+fn duplicate_response_from(
+    receipts: &ReceiptStore,
+    params: &ThreadStartIfIdleParams,
+) -> Option<ThreadStartIfIdleResponse> {
+    if let Some(receipt) = receipts.by_delivery.get(&params.delivery_id)
+        && receipt_matches_params(receipt, params)
+    {
+        return Some(ThreadStartIfIdleResponse::Unknown);
+    }
+    if let Some(receipt) = receipts.terminal_by_attempt.get(&params.attempt_id) {
+        return Some(if receipt.params == *params {
+            terminal_no_start_response(receipt, true)
+        } else {
+            not_started(ThreadStartIfIdleNotStartedReason::DuplicateConflict)
+        });
+    }
+    if receipts.by_attempt.contains_key(&params.attempt_id)
+        || receipts.by_delivery.contains_key(&params.delivery_id)
+        || receipts.terminal_by_attempt.values().any(|receipt| {
+            receipt.params.attempt_id != params.attempt_id
+                && receipt.params.permit_id == params.permit_id
+        })
+        || receipts
+            .by_delivery
+            .values()
+            .any(|receipt| receipt.permit_id == params.permit_id)
+        || receipts
+            .by_client_user_message_id
+            .contains_key(&params.client_user_message_id)
+        || receipts.terminal_by_attempt.values().any(|receipt| {
+            receipt.params.client_user_message_id == params.client_user_message_id
+                && receipt.params.delivery_id != params.delivery_id
+        })
+    {
+        return Some(not_started(
+            ThreadStartIfIdleNotStartedReason::DuplicateConflict,
+        ));
+    }
+    (receipts.len() >= MAX_RECEIPTS).then_some(ThreadStartIfIdleResponse::Unknown)
+}
+
+fn terminal_no_start_response_from(
+    receipts: &ReceiptStore,
+    params: &ThreadStartIfIdleParams,
+    replayed: bool,
+) -> Option<ThreadStartIfIdleResponse> {
+    receipts
+        .terminal_by_attempt
+        .get(&params.attempt_id)
+        .filter(|receipt| receipt.params == *params)
+        .map(|receipt| terminal_no_start_response(receipt, replayed))
+}
+
+fn retryable_terminal_attempt_ids(
+    receipts: &ReceiptStore,
+    params: &ThreadStartIfIdleParams,
+) -> Vec<String> {
+    receipts
+        .terminal_by_attempt
+        .values()
+        .filter(|receipt| {
+            let previous = &receipt.params;
+            previous.delivery_id == params.delivery_id
+                && previous.server_instance_id == params.server_instance_id
+                && previous.thread_id == params.thread_id
+                && previous.input == params.input
+                && previous.attempt_id != params.attempt_id
+        })
+        .map(|receipt| receipt.params.attempt_id.clone())
+        .collect()
+}
+
+fn terminal_no_start_response(
+    receipt: &TerminalNoStartReceipt,
+    replayed: bool,
+) -> ThreadStartIfIdleResponse {
+    ThreadStartIfIdleResponse::TerminalNotStarted {
+        reason: receipt.reason.clone(),
+        receipt_id: receipt.receipt_id.clone(),
+        replayed,
+    }
+}
+
+fn terminalize_no_start(
+    receipts: &mut ReceiptStore,
+    params: &ThreadStartIfIdleParams,
+    reason: ThreadStartIfIdleNotStartedReason,
+) -> ThreadStartIfIdleResponse {
+    // A registered in-memory start cannot be promoted to a receipt without the durable proof.
+    if receipts
+        .by_delivery
+        .get(&params.delivery_id)
+        .is_some_and(|receipt| receipt_matches_params(receipt, params))
+    {
+        return ThreadStartIfIdleResponse::Unknown;
+    }
+    if let Some(existing) = receipts.terminal_by_attempt.get(&params.attempt_id) {
+        return if existing.params == *params {
+            terminal_no_start_response(existing, true)
+        } else {
+            not_started(ThreadStartIfIdleNotStartedReason::DuplicateConflict)
+        };
+    }
+    if duplicate_conflict(receipts, params) {
+        return not_started(ThreadStartIfIdleNotStartedReason::DuplicateConflict);
+    }
+    if receipts.len() >= MAX_RECEIPTS {
+        return ThreadStartIfIdleResponse::Unknown;
+    }
+
+    let receipt = TerminalNoStartReceipt {
+        params: params.clone(),
+        reason,
+        receipt_id: Uuid::now_v7().to_string(),
+    };
+    let response = terminal_no_start_response(&receipt, false);
+    receipts
+        .terminal_by_attempt
+        .insert(params.attempt_id.clone(), receipt);
+    response
+}
+
+fn duplicate_conflict(receipts: &ReceiptStore, params: &ThreadStartIfIdleParams) -> bool {
+    receipts.by_attempt.contains_key(&params.attempt_id)
+        || receipts.by_delivery.contains_key(&params.delivery_id)
+        || receipts
+            .terminal_by_attempt
+            .values()
+            .any(|receipt| receipt.params.permit_id == params.permit_id)
+        || receipts
+            .by_delivery
+            .values()
+            .any(|receipt| receipt.permit_id == params.permit_id)
+        || receipts
+            .by_client_user_message_id
+            .contains_key(&params.client_user_message_id)
+        || receipts.terminal_by_attempt.values().any(|receipt| {
+            receipt.params.client_user_message_id == params.client_user_message_id
+                && receipt.params.delivery_id != params.delivery_id
+        })
+}
+
+fn receipt_matches(receipt: &NativeReceipt, candidate: &NativeReceipt) -> bool {
+    receipt.server_instance_id == candidate.server_instance_id
+        && receipt.selection_generation == candidate.selection_generation
+        && receipt.attempt_id == candidate.attempt_id
+        && receipt.delivery_id == candidate.delivery_id
+        && receipt.thread_id == candidate.thread_id
+        && receipt.client_user_message_id == candidate.client_user_message_id
+        && receipt.permit_id == candidate.permit_id
+        && receipt.permit_issued_at == candidate.permit_issued_at
+        && receipt.permit_expires_at == candidate.permit_expires_at
+        && receipt.input == candidate.input
+}
+
+fn receipt_matches_params(receipt: &NativeReceipt, params: &ThreadStartIfIdleParams) -> bool {
+    receipt.server_instance_id == params.server_instance_id
+        && receipt.selection_generation == params.expected_generation
+        && receipt.attempt_id == params.attempt_id
+        && receipt.delivery_id == params.delivery_id
+        && receipt.thread_id == params.thread_id
+        && receipt.client_user_message_id == params.client_user_message_id
+        && receipt.permit_id == params.permit_id
+        && receipt.permit_issued_at == params.permit_issued_at
+        && receipt.permit_expires_at == params.permit_expires_at
+        && receipt.input == params.input
+}
+
+fn receipt_matches_identity(receipt: &NativeReceipt, identity: &NativeTurnStartIdentity) -> bool {
+    receipt.server_instance_id == identity.server_instance_id
+        && receipt.selection_generation == identity.selection_generation
+        && receipt.attempt_id == identity.attempt_id
+        && receipt.delivery_id == identity.delivery_id
+        && receipt.thread_id == identity.thread_id
+        && receipt.client_user_message_id == identity.client_user_message_id
+        && receipt.permit_id == identity.permit_id
+        && receipt.permit_issued_at == identity.permit_issued_at
+        && receipt.permit_expires_at == identity.permit_expires_at
+        && receipt.input == identity.input
+}
+
+fn identity_from_params(params: &ThreadStartIfIdleParams) -> NativeTurnStartIdentity {
+    NativeTurnStartIdentity {
+        server_instance_id: params.server_instance_id.clone(),
+        selection_generation: params.expected_generation,
+        attempt_id: params.attempt_id.clone(),
+        delivery_id: params.delivery_id.clone(),
+        thread_id: params.thread_id.clone(),
+        client_user_message_id: params.client_user_message_id.clone(),
+        permit_id: params.permit_id.clone(),
+        permit_issued_at: params.permit_issued_at,
+        permit_expires_at: params.permit_expires_at,
+        input: params.input.clone(),
+    }
+}
+
+fn identity_from_receipt(receipt: &NativeReceipt) -> NativeTurnStartIdentity {
+    NativeTurnStartIdentity {
+        server_instance_id: receipt.server_instance_id.clone(),
+        selection_generation: receipt.selection_generation,
+        attempt_id: receipt.attempt_id.clone(),
+        delivery_id: receipt.delivery_id.clone(),
+        thread_id: receipt.thread_id.clone(),
+        client_user_message_id: receipt.client_user_message_id.clone(),
+        permit_id: receipt.permit_id.clone(),
+        permit_issued_at: receipt.permit_issued_at,
+        permit_expires_at: receipt.permit_expires_at,
+        input: receipt.input.clone(),
+    }
+}
+
+fn start_response_from_proof(proof: NativeTurnStartProof) -> ThreadStartIfIdleResponse {
+    match proof {
+        NativeTurnStartProof::Pending => ThreadStartIfIdleResponse::Unknown,
+        NativeTurnStartProof::Started { turn_id }
+        | NativeTurnStartProof::InputRecorded { turn_id, .. } => {
+            ThreadStartIfIdleResponse::Started {
+                turn_id,
+                replayed: true,
+            }
+        }
+    }
+}
+
+fn receipt_response_from_proof(proof: NativeTurnStartProof) -> ThreadStartReceiptResponse {
+    match proof {
+        NativeTurnStartProof::Pending => ThreadStartReceiptResponse::Unknown,
+        NativeTurnStartProof::Started { turn_id } => ThreadStartReceiptResponse::Started {
+            turn_id,
+            replayed: true,
+        },
+        NativeTurnStartProof::InputRecorded { turn_id, item_id } => {
+            ThreadStartReceiptResponse::InputRecorded {
+                turn_id,
+                item_id,
+                replayed: true,
+            }
+        }
+    }
+}
+
+fn valid_identifier(value: &str) -> bool {
+    !value.is_empty() && value.len() <= MAX_ID_BYTES && !value.chars().any(char::is_control)
+}
+
+fn valid_start_params(params: &ThreadStartIfIdleParams) -> bool {
+    valid_identifier(&params.attempt_id)
+        && valid_identifier(&params.delivery_id)
+        && valid_identifier(&params.permit_id)
+        && Uuid::parse_str(&params.client_user_message_id).is_ok()
+        && !params.input.is_empty()
+        && params.input.len() <= MAX_INPUT_BYTES
+}
+
+fn validate_permit_window(
+    issued_at: u64,
+    expires_at: u64,
+    now_ms: u64,
+) -> Result<(), ThreadStartIfIdleNotStartedReason> {
+    if issued_at > now_ms
+        || expires_at <= issued_at
+        || expires_at - issued_at != MAX_PERMIT_LIFETIME_MS
+    {
+        return Err(ThreadStartIfIdleNotStartedReason::PermitInvalid);
+    }
+    if now_ms >= expires_at {
+        return Err(ThreadStartIfIdleNotStartedReason::PermitExpired);
+    }
+    Ok(())
+}
+
+async fn validate_permit_then<T>(
+    issued_at_ms: u64,
+    expires_at_ms: u64,
+    mut clock: impl FnMut() -> (Instant, u64),
+    preparation: impl Future<Output = Result<T, ThreadStartIfIdleNotStartedReason>>,
+) -> Result<(Instant, T), ThreadStartIfIdleNotStartedReason> {
+    let (monotonic_anchor, now_ms) = clock();
+    validate_permit_window(issued_at_ms, expires_at_ms, now_ms)?;
+    let permit_deadline =
+        monotonic_anchor + Duration::from_millis(expires_at_ms.saturating_sub(now_ms));
+    let prepared = preparation.await?;
+    Ok((permit_deadline, prepared))
+}
+
+fn unix_time_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| u64::try_from(duration.as_millis()).unwrap_or(u64::MAX))
+        .unwrap_or_default()
+}
+
+fn not_started(reason: ThreadStartIfIdleNotStartedReason) -> ThreadStartIfIdleResponse {
+    ThreadStartIfIdleResponse::NotStarted { reason }
+}
+
+fn lock<T>(mutex: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    mutex
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
