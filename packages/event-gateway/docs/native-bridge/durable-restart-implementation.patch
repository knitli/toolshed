+#[tokio::test]
+async fn native_receipt_write_failure_keeps_pending_unknown_and_duplicate_reservation()
+-> anyhow::Result<()> {
+    let runtime = runtime(&unique_temp_dir()).await?;
+    let request = identity(2);
+    assert_eq!(
+        runtime.begin_native_turn_start(&request, &[]).await?,
+        NativeTurnStartBegin::Created
+    );
+    sqlx::query(
+        "CREATE TRIGGER fail_native_receipt_start BEFORE UPDATE OF stage ON native_turn_start_receipts WHEN NEW.stage = 'started' BEGIN SELECT RAISE(ABORT, 'start commit failure'); END",
+    )
+    .execute(runtime.pool.as_ref())
+    .await?;
+    assert!(
+        runtime
+            .record_native_turn_started(&request, &request.client_user_message_id)
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        runtime.get_native_turn_start_proof(&request).await?,
+        Some(NativeTurnStartProof::Pending)
+    );
+    assert_eq!(
+        runtime.begin_native_turn_start(&request, &[]).await?,
+        NativeTurnStartBegin::Existing(NativeTurnStartProof::Pending),
+        "a failed durable transition must not permit a duplicate Core submission"
+    );
+    Ok(())
+}
