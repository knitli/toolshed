+    let retry_start: ThreadStartIfIdleResponse = app
+        .request(|request_id| ClientRequest::ThreadStartIfIdle { request_id, params })
+        .await?;
+    assert_eq!(
+        retry_start,
+        ThreadStartIfIdleResponse::Unknown,
+        "a pending DB reservation remains ambiguous and cannot submit again"
+    );
+    assert_eq!(
+        server
+            .received_requests()
+            .await
+            .context("mock server should retain requests after ambiguous retry")?
+            .len(),
+        initial_count
+    );
