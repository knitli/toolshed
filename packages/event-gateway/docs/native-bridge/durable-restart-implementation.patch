+    NativeTurnStartIdentity {
+        server_instance_id: format!("server-{id}"),
+        selection_generation: 4,
+        attempt_id: format!("attempt-{id}"),
+        delivery_id: format!("delivery-{id}"),
+        thread_id: format!("thread-{id}"),
+        client_user_message_id: format!("00000000-0000-7000-8000-{index:012x}"),
+        permit_id: format!("permit-{id}"),
+        permit_issued_at: 1_700_000_000_000,
+        permit_expires_at: 1_700_000_005_000,
+        input: format!("sensitive exact input {id}"),
+    }
+}
