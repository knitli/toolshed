+        first_start,
+        ThreadStartIfIdleResponse::Unknown,
+        "an in-memory Core registration cannot be advertised after its durable write fails"
+    );
+    timeout(
+        DEFAULT_READ_TIMEOUT,
+        app.read_stream_until_notification_message("turn/completed"),
