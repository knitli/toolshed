+            model: Some("gpt-5.2".to_string()),
+            ..Default::default()
+        })
+        .await?;
+    let ClientSelectionUpdateResponse {
+        server_instance_id,
+        generation,
+        ..
+    } = app
+        .request(|request_id| ClientRequest::ClientSelectionUpdate {
+            request_id,
+            params: ClientSelectionUpdateParams {
+                expected_generation: 0,
+                thread_id: Some(thread.id.clone()),
+                ready: true,
+            },
+        })
+        .await?;
+    let now_ms = SystemTime::now().duration_since(UNIX_EPOCH)?.as_millis() as u64;
+    let params = ThreadStartIfIdleParams {
+        server_instance_id,
+        expected_generation: generation,
+        thread_id: thread.id,
+        attempt_id: uuid::Uuid::now_v7().to_string(),
+        delivery_id: format!("native-db-failure-{}", uuid::Uuid::now_v7()),
+        client_user_message_id: uuid::Uuid::now_v7().to_string(),
+        permit_id: format!("permit-{}", uuid::Uuid::now_v7()),
+        permit_issued_at: now_ms,
+        permit_expires_at: now_ms + 5_000,
+        input: "Core may start, but this receipt write will fail".to_string(),
+    };
+
+    let state_db = SqlitePoolOptions::new()
+        .max_connections(1)
+        .connect_with(
+            SqliteConnectOptions::new()
+                .filename(codex_home.path().join("state_5.sqlite"))
+                .create_if_missing(false),
+        )
+        .await?;
+    sqlx::query(
+        "CREATE TRIGGER fail_native_turn_start_receipt_update BEFORE UPDATE OF stage ON native_turn_start_receipts BEGIN SELECT RAISE(ABORT, 'durable receipt unavailable'); END",
+    )
