+CREATE TABLE native_turn_start_receipts (
+    receipt_id INTEGER PRIMARY KEY,
+    delivery_id TEXT NOT NULL,
+    server_instance_id TEXT NOT NULL,
+    selection_generation TEXT NOT NULL,
+    attempt_id TEXT NOT NULL,
+    thread_id TEXT NOT NULL,
+    client_user_message_id TEXT NOT NULL,
+    permit_id TEXT NOT NULL,
+    permit_issued_at TEXT NOT NULL,
+    permit_expires_at TEXT NOT NULL,
+    input TEXT NOT NULL,
+    stage TEXT NOT NULL CHECK (stage IN ('pending', 'started', 'input_recorded')),
+    turn_id TEXT,
+    input_item_id TEXT,
+    CHECK (
+        (stage = 'pending' AND turn_id IS NULL AND input_item_id IS NULL)
+        OR (stage = 'started' AND turn_id IS NOT NULL AND input_item_id IS NULL)
+        OR (stage = 'input_recorded' AND turn_id IS NOT NULL AND input_item_id IS NOT NULL)
+    ),
+    UNIQUE (attempt_id),
+    UNIQUE (client_user_message_id),
+    UNIQUE (permit_id)
+);
+
+CREATE INDEX native_turn_start_receipts_delivery_id
+    ON native_turn_start_receipts (delivery_id);
