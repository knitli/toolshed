+pub(crate) struct NativeSelectionRequestProcessor {
+    server_instance_id: String,
+    thread_manager: Arc<ThreadManager>,
+    state_db: Option<StateDbHandle>,
+    connections: Mutex<ConnectionSelections>,
+    receipts: Arc<Mutex<ReceiptStore>>,
+}
+
+impl std::fmt::Debug for NativeSelectionRequestProcessor {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("NativeSelectionRequestProcessor")
+            .field("server_instance_id", &self.server_instance_id)
