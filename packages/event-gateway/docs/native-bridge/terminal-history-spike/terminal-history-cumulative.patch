+use super::super::test_support::test_config;
+use super::*;
+use crate::ThreadStore;
+use codex_protocol::protocol::SessionMeta;
+use codex_protocol::protocol::SessionMetaLine;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use tempfile::TempDir;
+
+fn identity() -> NativeTurnStartIdentity {
+    NativeTurnStartIdentity {
+        server_instance_id: "server".into(),
+        selection_generation: 3,
+        bridge_client_id: Some("bridge".into()),
+        bridge_client_generation: Some(2),
+        attempt_id: "attempt".into(),
+        delivery_id: "delivery".into(),
+        thread_id: ThreadId::new().to_string(),
+        client_user_message_id: uuid::Uuid::now_v7().to_string(),
+        permit_id: "permit".into(),
+        permit_issued_at: 1,
+        permit_expires_at: 2,
+        input: "exact input".into(),
+    }
+}
+
+fn records(identity: &NativeTurnStartIdentity) -> Vec<Value> {
+    let thread_id = ThreadId::from_string(&identity.thread_id).unwrap();
+    let meta = SessionMeta {
+        id: thread_id,
+        session_id: ThreadId::new().into(),
+        history_mode: ThreadHistoryMode::Paginated,
+        ..Default::default()
+    };
+    vec![
+        serde_json::to_value(RolloutItem::SessionMeta(SessionMetaLine {
+            meta,
+            git: None,
+        }))
+        .unwrap(),
+        json!({"type":"event_msg", "payload":{"type":"item_completed",
+            "thread_id": identity.thread_id, "turn_id":identity.client_user_message_id,
+            "item":{"type":"UserMessage", "id":uuid::Uuid::now_v7().to_string(),
+                "client_id":identity.client_user_message_id,
+                "content":[{"type":"text", "text":identity.input, "text_elements":[]}]},
+            "started_at_ms":0,"completed_at_ms":1}}),
+        json!({"type":"event_msg", "payload":{"type":"task_complete",
+            "turn_id":identity.client_user_message_id, "last_agent_message":null}}),
+    ]
+}
+
+fn encode(records: &[Value]) -> Vec<u8> {
+    let mut bytes = Vec::new();
+    for (ordinal, value) in records.iter().enumerate() {
+        let mut value = value.clone();
+        value["timestamp"] = json!("2026-10-17T00:00:00Z");
+        value["ordinal"] = json!(ordinal);
+        serde_json::to_writer(&mut bytes, &value).unwrap();
+        bytes.push(b'\n');
+    }
+    bytes
+}
+
+#[test]
+fn strict_complete_snapshot_accepts_three_terminal_statuses() {
+    let identity = identity();
+    let mut records = records(&identity);
+    let item_id = records[1]["payload"]["item"]["id"]
+        .as_str()
+        .unwrap()
+        .to_owned();
+    assert_eq!(
+        terminal_anchor(&encode(&records), &identity),
+        Some((item_id.clone(), NativeTurnTerminalStatus::Completed))
+    );
+    records[2]["payload"]["error"] = json!({"message":"failed", "codex_error_info":null});
+    assert_eq!(
+        terminal_anchor(&encode(&records), &identity),
+        Some((item_id.clone(), NativeTurnTerminalStatus::Failed))
+    );
+    records[2]["payload"] = json!({"type":"turn_aborted", "turn_id": identity.client_user_message_id, "reason":"interrupted"});
+    assert_eq!(
+        terminal_anchor(&encode(&records), &identity),
+        Some((item_id, NativeTurnTerminalStatus::Canceled))
+    );
+}
+
+#[test]
+fn rejects_incomplete_malformed_duplicate_and_oversized_snapshots() {
+    let identity = identity();
+    let records = records(&identity);
+    let valid = encode(&records);
+    for bytes in [
+        Vec::new(),
+        valid[..valid.len() - 1].to_vec(),
+        [valid.clone(), b"bad\n".to_vec()].concat(),
+        [valid.clone(), b"\n".to_vec()].concat(),
+        encode(&records[..2]),
+        vec![b'x'; MAX_ROLLOUT_LINE_BYTES + 1],
+        [valid.clone(), valid.clone()].concat(),
+    ] {
+        assert_eq!(terminal_anchor(&bytes, &identity), None);
+    }
+    let duplicated_key = String::from_utf8(valid.clone())
+        .unwrap()
+        .replace("\"ordinal\":1", "\"ordinal\":99,\"ordinal\":1");
+    assert_eq!(terminal_anchor(duplicated_key.as_bytes(), &identity), None);
+    let duplicate_nested = String::from_utf8(valid.clone()).unwrap().replace(
+        "\"text\":\"exact input\"",
+        "\"text\":\"wrong\",\"text\":\"exact input\"",
+    );
+    assert_eq!(
+        terminal_anchor(duplicate_nested.as_bytes(), &identity),
+        None
+    );
+    let bad_ordinal = String::from_utf8(valid)
+        .unwrap()
+        .replace("\"ordinal\":1", "\"ordinal\":9");
+    assert_eq!(terminal_anchor(bad_ordinal.as_bytes(), &identity), None);
+    let filler = json!({"type":"event_msg","payload":{"type":"task_complete", "turn_id":"other", "last_agent_message":null}});
+    let mut bounded = records;
+    bounded.extend(std::iter::repeat_n(filler.clone(), 253));
+    assert!(terminal_anchor(&encode(&bounded), &identity).is_some());
+    bounded.push(filler);
+    assert_eq!(terminal_anchor(&encode(&bounded), &identity), None);
+}
+
+#[test]
+fn rejects_wrong_identity_content_core_item_and_conflicting_anchors() {
+    let identity = identity();
+    let good = records(&identity);
+    for (pointer, value) in [
+        ("/payload/thread_id", json!(ThreadId::new().to_string())),
+        ("/payload/turn_id", json!("other")),
+        ("/payload/item/client_id", json!("other")),
+        ("/payload/item/id", json!(identity.client_user_message_id)),
+        ("/payload/item/id", json!(uuid::Uuid::new_v4().to_string())),
+        ("/payload/item/id", json!("invalid")),
+        ("/payload/item/content/0/text", json!("wrong")),
+        ("/payload/item/content", json!([])),
+        (
+            "/payload/item/content/0/text_elements",
+            json!([{"byte_range":{"start":0,"end":1},"placeholder":null}]),
+        ),
+    ] {
+        let mut mutated = good.clone();
+        *mutated[1].pointer_mut(pointer).unwrap() = value;
+        assert_eq!(
+            terminal_anchor(&encode(&mutated), &identity),
+            None,
+            "{pointer}"
+        );
+    }
+    for duplicate in [good[0].clone(), good[1].clone(), good[2].clone()] {
+        let mut mutated = good.clone();
+        mutated.push(duplicate);
+        assert_eq!(terminal_anchor(&encode(&mutated), &identity), None);
+    }
+    let mut started = good.clone();
+    let mut extra = started[1].clone();
+    extra["payload"]["type"] = json!("item_started");
+    started.insert(1, extra);
+    assert_eq!(terminal_anchor(&encode(&started), &identity), None);
+    let mut legacy = good.clone();
+    legacy[1] = json!({"type":"event_msg", "payload":{"type":"user_message", "message":identity.input,
+        "client_id":identity.client_user_message_id, "images":null,"local_images":[], "text_elements":[]}});
+    assert_eq!(terminal_anchor(&encode(&legacy), &identity), None);
+    for payload in [
+        json!({"type":"turn_aborted", "turn_id":null,"reason":"interrupted"}),
+        json!({"type":"thread_rolled_back", "num_turns":1}),
+    ] {
+        let mut ambiguous = good.clone();
+        ambiguous.push(json!({"type":"event_msg", "payload":payload}));
+        assert_eq!(terminal_anchor(&encode(&ambiguous), &identity), None);
+    }
+    let mut no_id = good;
+    no_id[2]["payload"] = json!({"type":"turn_aborted", "turn_id":null,"reason":"interrupted"});
+    assert_eq!(terminal_anchor(&encode(&no_id), &identity), None);
+}
