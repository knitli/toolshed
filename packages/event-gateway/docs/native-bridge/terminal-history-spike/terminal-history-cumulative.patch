+#[tokio::test]
+async fn snapshot_race_cannot_commit_state_evidence() {
+    let home = TempDir::new().unwrap();
+    let config = test_config(home.path());
+    let state = codex_state::StateRuntime::init(config.sqlite.clone(), "test-provider".into())
+        .await
+        .unwrap();
+    let identity = identity();
+    state.begin_native_turn_start(&identity, &[]).await.unwrap();
+    let thread_id = ThreadId::from_string(&identity.thread_id).unwrap();
+    let path = home
+        .path()
+        .join(format!("rollout-2026-10-17T00-00-00-{thread_id}.jsonl"));
+    let mut metadata = codex_state::ThreadMetadataBuilder::new(
+        thread_id,
+        path.clone(),
+        chrono::Utc::now(),
+        SessionSource::Cli,
+    )
+    .build("test-provider");
+    metadata.history_mode = ThreadHistoryMode::Paginated;
+    state.upsert_thread(&metadata).await.unwrap();
+    let store = LocalThreadStore::new(config, Some(state.clone()));
+    let _lifecycle = store.live_writer_locks.reserve_lifecycle(thread_id).await;
+    let _writer = store.live_writer_locks.lock(thread_id).await;
+    let _file_lock = store.acquire_writer_lock(thread_id).unwrap();
+    let good = encode(&records(&identity));
+    for replacement in [false, true] {
+        tokio::fs::write(&path, &good).await.unwrap();
+        let first = snapshot(&path).await.unwrap();
+        let (item_id, status) = terminal_anchor(&first.bytes, &identity).unwrap();
+        // Simulate an external file change after parsing and before the commit boundary.
+        if replacement {
+            let temporary = home.path().join("replacement.jsonl");
+            tokio::fs::write(&temporary, &good).await.unwrap();
+            tokio::fs::rename(temporary, &path).await.unwrap();
+        } else {
+            let changed = String::from_utf8(good.clone())
+                .unwrap()
+                .replace("exact input", "wrong input");
+            tokio::fs::write(&path, changed).await.unwrap();
+        }
+        assert_eq!(
+            commit_snapshot(&state, &identity, &path, &first, &item_id, status).await,
+            None
+        );
+        assert_eq!(
+            state.get_native_turn_start_proof(&identity).await.unwrap(),
+            Some(codex_state::NativeTurnStartProof::Pending)
+        );
+        assert_eq!(
+            state
+                .get_native_turn_terminal_proof(&identity)
+                .await
+                .unwrap(),
+            None
+        );
+    }
+}
