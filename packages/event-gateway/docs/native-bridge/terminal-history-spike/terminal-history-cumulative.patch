+#[tokio::test]
+async fn invalid_history_never_commits_and_offline_history_recovers() {
+    let home = TempDir::new().unwrap();
+    let config = test_config(home.path());
+    let state = codex_state::StateRuntime::init(config.sqlite.clone(), "test-provider".into())
+        .await
+        .unwrap();
+    let identity = identity();
+    state.begin_native_turn_start(&identity, &[]).await.unwrap();
+    let thread_id = ThreadId::from_string(&identity.thread_id).unwrap();
+    let path = home
+        .path()
+        .join(format!("rollout-2026-10-17T00-00-00-{thread_id}.jsonl"));
+    let mut metadata = codex_state::ThreadMetadataBuilder::new(
+        thread_id,
+        path.clone(),
+        chrono::Utc::now(),
+        SessionSource::Cli,
+    )
+    .build("test-provider");
+    metadata.history_mode = ThreadHistoryMode::Paginated;
+    state.upsert_thread(&metadata).await.unwrap();
+    let store = LocalThreadStore::new(config.clone(), Some(state.clone()));
+    let good = encode(&records(&identity));
+    for bytes in [
+        good[..good.len() - 1].to_vec(),
+        [good.clone(), b"bad\n".to_vec()].concat(),
+    ] {
+        tokio::fs::write(&path, bytes).await.unwrap();
+        assert_eq!(
+            store
+                .recover_native_terminal_history(&identity)
+                .await
+                .unwrap(),
+            None
+        );
+        assert_eq!(
+            state.get_native_turn_start_proof(&identity).await.unwrap(),
+            Some(codex_state::NativeTurnStartProof::Pending)
+        );
+    }
+    tokio::fs::write(&path, &good).await.unwrap();
+    let competing = LocalThreadStore::new(config.clone(), Some(state.clone()));
+    let guard = competing.acquire_writer_lock(thread_id).unwrap();
+    assert_eq!(
+        store
+            .recover_native_terminal_history(&identity)
+            .await
+            .unwrap(),
+        None
+    );
+    drop(guard);
+    let without_db = LocalThreadStore::new(config, None);
+    assert_eq!(
+        without_db
+            .recover_native_terminal_history(&identity)
+            .await
+            .unwrap(),
+        None
+    );
+    store
+        .resume_thread(crate::ResumeThreadParams {
+            thread_id,
+            rollout_path: Some(path.clone()),
+            history: None,
+            include_archived: true,
+            metadata: crate::ThreadPersistenceMetadata {
+                cwd: Some(home.path().to_path_buf()),
+                model_provider: "test-provider".into(),
+                memory_mode: codex_protocol::protocol::ThreadMemoryMode::Enabled,
+            },
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        store
+            .recover_native_terminal_history(&identity)
+            .await
+            .unwrap(),
+        None
+    );
+    assert_eq!(
+        state.get_native_turn_start_proof(&identity).await.unwrap(),
+        Some(codex_state::NativeTurnStartProof::Pending)
+    );
+    store.shutdown_thread(thread_id).await.unwrap();
+    let proof = store
+        .recover_native_terminal_history(&identity)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(proof.status, NativeTurnTerminalStatus::Completed);
+    assert!(matches!(
+        state.get_native_turn_start_proof(&identity).await.unwrap(),
+        Some(codex_state::NativeTurnStartProof::InputRecorded { .. })
+    ));
+}
