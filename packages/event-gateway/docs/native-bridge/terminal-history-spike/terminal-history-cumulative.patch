+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum NativeTurnTerminalStatus {
+    Completed,
+    Failed,
+    Canceled,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct NativeTurnTerminalProof {
+    pub turn_id: String,
+    pub receipt_id: String,
+    pub status: NativeTurnTerminalStatus,
+}
+
 impl StateRuntime {
+    /// Commits immutable terminal evidence only for an already-started v3 identity.
+    pub async fn record_native_turn_terminal(
+        &self,
+        identity: &NativeTurnStartIdentity,
+        turn_id: &str,
+        status: NativeTurnTerminalStatus,
+    ) -> anyhow::Result<NativeTurnTerminalProof> {
+        validate_terminal_identity(identity)?;
+        validate_started_turn(identity, turn_id)?;
+        let mut transaction = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let row = exact_native_receipt_row(&mut transaction, identity).await?;
+        if matches!(proof_from_row(&row)?, NativeTurnStartProof::Pending) {
+            bail!("native terminal proof requires committed start evidence");
+        }
+        if row
+            .try_get::<Option<String>, _>("terminal_candidate_status")?
+            .is_some_and(|candidate| candidate != terminal_status_name(status))
+        {
+            bail!("native terminal status conflicts with observed candidate");
+        }
+        let proof = commit_terminal_proof(&mut transaction, &row, status).await?;
+        transaction.commit().await?;
+        Ok(proof)
+    }
+
+    /// Atomically commits input and terminal evidence from a fully validated canonical history.
+    pub async fn recover_native_turn_terminal(
+        &self,
+        identity: &NativeTurnStartIdentity,
+        turn_id: &str,
+        item_id: &str,
+        status: NativeTurnTerminalStatus,
+    ) -> anyhow::Result<NativeTurnTerminalProof> {
+        validate_terminal_identity(identity)?;
+        validate_started_turn(identity, turn_id)?;
+        validate_core_item_id(turn_id, item_id)?;
+        let mut transaction = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let row = exact_native_receipt_row(&mut transaction, identity).await?;
+        if row
+            .try_get::<Option<String>, _>("terminal_candidate_status")?
+            .is_some_and(|candidate| candidate != terminal_status_name(status))
+        {
+            bail!("native history terminal status conflicts with observed candidate");
+        }
+        if terminal_proof_from_row(&row)?.is_some_and(|proof| proof.status != status) {
+            bail!("native history terminal status conflicts with committed proof");
+        }
+        match proof_from_row(&row)? {
+            NativeTurnStartProof::Pending => {}
+            NativeTurnStartProof::Started { turn_id: existing } if existing == turn_id => {}
+            NativeTurnStartProof::InputRecorded {
+                turn_id: existing,
+                item_id: existing_item,
+            } if existing == turn_id && existing_item == item_id => {}
+            _ => bail!("native history input conflicts with committed anchor"),
+        }
+        update_native_receipt(
+            &mut transaction,
+            identity,
+            "input_recorded",
+            turn_id,
+            Some(item_id),
+        )
+        .await?;
+        let row = exact_native_receipt_row(&mut transaction, identity).await?;
+        let proof = commit_terminal_proof(&mut transaction, &row, status).await?;
+        transaction.commit().await?;
+        Ok(proof)
+    }
+
