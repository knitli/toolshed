+    let manager = crate::thread_state::ThreadStateManager::default();
+    let receipts = Arc::new(Mutex::new(ReceiptStore::default()));
+    install_native_receipt_observer(&manager, &receipts, Some(db.clone()));
+    for (index, fixture) in fixtures.iter().enumerate() {
+        let status = match fixture.status.as_str() {
+            "completed" => Status::Completed,
+            "failed" => Status::Failed,
+            "canceled" => Status::Canceled,
+            _ => panic!("invalid status"),
+        };
+        assert_eq!(fixture.status, ["completed", "failed", "canceled"][index]);
+        let mut params = request_params();
+        params.thread_id = fixture.thread_id.clone();
+        params.client_user_message_id = fixture.turn_id.clone();
+        params.attempt_id = format!("terminal-attempt-{index}");
+        params.delivery_id = format!("terminal-delivery-{index}");
+        params.permit_id = format!("terminal-permit-{index}");
+        params.bridge_client_id = Some("terminal-bridge".into());
+        params.bridge_client_generation = Some(9);
+        let identity = identity_from_params(&params);
+        if mode.starts_with("recover") {
+            let proof = db.get_native_turn_terminal_proof(&identity).await?;
+            if mode == "recover_before" || mode == "recover_candidate" {
+                assert_eq!(proof, None);
+                if mode == "recover_candidate" {
+                    db.record_native_turn_started(&identity, &fixture.turn_id)
+                        .await?;
+                    let promoted = db
+                        .get_native_turn_terminal_proof(&identity)
+                        .await?
+                        .expect("durable candidate promotes after genuine start anchor");
+                    assert_eq!(promoted.status, status);
+                    assert_eq!(promoted.turn_id, fixture.turn_id);
+                }
+            } else {
+                assert_eq!(proof.expect("committed proof").status, status);
+            }
+            continue;
+        }
+        db.begin_native_turn_start(&identity, &[]).await?;
+        let thread = ThreadId::from_string(&fixture.thread_id)?;
+        manager
+            .observe_core_item_completed(ThreadId::new(), &fixture.event)
+            .await;
+        assert_eq!(db.get_native_turn_terminal_proof(&identity).await?, None);
+        if mode == "before" {
+            continue;
+        }
+        if mode == "write_failure" {
+            db.close().await;
+        }
+        // Volatile receipts deliberately remain empty: durable identity correlates the event.
+        manager
+            .observe_core_item_completed(thread, &fixture.event)
+            .await;
+        if mode == "write_failure" {
+            let reopened = StateRuntime::init(sqlite.clone(), "test-provider".into()).await?;
+            assert_eq!(
