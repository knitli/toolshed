+    let path = std::env::var_os("EVENT_TERMINAL_CORE_FIXTURE")
+        .expect("set EVENT_TERMINAL_CORE_FIXTURE to an output file");
+    let rollout_failure = std::env::var_os("EVENT_TERMINAL_ROLLOUT_FAILURE").is_some();
