+                None
+            );
+            db = reopened;
+            install_native_receipt_observer(&manager, &receipts, Some(db.clone()));
+            continue;
+        }
+        assert_eq!(
+            db.get_native_turn_terminal_proof(&identity).await?,
+            None,
+            "a terminal candidate alone is not a start or input anchor"
