+#[tokio::test]
+async fn bounded_snapshot_detects_replacement_mutation_and_truncation() {
+    let home = TempDir::new().unwrap();
+    let path = home.path().join("history.jsonl");
+    let identity = identity();
+    let bytes = encode(&records(&identity));
+    tokio::fs::write(&path, &bytes).await.unwrap();
+    let first = snapshot(&path).await.unwrap();
+    assert!(first.matches(&snapshot(&path).await.unwrap()));
+    let replacement = home.path().join("replacement.jsonl");
+    tokio::fs::write(&replacement, &bytes).await.unwrap();
+    tokio::fs::rename(&replacement, &path).await.unwrap();
+    assert!(!first.matches(&snapshot(&path).await.unwrap()));
+    tokio::fs::write(&path, [bytes.clone(), b"\n".to_vec()].concat())
+        .await
+        .unwrap();
+    assert!(!first.matches(&snapshot(&path).await.unwrap()));
+    tokio::fs::write(&path, &bytes[..bytes.len() - 1])
+        .await
+        .unwrap();
+    assert!(snapshot(&path).await.is_none());
+    tokio::fs::write(&path, vec![b'\n'; MAX_ROLLOUT_LINE_BYTES + 1])
+        .await
+        .unwrap();
+    assert!(snapshot(&path).await.is_none());
+}
