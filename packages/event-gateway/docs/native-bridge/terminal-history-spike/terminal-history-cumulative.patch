+        let proof = db
+            .get_native_turn_terminal_proof(&identity)
+            .await?
+            .expect("durable proof");
+        assert_eq!(proof.status, status);
+        assert_eq!(proof.turn_id, fixture.turn_id);
+        manager
+            .observe_core_item_completed(thread, &fixture.event)
+            .await;
+        assert_eq!(
+            db.get_native_turn_terminal_proof(&identity).await?,
+            Some(proof)
+        );
+    }
+    if mode == "before" {
+        std::process::exit(71);
+    }
+    if mode == "candidate" {
+        std::process::exit(73);
+    }
+    if mode == "after" {
+        std::process::exit(72);
+    }
+    db.close().await;
+    let reopened = StateRuntime::init(sqlite, "test-provider".into()).await?;
+    reopened.close().await;
+    Ok(())
