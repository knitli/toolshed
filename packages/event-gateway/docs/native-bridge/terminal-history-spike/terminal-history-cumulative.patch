+use super::LocalThreadStore;
+use super::rollout_migration::MAX_ROLLOUT_LINE_BYTES;
+use crate::ThreadStoreResult;
+use codex_protocol::ThreadId;
+use codex_protocol::items::TurnItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_protocol::protocol::ThreadSource;
+use codex_protocol::user_input::UserInput;
+use codex_rollout::RolloutItem;
+use codex_state::NativeTurnStartIdentity;
+use codex_state::NativeTurnTerminalProof;
+use codex_state::NativeTurnTerminalStatus;
+use std::path::Path;
+use tokio::io::AsyncReadExt;
+
+impl LocalThreadStore {
+    /// Recover terminal evidence only from a complete, bounded, offline canonical rollout.
+    /// Locks coordinate cooperating writers sharing Codex home; arbitrary external writes are excluded.
+    pub async fn recover_native_terminal_history(
+        &self,
+        identity: &NativeTurnStartIdentity,
+    ) -> ThreadStoreResult<Option<NativeTurnTerminalProof>> {
+        let proof = async {
+            let thread_id = ThreadId::from_string(&identity.thread_id).ok()?;
+            let state = self.state_db.as_ref()?;
+            let _lifecycle = self.live_writer_locks.reserve_lifecycle(thread_id).await;
+            let _writer = self.live_writer_locks.lock(thread_id).await;
+            if self.live_recorders.lock().await.contains_key(&thread_id) {
+                return None;
+            }
+            let _file_lock = self.acquire_writer_lock(thread_id).ok()?;
+            let metadata = state.get_thread(thread_id).await.ok()??;
+            if metadata.id != thread_id || metadata.history_mode != ThreadHistoryMode::Paginated {
+                return None;
+            }
+            let path = &metadata.rollout_path;
+            let first = snapshot(path).await?;
+            let (item_id, status) = terminal_anchor(&first.bytes, identity)?;
+            commit_snapshot(state, identity, path, &first, &item_id, status).await
+        }
+        .await;
+        Ok(proof)
+    }
+}
+
+// Caller holds the lifecycle, local writer, and cross-process writer locks.
+async fn commit_snapshot(
+    state: &codex_state::StateRuntime,
+    identity: &NativeTurnStartIdentity,
+    path: &Path,
+    first: &Snapshot,
+    item_id: &str,
+    status: NativeTurnTerminalStatus,
+) -> Option<NativeTurnTerminalProof> {
+    let second = snapshot(path).await?;
+    let thread_id = ThreadId::from_string(&identity.thread_id).ok()?;
+    let current = state.get_thread(thread_id).await.ok()??;
+    if !first.matches(&second)
+        || current.rollout_path != path
+        || current.history_mode != ThreadHistoryMode::Paginated
+    {
+        return None;
+    }
+    state
+        .recover_native_turn_terminal(identity, &identity.client_user_message_id, item_id, status)
+        .await
+        .ok()
+}
+
+struct Snapshot {
+    bytes: Vec<u8>,
+    metadata: std::fs::Metadata,
+    path: std::path::PathBuf,
+}
+
+impl Snapshot {
+    fn matches(&self, other: &Self) -> bool {
+        self.path == other.path
+            && self.bytes == other.bytes
+            && same_metadata(&self.metadata, &other.metadata)
+    }
+}
+
+fn same_metadata(left: &std::fs::Metadata, right: &std::fs::Metadata) -> bool {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if left.dev() != right.dev()
+            || left.ino() != right.ino()
+            || left.ctime() != right.ctime()
+            || left.ctime_nsec() != right.ctime_nsec()
+        {
+            return false;
+        }
+    }
+    left.len() == right.len()
+        && left.modified().ok() == right.modified().ok()
+        && left.created().ok() == right.created().ok()
+}
+
+async fn snapshot(path: &Path) -> Option<Snapshot> {
+    if path.extension()?.to_str()? != "jsonl"
+        || !tokio::fs::symlink_metadata(path).await.ok()?.is_file()
+    {
+        return None;
+    }
+    let canonical = tokio::fs::canonicalize(path).await.ok()?;
+    let file = tokio::fs::File::open(path).await.ok()?;
+    let metadata = file.metadata().await.ok()?;
+    if !metadata.is_file() || metadata.len() > MAX_ROLLOUT_LINE_BYTES as u64 {
+        return None;
+    }
+    let mut bytes = Vec::new();
+    file.take((MAX_ROLLOUT_LINE_BYTES + 1) as u64)
+        .read_to_end(&mut bytes)
+        .await
+        .ok()?;
+    if bytes.len() > MAX_ROLLOUT_LINE_BYTES
+        || !bytes.ends_with(b"\n")
+        || !same_metadata(&metadata, &tokio::fs::metadata(path).await.ok()?)
+        || canonical != tokio::fs::canonicalize(path).await.ok()?
+    {
+        return None;
+    }
+    Some(Snapshot {
+        bytes,
+        metadata,
+        path: canonical,
+    })
+}
+
+fn terminal_anchor(
+    bytes: &[u8],
+    identity: &NativeTurnStartIdentity,
+) -> Option<(String, NativeTurnTerminalStatus)> {
+    if bytes.len() > MAX_ROLLOUT_LINE_BYTES || !bytes.ends_with(b"\n") {
+        return None;
+    }
+    let mut anchor = None;
+    let mut terminal = None;
+    let mut target_started = false;
+    let mut user_item_ids = std::collections::HashSet::new();
+    for (ordinal, raw) in bytes[..bytes.len() - 1]
+        .split(|byte| *byte == b'\n')
+        .enumerate()
+    {
+        if ordinal >= 256 || raw.iter().all(u8::is_ascii_whitespace) {
+            return None;
+        }
+        serde_json::from_slice::<UniqueJson>(raw).ok()?;
+        let line = codex_rollout::decode_rollout_line(serde_json::from_slice(raw).ok()?).ok()?;
+        if line.ordinal != Some(ordinal as u64) {
+            return None;
+        }
+        if ordinal == 0 {
+            let RolloutItem::SessionMeta(meta) = line.item else {
+                return None;
+            };
+            let meta = meta.meta;
+            if meta.id.to_string() != identity.thread_id
+                || meta.history_mode != ThreadHistoryMode::Paginated
+                || meta.forked_from_id.is_some()
+                || meta.forked_from_ordinal_exclusive.is_some()
+                || meta.parent_thread_id.is_some()
+                || meta.history_base.is_some()
+                || meta.subagent_history_start_ordinal.is_some()
+                || meta.agent_nickname.is_some()
+                || meta.agent_role.is_some()
+                || meta.agent_path.is_some()
+                || matches!(
+                    meta.source,
+                    SessionSource::SubAgent(_) | SessionSource::Unknown
+                )
+                || matches!(meta.thread_source, Some(ThreadSource::Subagent))
+            {
+                return None;
+            }
+            continue;
+        }
+        match line.item {
+            RolloutItem::SessionMeta(_)
+            | RolloutItem::EventMsg(EventMsg::UserMessage(_) | EventMsg::ThreadRolledBack(_)) => {
+                return None;
+            }
+            RolloutItem::EventMsg(EventMsg::TurnAborted(ref event)) if event.turn_id.is_none() => {
+                return None;
+            }
+            RolloutItem::EventMsg(EventMsg::ItemStarted(event)) => {
+                if let TurnItem::UserMessage(item) = event.item
+                    && (event.turn_id == identity.client_user_message_id
+                        || item.client_id.as_deref() == Some(&identity.client_user_message_id))
+                {
+                    return None;
+                }
+            }
+            RolloutItem::EventMsg(EventMsg::TurnStarted(event))
+                if event.turn_id == identity.client_user_message_id =>
+            {
+                if target_started || anchor.is_some() || terminal.is_some() {
+                    return None;
+                }
+                target_started = true;
+            }
+            RolloutItem::EventMsg(EventMsg::ItemCompleted(event)) => {
+                if let TurnItem::UserMessage(item) = event.item {
+                    if !user_item_ids.insert(item.id.clone()) {
+                        return None;
+                    }
+                    if event.turn_id != identity.client_user_message_id
+                        && item.client_id.as_deref() != Some(&identity.client_user_message_id)
+                    {
+                        continue;
+                    }
+                    if anchor.is_some()
+                        || terminal.is_some()
+                        || event.thread_id.to_string() != identity.thread_id
+                        || event.turn_id != identity.client_user_message_id
+                        || item.client_id.as_deref() != Some(&identity.client_user_message_id)
+                        || item.id == event.turn_id
+                    {
+                        return None;
+                    }
+                    let id = ThreadId::from_string(&item.id).ok()?.to_string();
+                    if id != item.id
+                        || id.as_bytes()[14] != b'7'
+                        || !matches!(id.as_bytes()[19], b'8' | b'9' | b'a' | b'b')
+                        || !matches!(item.content.as_slice(), [UserInput::Text {text, text_elements}]
+                            if text == &identity.input && text_elements.is_empty())
+                    {
+                        return None;
+                    }
+                    anchor = Some(item.id);
+                }
+            }
+            RolloutItem::EventMsg(EventMsg::TurnComplete(event))
+                if event.turn_id == identity.client_user_message_id =>
+            {
+                if anchor.is_none() || terminal.is_some() {
+                    return None;
+                }
+                terminal = Some(if event.error.is_some() {
+                    NativeTurnTerminalStatus::Failed
+                } else {
+                    NativeTurnTerminalStatus::Completed
+                });
+            }
+            RolloutItem::EventMsg(EventMsg::TurnAborted(event))
+                if event.turn_id.as_deref() == Some(&identity.client_user_message_id) =>
+            {
+                if anchor.is_none() || terminal.is_some() {
+                    return None;
+                }
+                terminal = Some(NativeTurnTerminalStatus::Canceled);
+            }
+            _ => {}
+        }
+    }
+    Some((anchor?, terminal?))
+}
+
+// Validate duplicate keys before Value decoding, which otherwise silently keeps the last value.
+struct UniqueJson;
+impl<'de> serde::Deserialize<'de> for UniqueJson {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct Visitor;
+        impl<'de> serde::de::Visitor<'de> for Visitor {
+            type Value = UniqueJson;
+            fn expecting(&self, formatter: &mut std::fmt::Formatter) -> std::fmt::Result {
+                formatter.write_str("JSON without duplicate object keys")
+            }
+            fn visit_bool<E: serde::de::Error>(self, _: bool) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+            fn visit_i64<E: serde::de::Error>(self, _: i64) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+            fn visit_u64<E: serde::de::Error>(self, _: u64) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+            fn visit_f64<E: serde::de::Error>(self, _: f64) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+            fn visit_str<E: serde::de::Error>(self, _: &str) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+            fn visit_unit<E: serde::de::Error>(self) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+            fn visit_seq<A: serde::de::SeqAccess<'de>>(
+                self,
+                mut seq: A,
+            ) -> Result<UniqueJson, A::Error> {
+                while seq.next_element::<UniqueJson>()?.is_some() {}
+                Ok(UniqueJson)
+            }
+            fn visit_map<A: serde::de::MapAccess<'de>>(
+                self,
+                mut map: A,
+            ) -> Result<UniqueJson, A::Error> {
+                let mut keys = std::collections::HashSet::new();
+                while let Some(key) = map.next_key::<String>()? {
+                    if !keys.insert(key) {
+                        return Err(serde::de::Error::custom("duplicate JSON key"));
+                    }
+                    map.next_value::<UniqueJson>()?;
+                }
+                Ok(UniqueJson)
+            }
+        }
+        deserializer.deserialize_any(Visitor)
+    }
+}
