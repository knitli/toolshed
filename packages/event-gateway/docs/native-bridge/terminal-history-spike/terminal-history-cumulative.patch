+//! Provider-free Core persistence proof, with no app-server listener or volatile receipt map.
+use super::SessionTask;
+use super::SessionTaskResult;
+use crate::session::TurnInput;
+use crate::session::UserInputMetadata;
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use crate::state::TaskKind;
+use codex_protocol::error::CodexErr;
+use codex_protocol::items::TurnItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::TurnAbortReason;
+use codex_protocol::user_input::UserInput;
+use codex_state::NativeTurnStartIdentity;
+use codex_state::NativeTurnStartProof;
+use codex_state::NativeTurnTerminalStatus;
+use codex_state::SqliteConfig;
+use codex_state::StateRuntime;
+use codex_thread_store::LocalThreadStore;
+use codex_thread_store::LocalThreadStoreConfig;
+use codex_thread_store::PersistContext;
+use std::sync::Arc;
+use tokio_util::sync::CancellationToken;
+
+const INPUT: &str = "exact native history fixture input";
+
+struct HistoryTask {
+    outcome: &'static str,
+    fault: &'static str,
+    ready: Arc<tokio::sync::Notify>,
+}
+
+impl SessionTask for HistoryTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.native_history_fixture"
+    }
+    async fn run(
+        self: Arc<Self>,
+        session: Arc<Session>,
+        turn: Arc<TurnContext>,
+        _input: Vec<TurnInput>,
+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        if self.fault == "before_input" {
+            session.live_thread().unwrap().shutdown().await.unwrap();
+            assert!(session.flush_rollout().await.is_err());
+        }
+        session
+            .record_user_prompt_and_emit_turn_item(
+                &turn,
+                turn.model_info(),
+                &[UserInput::Text {
+                    text: INPUT.to_string(),
+                    text_elements: Vec::new(),
+                }],
+                Some(turn.sub_id.clone()),
+                UserInputMetadata::default(),
+                PersistContext::Standard,
+            )
+            .await;
+        if self.fault == "before_terminal" {
+            session.flush_rollout().await.unwrap();
+            session.live_thread().unwrap().shutdown().await.unwrap();
+            assert!(session.flush_rollout().await.is_err());
+        }
+        self.ready.notify_one();
+        if self.outcome == "canceled" {
+            cancellation.cancelled().await;
+        }
+        if self.outcome == "failed" {
+            Err(CodexErr::Fatal("history fixture failure".to_string()))
+        } else {
+            Ok(None)
+        }
+    }
+}
+
+fn identity(thread: &str, turn: &str) -> NativeTurnStartIdentity {
+    NativeTurnStartIdentity {
+        server_instance_id: "original-history-server".to_string(),
+        selection_generation: 7,
+        bridge_client_id: Some("original-history-bridge".to_string()),
+        bridge_client_generation: Some(3),
+        attempt_id: format!("attempt-{turn}"),
+        delivery_id: format!("delivery-{turn}"),
+        thread_id: thread.to_string(),
+        client_user_message_id: turn.to_string(),
+        permit_id: format!("permit-{turn}"),
+        permit_issued_at: 1,
+        permit_expires_at: 5001,
+        input: INPUT.to_string(),
+    }
+}
+
+#[tokio::test]
+#[ignore = "explicit provider-free canonical history proof; requires EVENT_NATIVE_HISTORY_PROOF and PHASE"]
+async fn native_terminal_canonical_history_process_proof() {
+    let root = std::path::PathBuf::from(std::env::var_os("EVENT_NATIVE_HISTORY_PROOF").unwrap());
+    let phase = std::env::var("EVENT_NATIVE_HISTORY_PHASE").unwrap();
+    let fixtures_path = root.join("fixtures.json");
+    if phase == "produce" {
+        std::fs::create_dir_all(&root).unwrap();
+        let mut fixtures = Vec::new();
+        for fault in ["none", "before_input", "before_terminal"] {
+            for outcome in ["completed", "failed", "canceled"] {
+                let home = root.join(format!("{fault}-{outcome}"));
+                std::fs::create_dir_all(&home).unwrap();
+                let sqlite = SqliteConfig::new_for_testing(home.clone().try_into().unwrap());
+                let (mut session, mut turn, receiver) =
+                    crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+                        codex_login::CodexAuth::from_api_key("Test API Key"),
+                        Vec::new(),
+                        |config| {
+                            config.codex_home = home.clone().try_into().unwrap();
+                            config.sqlite = sqlite.clone();
+                        },
+                    )
+                    .await;
+                let config = session.get_config().await;
+                let state = StateRuntime::init(sqlite, config.model_provider_id.clone())
+                    .await
+                    .unwrap();
+                let local = Arc::new(LocalThreadStore::new(
+                    LocalThreadStoreConfig::from_config(config.as_ref()),
+                    Some(Arc::clone(&state)),
+                ));
+                Arc::get_mut(&mut session).unwrap().services.thread_store = local.clone();
+                let live = codex_thread_store::LiveThread::create(
+                    local.clone(),
+                    codex_thread_store::CreateThreadParams {
+                        creator_user_id: None,
+                        creator_account_id: None,
+                        session_id: session.session_id(),
+                        thread_id: session.thread_id,
+                        extra_config: None,
+                        forked_from_id: None,
+                        parent_thread_id: None,
+                        source: codex_protocol::protocol::SessionSource::Exec,
+                        thread_source: None,
+                        originator: "native-history-proof".to_string(),
+                        base_instructions: codex_protocol::models::BaseInstructions::default(),
+                        dynamic_tools: Vec::new(),
+                        selected_capability_roots: Vec::new(),
+                        multi_agent_version: None,
+                        history_mode: codex_protocol::protocol::ThreadHistoryMode::Paginated,
+                        subagent_history_start_ordinal: None,
+                        history_base: None,
+                        initial_window_id: uuid::Uuid::now_v7().to_string(),
+                        runtime_workspace_roots: None,
+                        metadata: codex_thread_store::ThreadPersistenceMetadata {
+                            cwd: Some(config.cwd.to_path_buf()),
+                            model_provider: config.model_provider_id.clone(),
+                            memory_mode: codex_protocol::protocol::ThreadMemoryMode::Disabled,
+                        },
+                    },
+                )
+                .await
+                .unwrap();
+                Arc::get_mut(&mut session).unwrap().services.live_thread = Some(live);
+                session
+                    .ensure_rollout_materialized(PersistContext::Standard)
+                    .await;
+                session.flush_rollout().await.unwrap();
+                let path = session.current_rollout_path().await.unwrap().unwrap();
+                let turn_id = uuid::Uuid::new_v4().to_string();
+                Arc::get_mut(&mut turn).unwrap().sub_id = turn_id.clone();
+                let bound = identity(&session.thread_id.to_string(), &turn_id);
+                assert_eq!(
+                    state.begin_native_turn_start(&bound, &[]).await.unwrap(),
+                    codex_state::NativeTurnStartBegin::Created
+                );
+                // The offline reader must refuse a live writer, without shutting it down.
+                assert_eq!(
+                    local.recover_native_terminal_history(&bound).await.unwrap(),
+                    None
+                );
+                let ready = Arc::new(tokio::sync::Notify::new());
+                session
+                    .spawn_task(
+                        turn,
+                        Vec::new(),
+                        HistoryTask {
+                            outcome,
+                            fault,
+                            ready: Arc::clone(&ready),
+                        },
+                    )
+                    .await;
+                let mut item_id = None;
+                tokio::time::timeout(std::time::Duration::from_secs(10), async {
+                    loop {
+                        let event = receiver.recv().await.unwrap();
+                        match event.msg {
+                            EventMsg::ItemCompleted(event) => {
+                                if let TurnItem::UserMessage(item) = event.item {
+                                    assert_eq!(item.client_id.as_deref(), Some(turn_id.as_str()));
+                                    item_id = Some(item.id);
+                                    if outcome == "canceled" {
+                                        ready.notified().await;
+                                        session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+                                    }
+                                }
+                            }
+                            EventMsg::TurnComplete(event) => {
+                                assert_eq!(event.turn_id, turn_id);
+                                assert_eq!(event.error.is_some(), outcome == "failed");
+                                break;
+                            }
+                            EventMsg::TurnAborted(event) => {
+                                assert_eq!(outcome, "canceled");
+                                assert_eq!(event.turn_id.as_deref(), Some(turn_id.as_str()));
+                                break;
+                            }
+                            _ => {}
+                        }
+                    }
+                })
+                .await
+                .unwrap();
+                assert!(item_id.is_some());
+                assert_eq!(
+                    state.get_native_turn_start_proof(&bound).await.unwrap(),
+                    Some(NativeTurnStartProof::Pending)
+                );
+                assert_eq!(
+                    state.get_native_turn_terminal_proof(&bound).await.unwrap(),
+                    None
+                );
+                if fault == "none" {
+                    session.flush_rollout().await.unwrap();
+                    session.live_thread().unwrap().shutdown().await.unwrap();
+                } else {
+                    assert!(session.flush_rollout().await.is_err());
+                    assert!(
+                        !session
+                            .persist_rollout_items(&[codex_history::RolloutItem::EventMsg(
+                                EventMsg::TurnStarted(codex_protocol::protocol::TurnStartedEvent {
+                                    turn_id: turn_id.clone(),
+                                    root_turn_id: None,
+                                    trace_id: None,
+                                    started_at: None,
+                                    model_context_window: None,
+                                    collaboration_mode_kind: Default::default(),
+                                })
+                            )])
+                            .await
+                    );
+                }
+                fixtures.push(serde_json::json!({"thread": bound.thread_id, "turn": turn_id, "item": item_id,
+                    "home": home, "rollout": path, "provider": config.model_provider_id, "outcome": outcome, "fault": fault}));
+            }
+        }
+        std::fs::write(fixtures_path, serde_json::to_vec_pretty(&fixtures).unwrap()).unwrap();
+        if std::env::var_os("EVENT_NATIVE_HISTORY_HARD_EXIT").is_some() {
+            // This owned test process exits without Rust destructors, after explicit writer flush.
+            std::process::exit(71);
+        }
+    } else {
+        assert_eq!(phase, "recover");
+        let fixtures: Vec<serde_json::Value> =
+            serde_json::from_slice(&std::fs::read(&fixtures_path).unwrap()).unwrap();
+        let mut proofs = Vec::new();
+        for fixture in fixtures {
+            let home = std::path::PathBuf::from(fixture["home"].as_str().unwrap());
+            let sqlite = SqliteConfig::new_for_testing(home.clone().try_into().unwrap());
+            let provider = fixture["provider"].as_str().unwrap().to_string();
+            let state = StateRuntime::init(sqlite.clone(), provider.clone())
+                .await
+                .unwrap();
+            let local = LocalThreadStore::new(
+                LocalThreadStoreConfig {
+                    codex_home: home,
+                    sqlite,
+                    default_model_provider_id: provider,
+                },
+                Some(Arc::clone(&state)),
+            );
+            let bound = identity(
+                fixture["thread"].as_str().unwrap(),
+                fixture["turn"].as_str().unwrap(),
+            );
+            let proof = local.recover_native_terminal_history(&bound).await.unwrap();
+            if fixture["fault"] == "none" {
+                let proof =
+                    proof.expect("genuine canonical history recovers after process restart");
+                assert_eq!(proof.turn_id, bound.client_user_message_id);
+                let expected = match fixture["outcome"].as_str().unwrap() {
+                    "completed" => NativeTurnTerminalStatus::Completed,
+                    "failed" => NativeTurnTerminalStatus::Failed,
+                    "canceled" => NativeTurnTerminalStatus::Canceled,
+                    _ => unreachable!(),
+                };
+                assert_eq!(proof.status, expected);
+                assert_eq!(
+                    state.get_native_turn_start_proof(&bound).await.unwrap(),
+                    Some(NativeTurnStartProof::InputRecorded {
+                        turn_id: bound.client_user_message_id.clone(),
+                        item_id: fixture["item"].as_str().unwrap().to_string(),
+                    })
+                );
+                assert_eq!(
+                    local.recover_native_terminal_history(&bound).await.unwrap(),
+                    Some(proof.clone())
+                );
+                proofs.push(serde_json::json!({"turn": proof.turn_id, "receipt": proof.receipt_id, "outcome": fixture["outcome"]}));
+            } else {
+                assert_eq!(proof, None);
+                assert_eq!(
+                    state.get_native_turn_start_proof(&bound).await.unwrap(),
+                    Some(NativeTurnStartProof::Pending)
+                );
+                assert_eq!(
+                    state.get_native_turn_terminal_proof(&bound).await.unwrap(),
+                    None
+                );
+            }
+        }
+        let output = root.join("proofs.json");
+        if output.exists() {
+            assert_eq!(
+                std::fs::read(&output).unwrap(),
+                serde_json::to_vec_pretty(&proofs).unwrap()
+            );
+        } else {
+            std::fs::write(output, serde_json::to_vec_pretty(&proofs).unwrap()).unwrap();
+        }
+    }
+}
