+#[tokio::test]
+async fn aborted_guarded_start_cancels_blocked_lifecycle_before_replacement() {
+    let (mut session, _turn_context) = make_session_and_context().await;
+    let blocked_turn_id = "blocked-guarded-turn".to_string();
+    let contributor = Arc::new(BlockingBeforeTaskStart {
+        blocked_turn_id: blocked_turn_id.clone(),
+        blocked_start_entered: tokio::sync::Notify::new(),
+        release_blocked_start: tokio::sync::Notify::new(),
+        events: std::sync::Mutex::new(Vec::new()),
+    });
+    let mut extensions =
+        codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    extensions.turn_lifecycle_contributor(contributor.clone());
+    session.services.extensions = Arc::new(extensions.build());
+    let session = Arc::new(session);
+
+    let blocked_session = Arc::clone(&session);
+    let blocked_submission_id = blocked_turn_id.clone();
+    let blocked_task = tokio::spawn(async move {
+        handle(
+            &blocked_session,
+            TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "first guarded turn".to_string(),
+                text_elements: Vec::new(),
+            }])
+            .with_start_guard(Arc::new(CommitStartGuard)),
+            TurnInputMode::StartIfIdle,
+            blocked_submission_id,
+        )
+        .await
+    });
+    tokio::time::timeout(
+        std::time::Duration::from_secs(5),
+        contributor.blocked_start_entered.notified(),
+    )
+    .await
+    .expect("guarded turn should enter its blocked start contributor");
+
+    assert!(
+        session
+            .abort_turn_if_active(
+                &blocked_turn_id,
+                TurnAbortReason::Interrupted,
+                /*error*/ None,
+            )
+            .await
+    );
+    contributor.release_blocked_start.notify_one();
+    blocked_task
+        .await
+        .expect("guarded submission task should finish")
+        .expect("guarded submission should remain a typed result");
+
+    let replacement_turn_id = "replacement-guarded-turn".to_string();
+    let replacement = handle(
+        &session,
+        TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "replacement guarded turn".to_string(),
+            text_elements: Vec::new(),
+        }])
+        .with_start_guard(Arc::new(CommitStartGuard)),
+        TurnInputMode::StartIfIdle,
+        replacement_turn_id.clone(),
+    )
+    .await
+    .expect("replacement guarded submission should succeed");
+    assert!(matches!(
+        replacement,
+        TurnInputSubmission::Started { turn_id } if turn_id == replacement_turn_id
+    ));
+
+    let events = contributor.events.lock().expect("lifecycle events lock");
+    assert!(events.iter().any(|event| event == "blocked-abort"));
+    assert!(events.iter().any(|event| event == "replacement-start"));
+    assert!(
+        !events.iter().any(|event| event == "blocked-start-finished"),
+        "the old contributor must not mutate extension stores after abort and replacement"
+    );
+    drop(events);
+    session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+}
