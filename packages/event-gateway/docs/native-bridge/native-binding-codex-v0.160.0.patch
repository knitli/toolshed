+#[test]
+fn pending_write_retains_partial_bytes_on_backpressure() {
+    struct PausingWriter {
+        calls: usize,
+        bytes: Vec<u8>,
+    }
+    impl Write for PausingWriter {
+        fn write(&mut self, input: &[u8]) -> io::Result<usize> {
+            self.calls += 1;
+            if self.calls == 2 {
+                return Err(io::Error::from(io::ErrorKind::WouldBlock));
+            }
+            let count = if self.calls == 1 { 3 } else { input.len() };
+            self.bytes.extend_from_slice(&input[..count]);
+            Ok(count)
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+    let bytes = b"response-record\n".to_vec();
+    let mut pending = PendingWrite {
+        bytes: bytes.clone(),
+        offset: 0,
+        created: Instant::now(),
+    };
+    let mut writer = PausingWriter {
+        calls: 0,
+        bytes: Vec::new(),
+    };
+    assert!(!pending.flush(&mut writer).expect("partial write"));
+    assert!(
+        matches!(pending.flush(&mut writer), Ok(false)),
+        "temporary backpressure must retain pending response"
+    );
+    assert_eq!(pending.offset, 3);
+    assert!(pending.flush(&mut writer).expect("completed write"));
+    assert_eq!(
+        writer.bytes, bytes,
+        "partial response must be delivered exactly once"
+    );
+}
+
+#[test]
+fn write_failure_retains_exact_os_error() {
+    struct BrokenWriter;
+    impl Write for BrokenWriter {
+        fn write(&mut self, _: &[u8]) -> io::Result<usize> {
+            Err(io::Error::from_raw_os_error(libc::EPIPE))
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut pending = PendingWrite {
+        bytes: vec![1],
+        offset: 0,
+        created: Instant::now(),
+    };
+    let error = pending
+        .flush(&mut BrokenWriter)
+        .expect_err("permanent write error");
+    assert_eq!(
+        error.raw_os_error(),
+        Some(libc::EPIPE),
+        "diagnostics must retain exact errno"
+    );
+}
+
+#[test]
+fn expired_pending_response_closes_instead_of_renewing() {
+    use std::os::fd::IntoRawFd;
+    let (_parent, child) = UnixStream::pair().expect("private channel");
+    let mut transport =
+        Transport::from_inherited_fd(child.into_raw_fd()).expect("adopt capability");
+    transport.pending = Some(PendingWrite {
+        bytes: b"stale-response\n".to_vec(),
+        offset: 1,
+        created: Instant::now() - Duration::from_millis(/*millis*/ 750),
+    });
+    let mut witness = SelectionWitness {
+        transport: Some(transport),
+        state: SelectionState::new(),
+        last_poll: Instant::now(),
+        binding: NativeBinding::default(),
+        attempts: AttemptLedger::default(),
+    };
+    witness.state.connected(Some(123));
+    witness.state.select(Some(ThreadId::new()), true);
+    witness.emit("poll");
+    assert!(
+        witness.transport.is_none(),
+        "expired pending response must close capability"
+    );
+    assert!(!witness.state.eligible);
+}
diff --git a/codex-rs/tui/src/inherited_bridge.rs b/codex-rs/tui/src/inherited_bridge.rs
new file mode 100644
index 0000000..27654f6
--- /dev/null
+++ b/codex-rs/tui/src/inherited_bridge.rs
@@ -0,0 +1,212 @@
+//! Process-entry ownership for the private launcher/TUI socket capability.
+use std::ffi::OsString;
+use std::io;
+use std::os::fd::AsRawFd;
+use std::os::fd::FromRawFd;
+use std::os::unix::net::UnixStream;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+
+const NATIVE_FD: &str = "CODEX_NATIVE_BRIDGE_FD";
+const OBSERVATION_FD: &str = "CODEX_SELECTION_WITNESS_FD";
+
+#[derive(Default)]
+struct Adoption {
+    native: bool,
+    stream: Option<UnixStream>,
+}
+
+static ADOPTED: OnceLock<Mutex<Adoption>> = OnceLock::new();
+
+/// Keeps an unconsumed endpoint owned until startup returns or the TUI takes it.
+pub struct InheritedBridgeGuard {
+    owns_slot: bool,
+}
+
+impl Drop for InheritedBridgeGuard {
+    fn drop(&mut self) {
+        if self.owns_slot
+            && let Some(slot) = ADOPTED.get()
+            && let Ok(mut adopted) = slot.lock()
+        {
+            adopted.stream = None;
+        }
+    }
+}
+
+/// Adopt the actual inherited endpoint before bootstrap can start threads or children.
+///
+/// # Safety
+/// Call synchronously at process entry, before any other thread can read the process
+/// environment. The launcher transfers ownership of the named connected Unix socket.
+/// Embedders must retain the returned guard while running the TUI.
+pub unsafe fn adopt_inherited_bridge() -> io::Result<InheritedBridgeGuard> {
+    if ADOPTED.get().is_some() {
+        ensure_entry_adoption()?;
+        return Ok(InheritedBridgeGuard { owns_slot: false });
+    }
+    let native = std::env::var_os(NATIVE_FD);
+    let observation = std::env::var_os(OBSERVATION_FD);
+    // SAFETY: the caller guarantees process-entry, single-threaded environment access.
+    unsafe {
+        std::env::remove_var(NATIVE_FD);
+        std::env::remove_var(OBSERVATION_FD);
+    }
+    let mut adopted = Adoption {
+        native: native.is_some(),
+        stream: None,
+    };
+    let result = adopt_values(native, observation).map(|stream| adopted.stream = stream);
+    // Initialization runs before threads. Even an invalid capability stays consumed;
+    // a retry must never reinterpret its former numeric descriptor.
+    let _ = ADOPTED.set(Mutex::new(adopted));
+    result?;
+    Ok(InheritedBridgeGuard { owns_slot: true })
+}
+
+pub(crate) fn ensure_entry_adoption() -> io::Result<()> {
+    if std::env::var_os(NATIVE_FD).is_some() || std::env::var_os(OBSERVATION_FD).is_some() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "inherited bridge must be adopted before TUI bootstrap",
+        ));
+    }
+    Ok(())
+}
+
+pub(crate) fn take() -> (bool, Option<UnixStream>) {
+    let Some(slot) = ADOPTED.get() else {
+        return (false, None);
+    };
+    match slot.lock() {
+        Ok(mut adopted) => (adopted.native, adopted.stream.take()),
+        Err(_) => (false, None),
+    }
+}
+
+fn adopt_values(
+    native: Option<OsString>,
+    observation: Option<OsString>,
+) -> io::Result<Option<UnixStream>> {
+    let ambiguous = native.is_some() && observation.is_some();
+    let mut descriptors = Vec::new();
+    let mut invalid = false;
+    let mut first_error = None;
+    for value in [native, observation].into_iter().flatten() {
+        match value.to_str().and_then(|value| value.parse::<i32>().ok()) {
+            Some(fd) if fd >= 3 => {
+                if !descriptors.contains(&fd) {
+                    descriptors.push(fd);
+                }
+            }
+            _ => invalid = true,
+        }
+    }
+    let mut streams = Vec::new();
+    for fd in descriptors {
+        // SAFETY: process-entry caller transferred the named endpoints; numeric
+        // duplicates were removed before any ownership transfer.
+        match unsafe { adopt_fd(fd) } {
+            Ok(stream) => streams.push(stream),
+            Err(error) => {
+                invalid = true;
+                if first_error.is_none() {
+                    first_error = Some(error);
+                }
+            }
+        }
+    }
+    if invalid || ambiguous {
+        // Only validated transferred sockets are owned here; each distinct descriptor
+        // is dropped once. Never close stdio, invalid descriptors, or unrelated files.
+        return Err(first_error.unwrap_or_else(|| io::Error::from(io::ErrorKind::InvalidInput)));
+    }
+    Ok(streams.pop())
+}
+
+/// # Safety
+/// Any connected Unix socket accepted by validation must be uniquely transferred
+/// to this call. Descriptors rejected by validation remain owned by the caller.
+pub(crate) unsafe fn adopt_fd(fd: i32) -> io::Result<UnixStream> {
+    if fd < 3 {
+        return Err(io::Error::from(io::ErrorKind::InvalidInput));
+    }
+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFD) };
+    if flags == -1 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut socket_type: libc::c_int = 0;
+    let mut length = std::mem::size_of_val(&socket_type) as libc::socklen_t;
+    if unsafe {
+        libc::getsockopt(
+            fd,
+            libc::SOL_SOCKET,
+            libc::SO_TYPE,
+            (&mut socket_type as *mut libc::c_int).cast(),
+            &mut length,
+        )
+    } == -1
+    {
+        return Err(io::Error::last_os_error());
+    }
+    let mut address: libc::sockaddr_storage = unsafe { std::mem::zeroed() };
+    let mut address_length = std::mem::size_of_val(&address) as libc::socklen_t;
+    if socket_type != libc::SOCK_STREAM
+        || unsafe {
+            libc::getpeername(
+                fd,
+                (&mut address as *mut libc::sockaddr_storage).cast(),
+                &mut address_length,
+            )
+        } == -1
+        || i32::from(address.ss_family) != libc::AF_UNIX
+    {
+        return Err(io::Error::from(io::ErrorKind::InvalidInput));
+    }
+    validate_peer_uid(fd)?;
+    // SAFETY: validation established the launcher-transferred connected Unix socket;
+    // this is the sole ownership transfer, before any child process can be spawned.
+    let stream = unsafe { UnixStream::from_raw_fd(fd) };
+    if unsafe { libc::fcntl(stream.as_raw_fd(), libc::F_SETFD, flags | libc::FD_CLOEXEC) } == -1 {
+        return Err(io::Error::last_os_error());
+    }
+    stream.set_nonblocking(true)?;
+    Ok(stream)
+}
+
+fn validate_peer_uid(fd: i32) -> io::Result<()> {
+    #[cfg(target_os = "linux")]
+    let peer_uid = {
+        let mut credentials: libc::ucred = unsafe { std::mem::zeroed() };
+        let mut length = std::mem::size_of_val(&credentials) as libc::socklen_t;
+        if unsafe {
+            libc::getsockopt(
+                fd,
+                libc::SOL_SOCKET,
+                libc::SO_PEERCRED,
+                (&mut credentials as *mut libc::ucred).cast(),
+                &mut length,
+            )
+        } == -1
+        {
+            return Err(io::Error::last_os_error());
+        }
+        credentials.uid
+    };
+    #[cfg(target_os = "macos")]
+    let peer_uid = {
+        let mut uid = 0;
+        let mut gid = 0;
+        if unsafe { libc::getpeereid(fd, &mut uid, &mut gid) } == -1 {
+            return Err(io::Error::last_os_error());
+        }
+        uid
+    };
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    return Err(io::Error::from(io::ErrorKind::Unsupported));
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    if peer_uid != unsafe { libc::getuid() } {
+        return Err(io::Error::from(io::ErrorKind::PermissionDenied));
+    }
+    Ok(())
+}
