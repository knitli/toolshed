+#[tokio::test]
+async fn permit_deadline_keeps_initial_monotonic_anchor_across_preparation_delay() {
+    let mut params = request_params();
+    params.permit_issued_at = 10_000;
+    params.permit_expires_at = 15_000;
+
+    // Model the lookup/config awaits crossing expiry while realtime moves backwards.
+    let monotonic_at_validation = Instant::now() - Duration::from_secs(6);
+    let monotonic_after_preparation = Instant::now();
+    let clock_samples = Arc::new(Mutex::new(VecDeque::from([
+        (monotonic_at_validation, 10_000),
+        (monotonic_after_preparation, 4_000),
+    ])));
+    let clock_samples_for_call = Arc::clone(&clock_samples);
+    let clock = move || {
+        lock(&clock_samples_for_call)
+            .pop_front()
+            .expect("clock should only be sampled by the request preflight")
+    };
+    let (preparation_entered_tx, preparation_entered_rx) = oneshot::channel();
+    let (release_preparation_tx, release_preparation_rx) = oneshot::channel();
+    let preparation = async move {
+        preparation_entered_tx
+            .send(())
+            .expect("test should observe preparation start");
+        release_preparation_rx
+            .await
+            .expect("test should release preparation");
+        Ok(())
+    };
+    let pending = validate_permit_then(
+        params.permit_issued_at,
+        params.permit_expires_at,
+        clock,
+        preparation,
+    );
+    tokio::pin!(pending);
+
+    tokio::select! {
+        result = preparation_entered_rx => {
+            result.expect("preparation should start after the initial clock sample");
+        }
+        _ = &mut pending => panic!("preparation must remain pending until the test releases it"),
+    }
+    assert_eq!(
+        lock(&clock_samples).len(),
+        1,
+        "the absolute permit deadline must be fixed before async preparation"
+    );
+    release_preparation_tx
+        .send(())
+        .expect("test should release the preparation await");
+    let (permit_deadline, ()) = pending.await.expect("permit should validate initially");
+    assert!(permit_deadline <= Instant::now());
+
+    let (rolled_back_monotonic, rolled_back_wall_ms) = lock(&clock_samples)
+        .front()
+        .copied()
+        .expect("the later rollback sample should remain unused");
+    let incorrectly_rebased_deadline = rolled_back_monotonic
+        + Duration::from_millis(params.permit_expires_at.saturating_sub(rolled_back_wall_ms));
+    assert!(incorrectly_rebased_deadline > Instant::now());
+
+    let selection = Arc::new(Mutex::new(SelectionState {
+        generation: params.expected_generation,
+        thread_id: Some(params.thread_id.clone()),
+        ready: true,
+        expires_at: Some(Instant::now() + Duration::from_secs(10)),
+        closed: false,
+    }));
+    let receipts = Arc::new(Mutex::new(ReceiptStore::default()));
+    let guard = guard_for(&params, selection, Arc::clone(&receipts), permit_deadline);
+    let mut task_registered = false;
+    let mut commit = || task_registered = true;
+
+    assert_eq!(
+        guard.commit_start("expired-turn", &mut commit),
+        TurnStartGuardCommit::Rejected
+    );
+    assert!(!task_registered);
+    assert_eq!(
+        guard.rejection.get(),
+        Some(ThreadStartIfIdleNotStartedReason::PermitExpired)
+    );
+    assert!(lock(&receipts).by_delivery.is_empty());
+}
