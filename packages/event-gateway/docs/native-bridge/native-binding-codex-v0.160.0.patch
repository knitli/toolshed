+        let receipt = NativeReceipt {
+            server_instance_id: params.server_instance_id.clone(),
+            selection_generation: params.expected_generation,
+            attempt_id: params.attempt_id.clone(),
+            delivery_id: params.delivery_id.clone(),
+            thread_id: params.thread_id.clone(),
+            client_user_message_id: params.client_user_message_id.clone(),
+            permit_id: params.permit_id.clone(),
+            permit_issued_at: params.permit_issued_at,
+            permit_expires_at: params.permit_expires_at,
+            input: params.input.clone(),
+            turn_id: params.client_user_message_id.clone(),
