+use std::sync::Arc;
+use std::time::Instant;
+
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::WarningEvent;
+use codex_protocol::turn_input::TurnStartGuard;
+use codex_protocol::turn_input::TurnStartGuardCommit;
+use tokio::sync::Mutex;
+use tokio::sync::Notify;
+use tokio::sync::oneshot;
+use tokio_util::sync::CancellationToken;
+use tokio_util::task::AbortOnDropHandle;
+use tracing::Instrument;
+use tracing::field;
+use tracing::info_span;
+use tracing::trace_span;
+use tracing::warn;
+
+use super::ACTIVE_TURNS;
+use super::AnySessionTask;
+use super::SessionTask;
+use crate::session::TurnInput;
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use crate::state::RunningTask;
+use crate::state::TurnState;
+use codex_otel::TURN_E2E_DURATION_METRIC;
+
+impl Session {
+    /// Registers a host-fenced turn before running post-registration preparation.
+    ///
+    /// The guard commits the stable receipt and the active-turn registration under one
+    /// synchronous critical section. Lifecycle contributors still run before the regular task
+    /// executes, though this guarded path registers the dormant task first.
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "native receipt commit and active turn registration must remain atomic"
+    )]
+    pub(crate) async fn start_task_guarded<T: SessionTask>(
+        self: &Arc<Self>,
+        turn_context: Arc<TurnContext>,
+        input: Vec<TurnInput>,
+        task: T,
+        start_guard: Arc<dyn TurnStartGuard>,
+    ) -> TurnStartGuardCommit {
+        turn_context
+            .turn_metadata_state
+            .set_root_turn_id(turn_context.sub_id.clone());
+        let task: Arc<dyn AnySessionTask> = Arc::new(task);
+        let task_kind = task.kind();
+        let span_name = task.span_name();
+        let token_usage_at_turn_start = self.total_token_usage().await.unwrap_or_default();
+        let done = Arc::new(Notify::new());
+        let cancellation_token = CancellationToken::new();
+        let task_span = info_span!(
+            "turn",
+            otel.name = span_name,
+            thread.id = %self.thread_id,
+            turn.id = %turn_context.sub_id,
+            model = %turn_context.model_info().slug,
+            codex.turn.reasoning_effort = %turn_context.effective_reasoning_effort_for_tracing(),
+            codex.turn.token_usage.input_tokens = field::Empty,
+            codex.turn.token_usage.cached_input_tokens = field::Empty,
+            codex.turn.token_usage.cache_write_input_tokens = field::Empty,
+            codex.turn.token_usage.non_cached_input_tokens = field::Empty,
+            codex.turn.token_usage.output_tokens = field::Empty,
+            codex.turn.token_usage.reasoning_output_tokens = field::Empty,
+            codex.turn.token_usage.total_tokens = field::Empty,
+        );
+
+        let mut active = self.active_turn.lock().await;
+        let Some(active_turn) = active.as_mut() else {
+            return TurnStartGuardCommit::Rejected;
+        };
+        if active_turn.task.is_some() {
+            return TurnStartGuardCommit::Rejected;
+        }
+        let turn_state_arc = Arc::clone(&active_turn.turn_state);
+        let mut session_state = self.lock_session_state().await;
+        let mut turn_state = turn_state_arc.lock().await;
+        let mut start_tx = None;
+        let mut task_input = Some(input);
+        let mut commit = || {
+            let Some(task_input) = task_input.take() else {
+                return;
+            };
+            session_state.last_started_turn_id = Some(turn_context.sub_id.clone());
+            turn_state.token_usage_at_turn_start = token_usage_at_turn_start.clone();
+            let (ready_tx, ready_rx) = oneshot::channel();
+            let done_clone = Arc::clone(&done);
+            let session = Arc::clone(self);
+            let ctx = Arc::clone(&turn_context);
+            let task_for_run = Arc::clone(&task);
+            let task_cancellation_token = cancellation_token.child_token();
+            let handle = tokio::spawn(
+                async move {
+                    if ready_rx.await.is_err() {
+                        done_clone.notify_one();
+                        return;
+                    }
+                    let ctx_for_finish = Arc::clone(&ctx);
+                    let task_result = task_for_run
+                        .run(
+                            Arc::clone(&session),
+                            ctx,
+                            task_input,
+                            task_cancellation_token.child_token(),
+                        )
+                        .instrument(trace_span!("session_task.run"))
+                        .await;
+                    if (!session.is_private_guardian_reviewer().await
+                        || task_cancellation_token.is_cancelled()
+                        || task_result.is_err())
+                        && let Err(err) = session.flush_rollout().await
+                    {
+                        warn!("failed to flush rollout before completing turn: {err}");
+                        session
+                            .send_event(
+                                ctx_for_finish.as_ref(),
+                                EventMsg::Warning(WarningEvent {
+                                    message: format!(
+                                        "Failed to save the conversation transcript; Codex will continue retrying. Error: {err}"
+                                    ),
+                                }),
+                            )
+                            .await;
+                    }
+                    if !task_cancellation_token.is_cancelled() {
+                        session
+                            .on_task_finished(Arc::clone(&ctx_for_finish), task_result)
+                            .await;
+                    }
+                    done_clone.notify_waiters();
+                }
+                .instrument(task_span.clone()),
+            );
+            let agent_execution_guard = self.services.agent_control.admit_turn(
+                turn_context.multi_agent_version,
+                &turn_context.session_source,
+            );
+            let running_task = RunningTask {
+                done: Arc::clone(&done),
+                handle: AbortOnDropHandle::new(handle),
+                kind: task_kind,
+                task: Arc::clone(&task),
+                cancellation_token: cancellation_token.clone(),
+                turn_context: Arc::clone(&turn_context),
+                _agent_execution_guard: agent_execution_guard,
+                _diagnostics_guard: ACTIVE_TURNS.track(),
+                _timer: turn_context
+                    .session_telemetry
+                    .start_timer(TURN_E2E_DURATION_METRIC, &[])
+                    .ok(),
+            };
+            active_turn.task = Some(running_task);
+            start_tx = Some(ready_tx);
+        };
+        let result = start_guard.commit_start(&turn_context.sub_id, &mut commit);
+        drop(turn_state);
+        drop(session_state);
+        drop(active);
+        if result != TurnStartGuardCommit::Committed {
+            return result;
+        }
+
+        let Some(start_tx) = start_tx else {
+            return TurnStartGuardCommit::Rejected;
+        };
+        let session = Arc::clone(self);
+        let turn_context_for_prep = Arc::clone(&turn_context);
+        let turn_state_for_prep = Arc::clone(&turn_state_arc);
+        let preparation_cancellation_token = cancellation_token.clone();
+        let (prepared_tx, prepared_rx) = oneshot::channel();
+        tokio::spawn(async move {
+            tokio::select! {
+                biased;
+                _ = preparation_cancellation_token.cancelled() => {}
+                _ = session.activate_plugin_selection(&turn_context_for_prep) => {}
+            }
+            if !preparation_cancellation_token.is_cancelled() {
+                let started_at = Instant::now();
+                let started_at_unix_ms = turn_context_for_prep
+                    .turn_timing_state
+                    .mark_turn_started(started_at)
+                    .await;
+                turn_context_for_prep
+                    .turn_metadata_state
+                    .set_turn_started_at_unix_ms(started_at_unix_ms);
+                session
+                    .maybe_emit_model_warnings_for_turn(turn_context_for_prep.as_ref())
+                    .await;
+                session
+                    .prepare_guarded_turn_inputs(
+                        turn_context_for_prep.as_ref(),
+                        turn_state_for_prep.as_ref(),
+                    )
+                    .await;
+            }
+            if !preparation_cancellation_token.is_cancelled() {
+                tokio::select! {
+                    biased;
+                    _ = preparation_cancellation_token.cancelled() => {}
+                    _ = session.emit_turn_start_lifecycle(
+                        turn_context_for_prep.as_ref(),
+                        Some(&token_usage_at_turn_start),
+                        codex_extension_api::TurnStartPhase::BeforeTaskRegistration,
+                    ) => {}
+                }
+            }
+            if !preparation_cancellation_token.is_cancelled() {
+                let _ = start_tx.send(());
+            }
+            let _ = prepared_tx.send(());
+        });
+        let _ = prepared_rx.await;
+        TurnStartGuardCommit::Committed
+    }
+
+    /// Applies session-wide preparation only while this guarded task still owns the active turn.
+    /// Holding `active_turn` across the mailbox transfer makes abort/replacement serialize after
+    /// the transfer, so old preparation can never append mail to a later turn.
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "abort and replacement must serialize with guarded turn mailbox transfer"
+    )]
+    async fn prepare_guarded_turn_inputs(
+        &self,
+        turn_context: &TurnContext,
+        turn_state: &Mutex<TurnState>,
+    ) -> bool {
+        let active_turn = self.active_turn.lock().await;
+        let Some(active_turn) = active_turn.as_ref() else {
+            return false;
+        };
+        let Some(task) = active_turn.task.as_ref() else {
+            return false;
+        };
+        if task.turn_context.sub_id != turn_context.sub_id || task.cancellation_token.is_cancelled()
+        {
+            return false;
+        }
+
+        let mut state = self.lock_session_state().await;
+        if task.cancellation_token.is_cancelled() {
+            return false;
+        }
+        state.clear_connector_selection();
+        drop(state);
+
+        if task.cancellation_token.is_cancelled() {
+            return false;
+        }
+        let (pending_items, _) = self.input_queue.drain_mailbox_input_items().await;
+        self.input_queue
+            .extend_pending_input_for_turn_state(turn_state, pending_items)
+            .await;
+        true
+    }
+}
diff --git a/codex-rs/tui/src/app/selection_adoption_tests.rs b/codex-rs/tui/src/app/selection_adoption_tests.rs
new file mode 100644
index 0000000..254c51f
--- /dev/null
+++ b/codex-rs/tui/src/app/selection_adoption_tests.rs
@@ -0,0 +1,274 @@
+use super::*;
+use std::os::fd::FromRawFd;
+use std::os::fd::OwnedFd;
+use std::process::Command;
+use std::process::Stdio;
+
+const FIXTURE: &str = "CODEX_BRIDGE_ADOPTION_FIXTURE";
+const RAW: &str = "CODEX_BRIDGE_ADOPTION_RAW";
+const NATIVE: &str = "CODEX_NATIVE_BRIDGE_FD";
+const OBSERVATION: &str = "CODEX_SELECTION_WITNESS_FD";
+const PROBE: &str = r#"
+import errno, json, os, subprocess, sys
+fd = int(sys.argv[2])
+try:
+    os.fstat(fd)
+    present = True
+except OSError as error:
+    if error.errno != errno.EBADF:
+        raise
+    present = False
+result = dict(fd=present, native=os.getenv('CODEX_NATIVE_BRIDGE_FD'), observation=os.getenv('CODEX_SELECTION_WITNESS_FD'))
+if len(sys.argv) == 3:
+    child = subprocess.run([sys.executable, '-c', sys.argv[1], sys.argv[1], str(fd), 'child'], close_fds=False, capture_output=True, text=True, check=True)
+    result['descendant'] = json.loads(child.stdout)
+print(json.dumps(result))
+"#;
+
+fn duplicate_inheritable(fd: i32) -> OwnedFd {
+    let raw = unsafe { libc::fcntl(fd, libc::F_DUPFD, 200) };
+    assert!(raw >= 200);
+    // SAFETY: F_DUPFD created a unique descriptor owned by this fixture.
+    unsafe { OwnedFd::from_raw_fd(raw) }
+}
+
+fn probe(raw: i32, descendants: bool) -> serde_json::Value {
+    let mut command = Command::new("python3");
+    // argv[1] carries the same probe source to the descendant without a file.
+    command.args(["-c", PROBE, PROBE, &raw.to_string()]);
+    if !descendants {
+        command.arg("control");
+    }
+    let output = command.output().unwrap();
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    serde_json::from_slice(&output.stdout).unwrap()
+}
+
+fn fixture(name: &str, mode: &str, child: impl FnOnce(i32)) {
+    if std::env::var_os(FIXTURE).is_some() {
+        child(std::env::var(RAW).unwrap().parse().unwrap());
+        return;
+    }
+    let (mut parent, endpoint) = UnixStream::pair().unwrap();
+    let inherited = duplicate_inheritable(endpoint.as_raw_fd());
+    drop(endpoint);
+    let raw = inherited.as_raw_fd();
+    assert_eq!(
+        probe(raw, false)["fd"],
+        true,
+        "control exec must inherit the original descriptor"
+    );
+    let secondary = if mode == "distinct" {
+        let (parent, endpoint) = UnixStream::pair().unwrap();
+        Some((parent, duplicate_inheritable(endpoint.as_raw_fd())))
+    } else {
+        None
+    };
+    let mut command = Command::new(std::env::current_exe().unwrap());
+    command
+        .args([
+            "--exact",
+            &format!("app::selection_witness::adoption_tests::{name}"),
+            "--nocapture",
+            "--test-threads=1",
+        ])
+        .env(FIXTURE, mode)
+        .env(RAW, raw.to_string())
+        .env_remove(NATIVE)
+        .env_remove(OBSERVATION)
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped());
+    match mode {
+        "native" | "drop" => {
+            command.env(NATIVE, raw.to_string());
+        }
+        "observation" => {
+            command.env(OBSERVATION, raw.to_string());
+        }
+        "same" => {
+            command
+                .env(NATIVE, raw.to_string())
+                .env(OBSERVATION, format!("0{raw}"));
+        }
+        "distinct" => {
+            let secondary_fd = secondary.as_ref().unwrap().1.as_raw_fd();
+            command
+                .env(NATIVE, raw.to_string())
+                .env(OBSERVATION, secondary_fd.to_string())
+                .env("CODEX_BRIDGE_ADOPTION_SECONDARY", secondary_fd.to_string());
+        }
+        _ => unreachable!(),
+    }
+    parent
+        .set_read_timeout(Some(Duration::from_secs(2)))
+        .unwrap();
+    parent.write_all(b"{\"nonce\":1}\n").unwrap();
+    let process = command.spawn().unwrap();
+    drop(inherited);
+    let output = process.wait_with_output().unwrap();
+    drop(secondary);
+    assert!(
+        output.status.success(),
+        "{}\n{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+    if matches!(mode, "native" | "observation") {
+        let mut response = String::new();
+        parent.read_to_string(&mut response).unwrap();
+        let row: serde_json::Value = serde_json::from_str(&response).unwrap();
+        assert_eq!(
+            row["nonce"], 1,
+            "TUI must consume the original endpoint without losing its challenge"
+        );
+        assert_eq!(row["version"], if mode == "native" { 2 } else { 1 });
+    }
+}
+
+#[test]
+fn early_adoption_excludes_exec_children_and_hands_off_once() {
+    let modes: Vec<_> = std::env::var(FIXTURE).ok().into_iter().collect();
+    let modes = if modes.is_empty() {
+        vec!["native".to_owned(), "observation".to_owned()]
+    } else {
+        modes
+    };
+    for mode in modes {
+        fixture(
+            "early_adoption_excludes_exec_children_and_hands_off_once",
+            &mode,
+            |raw| {
+                // SAFETY: this isolated single-test subprocess has no application threads
+                // or concurrent tests accessing the environment.
+                let guard = unsafe { crate::adopt_inherited_bridge() }.unwrap();
+                let child = probe(raw, true);
+                for observation in [&child, &child["descendant"]] {
+                    assert_eq!(
+                        observation["fd"], false,
+                        "exec descendants must not inherit the bridge descriptor before TUI startup"
+                    );
+                    assert!(
+                        observation["native"].is_null() && observation["observation"].is_null(),
+                        "exec descendants must not inherit stale bridge environment markers"
+                    );
+                }
+                // Repeated initialization must not take a second ownership or clear the slot.
+                drop(unsafe { crate::adopt_inherited_bridge() }.unwrap());
+                let mut witness = SelectionWitness::from_adopted();
+                assert!(
+                    witness.transport.is_some(),
+                    "TUI must receive the retained original endpoint"
+                );
+                assert!(
+                    SelectionWitness::from_adopted().transport.is_none(),
+                    "the retained endpoint must be consumed once"
+                );
+                // SAFETY: only this isolated test accesses its process environment;
+                // the probe children have exited and no application threads exist.
+                unsafe { std::env::set_var(NATIVE, raw.to_string()) };
+                assert!(
+                    crate::inherited_bridge::ensure_entry_adoption().is_err(),
+                    "library bootstrap must reject any leftover bridge marker"
+                );
+                assert!(
+                    unsafe { crate::adopt_inherited_bridge() }.is_err(),
+                    "repeated adoption must reject a newly introduced marker"
+                );
+                // SAFETY: same isolated fixture, restoring the post-adoption environment.
+                unsafe { std::env::remove_var(NATIVE) };
+                drop(guard);
+                witness.emit("entry-handoff");
+            },
+        );
+    }
+}
+
+#[test]
+fn ambiguous_entry_adoption_closes_once_and_never_reopens_a_reused_fd() {
+    let modes: Vec<_> = std::env::var(FIXTURE).ok().into_iter().collect();
+    let modes = if modes.is_empty() {
+        vec!["same".to_owned(), "distinct".to_owned()]
+    } else {
+        modes
+    };
+    for mode in modes {
+        fixture(
+            "ambiguous_entry_adoption_closes_once_and_never_reopens_a_reused_fd",
+            &mode,
+            |raw| {
+                // SAFETY: isolated single-test subprocess; no concurrent environment readers.
+                assert!(
+                    unsafe { crate::adopt_inherited_bridge() }.is_err(),
+                    "two bridge modes must fail closed"
+                );
+                assert_eq!(
+                    unsafe { libc::fcntl(raw, libc::F_GETFD) },
+                    -1,
+                    "ambiguous transferred endpoint must be closed"
+                );
+                if let Ok(secondary) = std::env::var("CODEX_BRIDGE_ADOPTION_SECONDARY") {
+                    let secondary: i32 = secondary.parse().unwrap();
+                    assert_eq!(
+                        unsafe { libc::fcntl(secondary, libc::F_GETFD) },
+                        -1,
+                        "unused secondary endpoint must be closed"
+                    );
+                }
+                let replacement = tempfile::tempfile().unwrap();
+                assert_eq!(unsafe { libc::dup2(replacement.as_raw_fd(), raw) }, raw);
+                // SAFETY: dup2 created the replacement owned by this test, not by adoption.
+                let replacement = unsafe { OwnedFd::from_raw_fd(raw) };
+                drop(unsafe { crate::adopt_inherited_bridge() }.unwrap());
+                assert!(SelectionWitness::from_adopted().transport.is_none());
+                assert_ne!(
+                    unsafe { libc::fcntl(replacement.as_raw_fd(), libc::F_GETFD) },
+                    -1,
+                    "repeated adoption must not close a reused descriptor"
+                );
+            },
+        );
+    }
+}
+
+#[test]
+fn early_startup_failure_drops_the_unconsumed_endpoint() {
+    fixture(
+        "early_startup_failure_drops_the_unconsumed_endpoint",
+        "drop",
+        |raw| {
+            // SAFETY: isolated single-test subprocess; no concurrent environment readers.
+            let guard = unsafe { crate::adopt_inherited_bridge() }.unwrap();
+            drop(guard);
+            assert_eq!(
+                unsafe { libc::fcntl(raw, libc::F_GETFD) },
+                -1,
+                "startup failure must close the unconsumed bridge endpoint"
+            );
+            assert!(SelectionWitness::from_adopted().transport.is_none());
+        },
+    );
+}
+
+#[test]
+fn invalid_descriptors_are_not_owned_or_closed() {
+    // Keep the invalid-close regression observable as an assertion rather than an
+    // IO-safety abort while unwinding a mistakenly closed File.
+    let file = std::mem::ManuallyDrop::new(tempfile::tempfile().unwrap());
+    let fd = file.as_raw_fd();
+    // SAFETY: this non-socket file cannot pass socket validation or transfer ownership.
+    assert!(unsafe { crate::inherited_bridge::adopt_fd(fd) }.is_err());
+    assert_ne!(
+        unsafe { libc::fcntl(fd, libc::F_GETFD) },
+        -1,
+        "invalid non-socket descriptor must not be closed"
+    );
+    drop(std::mem::ManuallyDrop::into_inner(file));
+    for fd in [0, 1, 2, -1] {
+        // SAFETY: stdio and negative descriptors are rejected before ownership.
+        assert!(unsafe { crate::inherited_bridge::adopt_fd(fd) }.is_err());
+    }
+}
diff --git a/codex-rs/tui/src/app/selection_binding.rs b/codex-rs/tui/src/app/selection_binding.rs
new file mode 100644
index 0000000..fe235fd
--- /dev/null
+++ b/codex-rs/tui/src/app/selection_binding.rs
@@ -0,0 +1,186 @@
+//! Native selection RPCs are sent only through this TUI's existing app-server handle.
+use super::*;
+use codex_app_server_protocol::ClientSelectionUpdateParams;
+use codex_app_server_protocol::ClientSelectionUpdateResponse;
+use codex_app_server_protocol::ClientSelectionUpdateStatus;
+
+#[derive(Default)]
+pub(super) struct NativeBinding {
+    pub(super) enabled: bool,
+    pub(super) response: Option<ClientSelectionUpdateResponse>,
+    pub(super) sent_at: Option<Instant>,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct BindingView<'a> {
+    server_instance_id: Option<&'a str>,
+    server_generation: Option<u64>,
+    lease_ms: Option<u64>,
+}
+
+impl NativeBinding {
+    pub(super) fn view(&self) -> Option<BindingView<'_>> {
+        self.enabled.then(|| BindingView {
+            server_instance_id: self
+                .response
+                .as_ref()
+                .map(|response| response.server_instance_id.as_str()),
+            server_generation: self.response.as_ref().map(|response| response.generation),
+            lease_ms: self.response.as_ref().map(|response| response.lease_ms),
+        })
+    }
+
+    pub(super) fn matches(&self, thread: Option<ThreadId>) -> bool {
+        self.response.as_ref().is_some_and(|response| {
+            response.status == ClientSelectionUpdateStatus::Updated
+                && response.ready
+                && response.thread_id == thread.map(|id| id.to_string())
+                && self.sent_at.is_some_and(|sent| {
+                    sent.elapsed() < Duration::from_millis(response.lease_ms.min(750))
+                })
+        })
+    }
+
+    async fn update(
+        &mut self,
+        server: &AppServerSession,
+        thread: Option<ThreadId>,
+    ) -> color_eyre::eyre::Result<()> {
+        let expected_generation = self
+            .response
+            .as_ref()
+            .map_or(0, |response| response.generation);
+        let requested_thread = thread.map(|id| id.to_string());
+        let request = codex_app_server_protocol::ClientRequest::ClientSelectionUpdate {
+            request_id: codex_app_server_protocol::RequestId::String(format!(
+                "selection-update-{}",
+                Uuid::new_v4()
+            )),
+            params: ClientSelectionUpdateParams {
+                expected_generation,
+                thread_id: requested_thread.clone(),
+                ready: thread.is_some(),
+            },
+        };
+        let sent_at = Instant::now();
+        let handle = server.request_handle();
+        let response: ClientSelectionUpdateResponse = tokio::time::timeout(
+            Duration::from_millis(/*millis*/ 750),
+            handle.request_typed(request),
+        )
+        .await
+        .map_err(|_| color_eyre::eyre::eyre!("native selection acknowledgment timed out"))?
+        .map_err(|_| color_eyre::eyre::eyre!("native selection acknowledgment unavailable"))?;
+        if Uuid::parse_str(&response.server_instance_id).is_err()
+            || self
+                .response
+                .as_ref()
+                .is_some_and(|old| old.server_instance_id != response.server_instance_id)
+            || (response.status == ClientSelectionUpdateStatus::Updated
+                && (response.thread_id != requested_thread || response.ready != thread.is_some()))
+            || response.lease_ms == 0
+        {
+            color_eyre::eyre::bail!("invalid native selection acknowledgment");
+        }
+        self.response = Some(response);
+        // Using request-send time is conservative if the acknowledgment was delayed.
+        self.sent_at = Some(sent_at);
+        Ok(())
+    }
+}
+
+impl SelectionWitness {
+    pub(in crate::app) async fn revoke_ack(
+        &mut self,
+        server: &AppServerSession,
+        cause: &'static str,
+    ) -> color_eyre::eyre::Result<()> {
+        self.revoke(cause);
+        if !self.binding.enabled {
+            return Ok(());
+        }
+        if self
+            .binding
+            .response
+            .as_ref()
+            .is_some_and(|response| !response.ready && response.thread_id.is_none())
+        {
+            return Ok(());
+        }
+        // A stale generation may report the expired, already-cleared binding. Otherwise
+        // retry only the revoke against the returned generation; never retry an event start.
+        for _ in 0..2 {
+            if let Err(error) = self.binding.update(server, None).await {
+                self.transport = None;
+                return Err(error);
+            }
+            if self
+                .binding
+                .response
+                .as_ref()
+                .is_some_and(|response| !response.ready && response.thread_id.is_none())
+            {
+                return Ok(());
+            }
+        }
+        self.transport = None;
+        color_eyre::eyre::bail!("native selection revoke was not acknowledged")
+    }
+
+    pub(in crate::app) async fn sync_selection(
+        &mut self,
+        server: &AppServerSession,
+        thread: Option<ThreadId>,
+        ready: bool,
+    ) -> color_eyre::eyre::Result<()> {
+        if !self.binding.enabled {
+            self.publish(thread, ready);
+            return Ok(());
+        }
+        let ready = ready && thread.is_some() && self.transport.is_some();
+        let gap = self.last_poll.elapsed() >= Duration::from_millis(/*millis*/ 750);
+        let wrong_or_expired = self
+            .binding
+            .response
+            .as_ref()
+            .is_some_and(|response| response.ready)
+            && !self.binding.matches(thread);
+        if !ready || gap || wrong_or_expired {
+            self.revoke_ack(server, "native-revoke").await?;
+        }
+        if ready {
+            let renew = !self.binding.matches(thread)
+                || self.binding.sent_at.is_none_or(|sent| {
+                    sent.elapsed() >= Duration::from_millis(/*millis*/ 250)
+                });
+            if renew {
+                if !self.binding.matches(thread) {
+                    self.revoke("native-update");
+                }
+                if let Err(error) = self.binding.update(server, thread).await {
+                    self.transport = None;
+                    return Err(error);
+                }
+            }
+        }
+        self.publish(thread, ready && self.binding.matches(thread));
+        Ok(())
+    }
+
+    pub(super) async fn bind_connection(
+        &mut self,
+        server: &AppServerSession,
+    ) -> color_eyre::eyre::Result<()> {
+        self.binding.response = None;
+        self.binding.sent_at = None;
+        if self.binding.enabled && self.transport.is_some() {
+            self.revoke_ack(server, "native-connect").await?;
+        }
+        Ok(())
+    }
+}
+
