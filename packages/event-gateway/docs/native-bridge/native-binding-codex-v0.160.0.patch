+                    if selection_state.closed {
+                        return Err(ThreadStartIfIdleNotStartedReason::ConnectionClosed);
+                    }
+                    if selection_state.generation != params.expected_generation
+                        || selection_state.thread_id.as_deref() != Some(params.thread_id.as_str())
+                        || !selection_state.ready
+                    {
+                        return Err(ThreadStartIfIdleNotStartedReason::SelectionChanged);
+                    }
+                    if selection_state
+                        .expires_at
+                        .is_none_or(|expires_at| expires_at <= Instant::now())
+                    {
+                        return Err(ThreadStartIfIdleNotStartedReason::SelectionExpired);
+                    }
+                }
