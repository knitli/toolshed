+//! Unix-only private launcher/TUI observation capability, not daemon or execution authority.
+//! Only the UI loop answers challenges; hostile same-user processes are out of scope.
+
+use super::*;
+use serde::Serialize;
+use std::io::Read;
+use std::io::Write;
+use std::io::{self};
+#[cfg(test)]
+use std::os::fd::AsRawFd;
+use std::os::unix::net::UnixStream;
+use uuid::Uuid;
+
+#[path = "selection_binding.rs"]
+mod binding;
+use binding::NativeBinding;
+#[path = "selection_bridge.rs"]
+mod bridge;
+use bridge::AttemptLedger;
+use bridge::BridgeEvent;
+use bridge::Operation;
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct SelectionState {
+    client_id: Uuid,
+    backend_pid: Option<u32>,
+    connection_id: Option<Uuid>,
+    thread_id: Option<ThreadId>,
+    generation: u64,
+    eligible: bool,
+    sequence: u64,
+    cause: &'static str,
+}
+
+impl SelectionState {
+    fn new() -> Self {
+        Self {
+            client_id: Uuid::new_v4(),
+            backend_pid: None,
+            connection_id: None,
+            thread_id: None,
+            generation: 0,
+            eligible: false,
+            sequence: 0,
+            cause: "startup",
+        }
+    }
+
+    fn select(&mut self, thread: Option<ThreadId>, ready: bool) -> bool {
+        let eligible = ready && thread.is_some() && self.backend_pid.is_some();
+        if self.thread_id == thread && self.eligible == eligible {
+            return false;
+        }
+        self.generation += 1;
+        self.thread_id = thread;
+        self.eligible = eligible;
+        true
+    }
+
+    fn expire_after_loop_gap(&mut self, elapsed: Duration) -> bool {
+        if elapsed >= Duration::from_millis(/*millis*/ 750) {
+            return self.select(self.thread_id, false);
+        }
+        false
+    }
+
+    fn connected(&mut self, pid: Option<u32>) {
+        self.generation += 1;
+        self.backend_pid = pid;
+        self.connection_id = Some(Uuid::new_v4());
+        self.eligible = false;
+    }
+}
+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Challenge {
+    nonce: u64,
+    #[serde(default)]
+    start: Option<BridgeEvent>,
+    #[serde(default)]
+    receipt: Option<BridgeEvent>,
+}
+
+#[derive(Serialize)]
+struct Response<'a> {
+    version: u8,
+    nonce: u64,
+    #[serde(flatten)]
+    selection: &'a SelectionState,
+    #[serde(flatten)]
+    binding: Option<binding::BindingView<'a>>,
+}
+
+struct PendingWrite {
+    bytes: Vec<u8>,
+    offset: usize,
+    created: Instant,
+}
+
+impl PendingWrite {
+    fn flush(&mut self, writer: &mut impl Write) -> io::Result<bool> {
+        match writer.write(&self.bytes[self.offset..]) {
+            Ok(0) => Err(io::Error::from(io::ErrorKind::WriteZero)),
+            Ok(count) => {
+                self.offset += count;
+                Ok(self.offset == self.bytes.len())
+            }
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    io::ErrorKind::WouldBlock | io::ErrorKind::Interrupted
+                ) =>
+            {
+                Ok(false)
+            }
+            Err(error) => Err(error),
+        }
+    }
+}
+
+struct TransportFailure {
+    stage: &'static str,
+    error: io::Error,
+}
+
+struct Transport {
+    stream: UnixStream,
+    input: Vec<u8>,
+    pending: Option<PendingWrite>,
+    last_nonce: u64,
+    operation: Option<(u64, Operation)>,
+}
+
+impl Transport {
+    #[cfg(test)]
+    fn from_inherited_fd(fd: i32) -> io::Result<Self> {
+        // SAFETY: fixtures transfer their unique endpoint with into_raw_fd().
+        Ok(Self::from_stream(unsafe {
+            crate::inherited_bridge::adopt_fd(fd)?
+        }))
+    }
+
+    fn from_stream(stream: UnixStream) -> Self {
+        Self {
+            stream,
+            input: Vec::new(),
+            pending: None,
+            last_nonce: 0,
+            operation: None,
+        }
+    }
+
+    fn poll(
+        &mut self,
+        state: &mut SelectionState,
+        binding: Option<binding::BindingView<'_>>,
+    ) -> Result<(), TransportFailure> {
+        if let Some(pending) = self.pending.as_mut() {
+            if pending.created.elapsed() >= Duration::from_millis(/*millis*/ 750) {
+                return Err(TransportFailure {
+                    stage: "write-deadline",
+                    error: io::Error::from(io::ErrorKind::TimedOut),
+                });
+            }
+            if !pending
+                .flush(&mut self.stream)
+                .map_err(|error| TransportFailure {
+                    stage: "write",
+                    error,
+                })?
+            {
+                return Ok(());
+            }
+            self.pending = None;
+        }
+        if self.operation.is_some() {
+            return Ok(());
+        }
+        let limit = if binding.is_some() { 4096 } else { 128 };
+        let mut chunk = [0u8; 4096];
+        let count = match self.stream.read(&mut chunk) {
+            Ok(0) => {
+                return Err(TransportFailure {
+                    stage: "read",
+                    error: io::Error::from(io::ErrorKind::UnexpectedEof),
+                });
+            }
+            Ok(count) => count,
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    io::ErrorKind::WouldBlock | io::ErrorKind::Interrupted
+                ) =>
+            {
+                return Ok(());
+            }
+            Err(error) => {
+                return Err(TransportFailure {
+                    stage: "read",
+                    error,
+                });
+            }
+        };
+        self.input.extend_from_slice(&chunk[..count]);
+        let newline = self.input.iter().position(|byte| *byte == b'\n');
+        if self.input.len() > limit
+            || newline.is_some_and(|index| index + 1 != self.input.len())
+            || (self.input.len() == limit && newline.is_none())
+        {
+            return Err(TransportFailure {
+                stage: "challenge-size",
+                error: io::Error::from(io::ErrorKind::InvalidData),
+            });
+        }
+        if newline.is_none() {
+            return Ok(());
+        }
+        let challenge: Challenge =
+            serde_json::from_slice(&self.input).map_err(|_| TransportFailure {
+                stage: "challenge-json",
+                error: io::Error::from(io::ErrorKind::InvalidData),
+            })?;
+        self.input.clear();
+        if challenge.nonce <= self.last_nonce {
+            return Err(TransportFailure {
+                stage: "challenge-nonce",
+                error: io::Error::from(io::ErrorKind::InvalidData),
+            });
+        }
+        self.last_nonce = challenge.nonce;
+        match (challenge.start, challenge.receipt) {
+            (None, None) => {}
+            (Some(event), None) if binding.is_some() => {
+                self.operation = Some((challenge.nonce, Operation::Start(event)));
+                return Ok(());
+            }
+            (None, Some(event)) if binding.is_some() => {
+                self.operation = Some((challenge.nonce, Operation::Receipt(event)));
+                return Ok(());
+            }
+            _ => {
+                return Err(TransportFailure {
+                    stage: "challenge-operation",
+                    error: io::Error::from(io::ErrorKind::InvalidData),
+                });
+            }
+        }
+        state.sequence += 1;
+        let mut bytes = serde_json::to_vec(&Response {
+            version: if binding.is_some() { 2 } else { 1 },
+            nonce: challenge.nonce,
+            selection: state,
+            binding,
+        })
+        .map_err(|_| TransportFailure {
+            stage: "serialize",
+            error: io::Error::from(io::ErrorKind::InvalidData),
+        })?;
+        bytes.push(b'\n');
+        if bytes.len() > 2048 {
+            return Err(TransportFailure {
+                stage: "response-size",
+                error: io::Error::from(io::ErrorKind::InvalidData),
+            });
+        }
+        let mut pending = PendingWrite {
+            bytes,
+            offset: 0,
+            created: Instant::now(),
+        };
+        if !pending
+            .flush(&mut self.stream)
+            .map_err(|error| TransportFailure {
+                stage: "write",
+                error,
+            })?
+        {
+            self.pending = Some(pending);
+        }
+        Ok(())
+    }
+}
+
+pub(super) struct SelectionWitness {
+    transport: Option<Transport>,
+    state: SelectionState,
+    last_poll: Instant,
+    binding: NativeBinding,
+    attempts: AttemptLedger,
+}
+
+impl SelectionWitness {
+    pub(super) fn from_adopted() -> Self {
+        let (bridge_enabled, stream) = crate::inherited_bridge::take();
+        let transport = stream.map(Transport::from_stream);
+        Self {
+            transport,
+            state: SelectionState::new(),
+            last_poll: Instant::now(),
+            binding: NativeBinding {
+                enabled: bridge_enabled,
+                ..NativeBinding::default()
+            },
+            attempts: AttemptLedger::default(),
+        }
+    }
+
+    pub(super) fn poll_interval(&self) -> Duration {
+        if self.transport.is_some() {
+            Duration::from_millis(/*millis*/ 25)
+        } else {
+            Duration::from_secs(/*secs*/ 3600)
+        }
+    }
+
+    pub(super) async fn connected(
+        &mut self,
+        server: &AppServerSession,
+    ) -> color_eyre::eyre::Result<()> {
+        self.revoke("connecting");
+        if self.transport.is_none() {
+            return Ok(());
+        }
+        self.bind_connection(server).await?;
+        let handle = server.request_handle();
+        let request = codex_app_server_protocol::ClientRequest::ServerDiagnostics {
+            request_id: codex_app_server_protocol::RequestId::String(format!(
+                "selection-witness-{}",
+                Uuid::new_v4()
+            )),
+            params: codex_app_server_protocol::ServerDiagnosticsParams::default(),
+        };
+        let response: Result<codex_app_server_protocol::ServerDiagnosticsResponse, _> =
+            match tokio::time::timeout(
+                Duration::from_secs(/*secs*/ 2),
+                handle.request_typed(request),
+            )
+            .await
+            {
+                Ok(result) => result,
+                Err(_) => {
+                    self.state.connected(None);
+                    self.emit("diagnostics-timeout");
+                    return Ok(());
+                }
+            };
+        self.state
+            .connected(response.ok().map(|response| response.process.id));
+        self.emit("connected");
+        Ok(())
+    }
+
+    pub(super) fn publish(&mut self, thread: Option<ThreadId>, ready: bool) {
+        if self.state.select(thread, ready) {
+            self.emit("state");
+        }
+    }
+
+    pub(super) fn revoke(&mut self, cause: &'static str) {
+        if self.state.select(self.state.thread_id, false) {
+            self.emit(cause);
+        }
+    }
+
+    pub(super) fn emit(&mut self, cause: &'static str) {
+        let cause = if self.state.expire_after_loop_gap(self.last_poll.elapsed()) {
+            "loop-gap"
+        } else {
+            cause
+        };
+        self.last_poll = Instant::now();
+        self.state.cause = cause;
+        let Some(transport) = self.transport.as_mut() else {
+            return;
+        };
+        if let Err(failure) = transport.poll(&mut self.state, self.binding.view()) {
+            tracing::warn!(target: "codex_selection_witness", stage = failure.stage, error_kind = ?failure.error.kind(), raw_errno = failure.error.raw_os_error(), sequence = self.state.sequence, generation = self.state.generation, "native witness unavailable");
+            self.state.select(self.state.thread_id, false);
+            self.transport = None;
+        }
+    }
+}
+
+impl Drop for SelectionWitness {
+    fn drop(&mut self) {
+        self.revoke("exit");
+    }
+}
+
+impl App {
+    pub(super) fn selection_witness_ready(&self) -> bool {
+        self.active_thread_id.is_some_and(|id| {
+            self.chat_widget.thread_id() == Some(id)
+                && self
+                    .thread_event_channels
+                    .get(&id)
+                    .is_some_and(|channel| channel.attachment() == ThreadEventAttachment::Live)
+        }) && self
+            .active_thread_rx
+            .as_ref()
+            .is_some_and(tokio::sync::mpsc::Receiver::is_empty)
+            && self.chat_widget.selection_witness_ready()
+            && self.overlay.is_none()
+            && !self.reconnect.offline
+            && !self.reconnect.failed
+            && self.pending_thread_switch_resets == 0
+            && !self.pending_open_resume_picker
+            && self.pending_working_directory_change.is_none()
+            && self.pending_start_managed_worktree.is_none()
+            && !self.pending_managed_worktree_creation
+            && self.pending_managed_worktree_created.is_none()
+            && self.pending_managed_worktree_transition.is_none()
+            && self.pending_managed_worktree_attach.is_none()
+            && self.pending_shutdown_exit_thread_id.is_none()
+            && !self.pending_startup_thread_start
+            && !self.startup_pending_protected_request
+            && !self.has_queued_startup_protected_request()
+            && self.pending_primary_events.is_empty()
+    }
+}
+
