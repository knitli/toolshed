+use super::*;
+
+#[test]
+fn delayed_loop_revokes_before_renewal() {
+    let mut state = SelectionState::new();
+    let thread = Some(ThreadId::new());
+    state.connected(Some(123));
+    state.select(thread, true);
+    let selected = state.generation;
+    assert!(!state.expire_after_loop_gap(Duration::from_millis(/*millis*/ 749)));
+    assert!(state.eligible);
+    assert!(
+        state.expire_after_loop_gap(Duration::from_millis(/*millis*/ 750)),
+        "delayed loop must revoke before renewing"
+    );
+    assert!(!state.eligible, "delayed loop must revoke before renewing");
+    assert!(state.generation > selected);
+    let revoked = state.generation;
+    state.select(thread, true);
+    assert!(state.eligible && state.generation > revoked);
+}
+
+#[test]
+fn revocation_and_reconnect_never_reuse_selection_generation() {
+    let mut state = SelectionState::new();
+    let thread = Some(ThreadId::new());
+    state.select(thread, true);
+    assert!(!state.eligible, "no backend identity means unavailable");
+    state.connected(Some(123));
+    let connection = state.connection_id;
+    state.select(thread, true);
+    let selected = state.generation;
+    assert!(state.eligible);
+    state.select(thread, false);
+    assert!(!state.eligible, "revocation must clear eligibility");
+    assert!(state.generation > selected);
+    let revoked = state.generation;
+    state.select(thread, true);
+    assert!(state.eligible && state.generation > revoked);
+    state.connected(Some(123));
+    assert!(
+        !state.eligible,
+        "reconnect never inherits selected authority"
+    );
+    assert_ne!(state.connection_id, connection);
+    state.select(None, true);
+    assert!(!state.eligible, "no selected thread means unavailable");
+}
+
+#[test]
+fn fragmented_challenge_survives_state_burst() {
+    use std::os::fd::IntoRawFd;
+    let (mut parent, child) = UnixStream::pair().expect("private channel");
+    let transport = Transport::from_inherited_fd(child.into_raw_fd()).expect("adopt capability");
+    let flags = unsafe { libc::fcntl(transport.stream.as_raw_fd(), libc::F_GETFD) };
+    assert_ne!(
+        flags & libc::FD_CLOEXEC,
+        0,
+        "descendants must not inherit witness capability"
+    );
+    let mut witness = SelectionWitness {
+        transport: Some(transport),
+        state: SelectionState::new(),
+        last_poll: Instant::now(),
+        binding: NativeBinding::default(),
+        attempts: AttemptLedger::default(),
+    };
+    witness.state.connected(Some(123));
+    let thread = Some(ThreadId::new());
+    for _ in 0..10_000 {
+        witness.publish(thread, true);
+        witness.revoke("test-transition");
+    }
+    witness.publish(thread, true);
+    assert!(
+        witness.transport.is_some(),
+        "state bursts cannot exhaust an output queue"
+    );
+    assert_eq!(
+        witness.state.sequence, 0,
+        "no unsolicited heartbeat responses"
+    );
+    parent.write_all(b"{\"no").expect("challenge prefix");
+    witness.emit("poll");
+    assert!(
+        witness.transport.is_some(),
+        "fragmented challenge must remain open"
+    );
+    parent.write_all(b"nce\":1}\n").expect("challenge suffix");
+    witness.emit("poll");
+    let mut response = [0; 2048];
+    parent.set_nonblocking(true).expect("nonblocking parent");
+    let count = parent.read(&mut response).expect("challenge response");
+    let row: serde_json::Value = serde_json::from_slice(&response[..count]).expect("response JSON");
+    assert_eq!(row["nonce"], 1);
+    assert_eq!(row["sequence"], 1);
+    assert_eq!(row["eligible"], true);
+    assert_eq!(row["generation"], witness.state.generation);
+    assert_eq!(
+        row["threadId"],
+        serde_json::json!(thread.map(|id| id.to_string()))
+    );
+}
+
+#[test]
+fn replayed_challenge_revokes_channel() {
+    use std::os::fd::IntoRawFd;
+    let (mut parent, child) = UnixStream::pair().expect("private channel");
+    let transport = Transport::from_inherited_fd(child.into_raw_fd()).expect("adopt capability");
+    let mut witness = SelectionWitness {
+        transport: Some(transport),
+        state: SelectionState::new(),
+        last_poll: Instant::now(),
+        binding: NativeBinding::default(),
+        attempts: AttemptLedger::default(),
+    };
+    witness.state.connected(Some(123));
+    witness.publish(Some(ThreadId::new()), true);
+    parent
+        .write_all(b"{\"nonce\":1}\n")
+        .expect("first challenge");
+    witness.emit("poll");
+    assert!(witness.transport.is_some());
+    parent
+        .write_all(b"{\"nonce\":1}\n")
+        .expect("replayed challenge");
+    witness.emit("poll");
+    assert!(
+        witness.transport.is_none(),
+        "replayed challenge must close capability"
+    );
+    assert!(!witness.state.eligible);
+}
