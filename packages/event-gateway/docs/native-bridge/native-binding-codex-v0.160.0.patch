+fn one_permit_id_cannot_commit_distinct_start_identities() {
+    let params = request_params();
+    let selection = Arc::new(Mutex::new(SelectionState {
+        generation: params.expected_generation,
+        thread_id: Some(params.thread_id.clone()),
+        ready: true,
+        expires_at: Some(Instant::now() + Duration::from_secs(10)),
+        closed: false,
+    }));
+    let receipts = Arc::new(Mutex::new(ReceiptStore::default()));
+
+    let first_guard = guard_for(
+        &params,
+        Arc::clone(&selection),
+        Arc::clone(&receipts),
+        Instant::now() + Duration::from_secs(5),
+    );
+    let mut first_registered = false;
+    let mut first_commit = || first_registered = true;
+    assert_eq!(
+        first_guard.commit_start("first-turn", &mut first_commit),
+        TurnStartGuardCommit::Committed
+    );
+    assert!(first_registered);
+
+    let exact_replay_guard = guard_for(
+        &params,
+        Arc::clone(&selection),
+        Arc::clone(&receipts),
+        Instant::now() + Duration::from_secs(5),
+    );
+    let mut replay_registered = false;
+    let mut replay_commit = || replay_registered = true;
+    assert_eq!(
+        exact_replay_guard.commit_start("replacement-turn-id", &mut replay_commit),
+        TurnStartGuardCommit::AlreadyCommitted {
+            turn_id: "first-turn".to_string(),
+        }
+    );
+    assert!(!replay_registered);
+
+    let mut distinct_identity = params;
+    distinct_identity.attempt_id = "another-attempt".to_string();
+    distinct_identity.delivery_id = "another-delivery".to_string();
+    distinct_identity.client_user_message_id = "another-message".to_string();
+    distinct_identity.input = "another event".to_string();
+    assert_eq!(
+        duplicate_response_from(&lock(&receipts), &distinct_identity),
+        Some(not_started(
+            ThreadStartIfIdleNotStartedReason::DuplicateConflict
+        ))
+    );
+
+    let conflicting_guard = guard_for(
+        &distinct_identity,
+        selection,
+        Arc::clone(&receipts),
+        Instant::now() + Duration::from_secs(5),
+    );
+    let mut conflicting_registered = false;
+    let mut conflicting_commit = || conflicting_registered = true;
+    assert_eq!(
+        conflicting_guard.commit_start("second-turn", &mut conflicting_commit),
+        TurnStartGuardCommit::Rejected
+    );
+    assert!(!conflicting_registered);
+    assert_eq!(
+        conflicting_guard.rejection.get(),
+        Some(ThreadStartIfIdleNotStartedReason::DuplicateConflict)
+    );
+    assert_eq!(lock(&receipts).by_delivery.len(), 1);
