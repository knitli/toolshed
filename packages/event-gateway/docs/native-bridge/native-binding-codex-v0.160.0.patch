+use super::*;
+
+fn event() -> BridgeEvent {
+    BridgeEvent {
+        client_id: Uuid::new_v4().to_string(),
+        generation: 1,
+        server_instance_id: Uuid::new_v4().to_string(),
+        server_generation: 2,
+        thread_id: ThreadId::new().to_string(),
+        attempt_id: Uuid::new_v4().to_string(),
+        delivery_id: format!("dly_{}", "a".repeat(64)),
+        client_user_message_id: Uuid::new_v4().to_string(),
+        permit_id: "permit_fixture".to_owned(),
+        permit_issued_at: 1000,
+        permit_expires_at: 2000,
+        event: EventMetadata {
+            event_id: Uuid::new_v4().to_string(),
+            source: Source::Manual,
+            source_state_version: "version_1".to_owned(),
+            canonical_subject: Subject::Manual {
+                subject_id: "synthetic_subject".to_owned(),
+            },
+            event_reference: format!("ref_{}", Uuid::new_v4()),
+        },
+    }
+}
+
+#[test]
+fn event_metadata_obeys_pinned_source_and_subject_bounds() {
+    let mut event = event();
+    let params = event.params().expect("valid closed metadata");
+    let metadata: serde_json::Value =
+        serde_json::from_str(params.input.split_once('\n').unwrap().1).unwrap();
+    assert_eq!(metadata.as_object().unwrap().len(), 6);
+    assert_eq!(metadata["deliveryId"], event.delivery_id);
+    event.event.source = Source::Github;
+    assert!(
+        event.params().is_none(),
+        "source and canonical subject must agree"
+    );
+    event.event.source = Source::Manual;
+    event.event.source_state_version = "a".repeat(129);
+    assert!(event.params().is_none());
+    event.event.source_state_version = "v1".to_owned();
+    let mut injected = serde_json::to_value(&event).unwrap();
+    injected["input"] = serde_json::json!("arbitrary model instructions");
+    assert!(serde_json::from_value::<BridgeEvent>(injected).is_err());
+}
+
+#[test]
+fn attempt_ledger_preserves_unknown_and_exact_receipt() {
+    let event = event();
+    let mut ledger = AttemptLedger::default();
+    let index = ledger.reserve(&event).expect("first attempt");
+    assert!(
+        matches!(ledger.previous(&event), Some(Outcome::Unknown)),
+        "reserve must record unknown before RPC send"
+    );
+    assert!(
+        matches!(ledger.reserve(&event), Err(Outcome::Unknown)),
+        "unknown attempt cannot be executed twice"
+    );
+    let started = Outcome::Started {
+        turn_id: Uuid::new_v4().to_string(),
+        replayed: false,
+    };
+    ledger.0[index].1 = started.clone();
+    assert_eq!(ledger.previous(&event), Some(started.clone()));
+    let Outcome::Started { turn_id, .. } = started else {
+        unreachable!()
+    };
+    assert_eq!(
+        ledger.receipt(&event),
+        Some(Outcome::Started {
+            turn_id,
+            replayed: true
+        }),
+        "cached receipt must report a replay without another start"
+    );
+    let mut conflicting = event.clone();
+    conflicting.permit_id = "another_permit".to_owned();
+    assert!(matches!(
+        ledger.previous(&conflicting),
+        Some(Outcome::Unknown)
+    ));
+    assert_eq!(ledger.0.len(), 1);
+}
+
+#[test]
+fn receipt_lookup_preserves_local_attempt_identity() {
+    let event = event();
+    let mut ledger = AttemptLedger::default();
+    assert!(ledger.receipt_params(&event).is_none());
+    ledger.reserve(&event).unwrap();
+    assert!(ledger.receipt_params(&event).is_some());
+    for changed_client in [true, false] {
+        let mut rebound = event.clone();
+        if changed_client {
+            rebound.client_id = Uuid::new_v4().to_string();
+        } else {
+            rebound.generation += 1;
+        }
+        assert!(
+            ledger.receipt_params(&rebound).is_none(),
+            "changed local receipt identity must not reach native lookup"
+        );
+    }
+}
+
+#[test]
+fn native_receipt_must_explicitly_be_replayed() {
+    let turn_id = Uuid::new_v4().to_string();
+    let response = |replayed| codex_app_server_protocol::ThreadStartReceiptResponse::Started {
+        turn_id: turn_id.clone(),
+        replayed,
+    };
+    assert!(matches!(
+        native_receipt_outcome(response(true), &turn_id),
+        Outcome::Started { replayed: true, .. }
+    ));
+    assert_eq!(
+        native_receipt_outcome(response(false), &turn_id),
+        Outcome::Unknown,
+        "unreplayed native receipt must remain unknown"
+    );
+    assert_eq!(
+        native_receipt_outcome(response(true), &Uuid::new_v4().to_string()),
+        Outcome::Unknown,
+        "wrong native turn identity must remain unknown"
+    );
+    assert_eq!(
+        bound_outcome(
+            Outcome::Started {
+                turn_id,
+                replayed: false
+            },
+            &Uuid::new_v4().to_string()
+        ),
+        Outcome::Unknown
+    );
+}
+
+#[test]
+fn event_requires_the_observed_local_and_server_generations() {
+    let mut event = event();
+    let thread = ThreadId::from_string(&event.thread_id).unwrap();
+    let mut witness = SelectionWitness {
+        transport: None,
+        state: SelectionState::new(),
+        last_poll: Instant::now(),
+        binding: NativeBinding {
+            enabled: true,
+            response: Some(codex_app_server_protocol::ClientSelectionUpdateResponse {
+                status: codex_app_server_protocol::ClientSelectionUpdateStatus::Updated,
+                server_instance_id: event.server_instance_id.clone(),
+                generation: event.server_generation,
+                thread_id: Some(event.thread_id.clone()),
+                ready: true,
+                lease_ms: 750,
+            }),
+            sent_at: Some(Instant::now()),
+        },
+        attempts: AttemptLedger::default(),
+    };
+    witness.state.connected(Some(123));
+    witness.state.select(Some(thread), true);
+    event.client_id = witness.state.client_id.to_string();
+    event.generation = witness.state.generation;
+    assert!(event.matches_selection(&witness));
+    event.generation -= 1;
+    assert!(
+        !event.matches_selection(&witness),
+        "stale local selection generation must not reach native start"
+    );
+    event.generation = witness.state.generation;
+    event.server_generation += 1;
+    assert!(!event.matches_selection(&witness));
+}
