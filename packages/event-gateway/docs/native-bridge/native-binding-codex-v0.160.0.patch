+#[derive(Debug)]
+struct RejectStartGuard;
+
+impl TurnStartGuard for RejectStartGuard {
+    fn commit_start(&self, _turn_id: &str, _commit: &mut dyn FnMut()) -> TurnStartGuardCommit {
+        TurnStartGuardCommit::Rejected
+    }
+}
+
+#[derive(Debug)]
+struct CommitStartGuard;
+
+impl TurnStartGuard for CommitStartGuard {
+    fn commit_start(&self, _turn_id: &str, commit: &mut dyn FnMut()) -> TurnStartGuardCommit {
+        commit();
+        TurnStartGuardCommit::Committed
+    }
+}
+
+struct BlockingBeforeTaskStart {
+    blocked_turn_id: String,
+    blocked_start_entered: tokio::sync::Notify,
+    release_blocked_start: tokio::sync::Notify,
+    events: std::sync::Mutex<Vec<String>>,
+}
+
+impl codex_extension_api::TurnLifecycleContributor for BlockingBeforeTaskStart {
+    fn on_turn_start<'a>(
+        &'a self,
+        input: codex_extension_api::TurnStartInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            if input.turn_id == self.blocked_turn_id {
+                self.events
+                    .lock()
+                    .expect("lifecycle events lock")
+                    .push("blocked-start-entered".to_string());
+                self.blocked_start_entered.notify_one();
+                self.release_blocked_start.notified().await;
+                self.events
+                    .lock()
+                    .expect("lifecycle events lock")
+                    .push("blocked-start-finished".to_string());
+            } else {
+                self.events
+                    .lock()
+                    .expect("lifecycle events lock")
+                    .push("replacement-start".to_string());
+            }
+        })
+    }
+
+    fn on_turn_abort<'a>(
+        &'a self,
+        _input: codex_extension_api::TurnAbortInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            self.events
+                .lock()
+                .expect("lifecycle events lock")
+                .push("blocked-abort".to_string());
+        })
+    }
+}
