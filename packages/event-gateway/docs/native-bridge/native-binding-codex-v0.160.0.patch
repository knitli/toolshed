+use super::*;
+
+#[test]
+fn stale_native_ack_cannot_publish_eligibility() {
+    let thread = ThreadId::new();
+    let mut binding = NativeBinding {
+        enabled: true,
+        response: Some(ClientSelectionUpdateResponse {
+            status: ClientSelectionUpdateStatus::Updated,
+            server_instance_id: Uuid::new_v4().to_string(),
+            generation: 7,
+            thread_id: Some(thread.to_string()),
+            ready: true,
+            lease_ms: 750,
+        }),
+        sent_at: Some(Instant::now()),
+    };
+    assert!(binding.matches(Some(thread)));
+    binding.response.as_mut().unwrap().status = ClientSelectionUpdateStatus::Stale;
+    assert!(
+        !binding.matches(Some(thread)),
+        "stale acknowledgment must not qualify native selection"
+    );
+}
+
+#[test]
+fn binding_deadline_is_measured_from_request_send() {
+    let thread = ThreadId::new();
+    let binding = NativeBinding {
+        enabled: true,
+        response: Some(ClientSelectionUpdateResponse {
+            status: ClientSelectionUpdateStatus::Updated,
+            server_instance_id: Uuid::new_v4().to_string(),
+            generation: 7,
+            thread_id: Some(thread.to_string()),
+            ready: true,
+            lease_ms: 15_000,
+        }),
+        sent_at: Some(Instant::now() - Duration::from_millis(/*millis*/ 750)),
+    };
+    assert!(
+        !binding.matches(Some(thread)),
+        "native eligibility cannot exceed the 750ms local deadline"
+    );
+}
