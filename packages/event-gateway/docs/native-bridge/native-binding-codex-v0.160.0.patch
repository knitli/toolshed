+#[test]
+fn lost_core_reply_reconciles_from_committed_receipt() {
+    let params = request_params();
+    let selection = Arc::new(Mutex::new(SelectionState {
+        generation: params.expected_generation,
+        thread_id: Some(params.thread_id.clone()),
+        ready: true,
+        expires_at: Some(Instant::now() + Duration::from_millis(750)),
+        closed: false,
+    }));
+    let receipts = Arc::new(Mutex::new(ReceiptStore::default()));
+    let guard = NativeTurnStartGuard {
+        selection,
+        receipts: Arc::clone(&receipts),
+        expected_generation: params.expected_generation,
+        thread_id: params.thread_id.clone(),
+        permit_deadline: Instant::now() + Duration::from_secs(5),
+        receipt: receipt_for(&params),
+        rejection: GuardRejection(Mutex::new(None)),
+    };
+    let mut task_registered = false;
+    let mut commit = || task_registered = true;
+
+    assert_eq!(
+        guard.commit_start("stable-turn", &mut commit),
+        TurnStartGuardCommit::Committed
+    );
+    assert!(task_registered);
+    assert_eq!(
+        committed_receipt_response_from(&lock(&receipts), &params),
+        Some(ThreadStartIfIdleResponse::Started {
+            turn_id: "stable-turn".to_string(),
+            replayed: true,
+        })
+    );
+    assert_eq!(
+        duplicate_response_from(&lock(&receipts), &params),
+        Some(ThreadStartIfIdleResponse::Started {
+            turn_id: "stable-turn".to_string(),
+            replayed: true,
+        }),
+        "an exact receipt remains replayable after its permit time has passed"
+    );
+
+    let mut colliding_turn_id = params;
+    colliding_turn_id.attempt_id = "different-attempt".to_string();
+    colliding_turn_id.delivery_id = "different-delivery".to_string();
+    assert_eq!(
+        duplicate_response_from(&lock(&receipts), &colliding_turn_id),
+        Some(not_started(
+            ThreadStartIfIdleNotStartedReason::DuplicateConflict
+        ))
