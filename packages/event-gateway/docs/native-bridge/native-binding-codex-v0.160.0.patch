+#[tokio::test]
+async fn rejected_guarded_start_has_no_user_or_turn_started_event() {
+    let (session, _turn_context, rx) = make_session_and_context_with_rx().await;
+    while rx.try_recv().is_ok() {}
+
+    let submission = handle(
