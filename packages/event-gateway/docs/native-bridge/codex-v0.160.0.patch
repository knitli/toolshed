+#[test]
+fn replayed_challenge_revokes_channel() {
+    use std::os::fd::IntoRawFd;
+    let (mut parent, child) = UnixStream::pair().expect("private channel");
+    let transport = Transport::from_inherited_fd(child.into_raw_fd()).expect("adopt capability");
+    let mut witness = SelectionWitness {
+        transport: Some(transport),
+        state: SelectionState::new(),
+        last_poll: Instant::now(),
+    };
+    witness.state.connected(Some(123));
+    witness.publish(Some(ThreadId::new()), true);
+    parent
+        .write_all(b"{\"nonce\":1}\n")
+        .expect("first challenge");
+    witness.emit("poll");
+    assert!(witness.transport.is_some());
+    parent
+        .write_all(b"{\"nonce\":1}\n")
+        .expect("replayed challenge");
+    witness.emit("poll");
+    assert!(
+        witness.transport.is_none(),
+        "replayed challenge must close capability"
+    );
+    assert!(!witness.state.eligible);
+}
