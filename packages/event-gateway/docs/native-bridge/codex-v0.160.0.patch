+#[test]
+fn delayed_loop_revokes_before_renewal() {
+    let mut state = SelectionState::new();
+    let thread = Some(ThreadId::new());
+    state.connected(Some(123));
+    state.select(thread, true);
+    let selected = state.generation;
+    assert!(!state.expire_after_loop_gap(Duration::from_millis(/*millis*/ 749)));
+    assert!(state.eligible);
+    assert!(
+        state.expire_after_loop_gap(Duration::from_millis(/*millis*/ 750)),
+        "delayed loop must revoke before renewing"
+    );
+    assert!(!state.eligible, "delayed loop must revoke before renewing");
+    assert!(state.generation > selected);
+    let revoked = state.generation;
+    state.select(thread, true);
+    assert!(state.eligible && state.generation > revoked);
+}
+
+#[test]
+fn revocation_and_reconnect_never_reuse_selection_generation() {
+    let mut state = SelectionState::new();
+    let thread = Some(ThreadId::new());
+    state.select(thread, true);
+    assert!(!state.eligible, "no backend identity means unavailable");
+    state.connected(Some(123));
+    let connection = state.connection_id;
+    state.select(thread, true);
+    let selected = state.generation;
+    assert!(state.eligible);
+    state.select(thread, false);
+    assert!(!state.eligible, "revocation must clear eligibility");
+    assert!(state.generation > selected);
+    let revoked = state.generation;
+    state.select(thread, true);
+    assert!(state.eligible && state.generation > revoked);
+    state.connected(Some(123));
+    assert!(
+        !state.eligible,
+        "reconnect never inherits selected authority"
+    );
+    assert_ne!(state.connection_id, connection);
+    state.select(None, true);
+    assert!(!state.eligible, "no selected thread means unavailable");
+}
