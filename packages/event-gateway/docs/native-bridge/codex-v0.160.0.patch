+#[test]
+fn write_failure_retains_exact_os_error() {
+    struct BrokenWriter;
+    impl Write for BrokenWriter {
+        fn write(&mut self, _: &[u8]) -> io::Result<usize> {
+            Err(io::Error::from_raw_os_error(libc::EPIPE))
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut pending = PendingWrite {
+        bytes: vec![1],
+        offset: 0,
+        created: Instant::now(),
+    };
+    let error = pending
+        .flush(&mut BrokenWriter)
+        .expect_err("permanent write error");
+    assert_eq!(
+        error.raw_os_error(),
+        Some(libc::EPIPE),
+        "diagnostics must retain exact errno"
+    );
+}
