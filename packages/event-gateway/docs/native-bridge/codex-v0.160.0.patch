+#[test]
+fn expired_pending_response_closes_instead_of_renewing() {
+    use std::os::fd::IntoRawFd;
+    let (_parent, child) = UnixStream::pair().expect("private channel");
+    let mut transport =
+        Transport::from_inherited_fd(child.into_raw_fd()).expect("adopt capability");
+    transport.pending = Some(PendingWrite {
+        bytes: b"stale-response\n".to_vec(),
+        offset: 1,
+        created: Instant::now() - Duration::from_millis(/*millis*/ 750),
+    });
+    let mut witness = SelectionWitness {
+        transport: Some(transport),
+        state: SelectionState::new(),
+        last_poll: Instant::now(),
+    };
+    witness.state.connected(Some(123));
+    witness.state.select(Some(ThreadId::new()), true);
+    witness.emit("poll");
+    assert!(
+        witness.transport.is_none(),
+        "expired pending response must close capability"
+    );
+    assert!(!witness.state.eligible);
+}
