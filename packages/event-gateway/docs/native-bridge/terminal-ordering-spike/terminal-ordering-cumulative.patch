+    );
+    let fixtures: Vec<Fixture> = serde_json::from_slice(&bytes)?;
+    assert_eq!(fixtures.len(), 3);
+    let home = std::path::PathBuf::from(std::env::var("EVENT_TERMINAL_DB_HOME")?);
+    let mode = std::env::var("EVENT_TERMINAL_PHASE").unwrap_or_else(|_| "normal".into());
