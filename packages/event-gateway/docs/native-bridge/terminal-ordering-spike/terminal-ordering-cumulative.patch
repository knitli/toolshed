+        sqlx::query("UPDATE native_turn_start_receipts SET terminal_candidate_status = ? WHERE attempt_id = ?")
+            .bind(candidate).bind(&identity.attempt_id).execute(&mut *transaction).await?;
+        let proof = promote_terminal_candidate(&mut transaction, &identity).await?;
+        transaction.commit().await?;
+        Ok(proof)
+    }
