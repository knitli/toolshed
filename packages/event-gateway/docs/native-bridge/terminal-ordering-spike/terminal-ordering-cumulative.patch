+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum NativeTurnTerminalStatus {
+    Completed,
+    Failed,
+    Canceled,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct NativeTurnTerminalProof {
+    pub turn_id: String,
+    pub receipt_id: String,
+    pub status: NativeTurnTerminalStatus,
+}
+
 impl StateRuntime {
+    /// Commits immutable terminal evidence only for an already-started v3 identity.
+    pub async fn record_native_turn_terminal(
+        &self,
+        identity: &NativeTurnStartIdentity,
+        turn_id: &str,
+        status: NativeTurnTerminalStatus,
+    ) -> anyhow::Result<NativeTurnTerminalProof> {
+        validate_terminal_identity(identity)?;
+        validate_started_turn(identity, turn_id)?;
+        let mut transaction = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let row = exact_native_receipt_row(&mut transaction, identity).await?;
+        if matches!(proof_from_row(&row)?, NativeTurnStartProof::Pending) {
+            bail!("native terminal proof requires committed start evidence");
+        }
+        if row
+            .try_get::<Option<String>, _>("terminal_candidate_status")?
+            .is_some_and(|candidate| candidate != terminal_status_name(status))
+        {
+            bail!("native terminal status conflicts with observed candidate");
+        }
+        let proof = commit_terminal_proof(&mut transaction, &row, status).await?;
+        transaction.commit().await?;
+        Ok(proof)
+    }
+
+    /// Observes a trusted Core terminal event; pending candidates are not proof.
+    pub async fn observe_native_turn_terminal(
+        &self,
+        thread_id: &str,
