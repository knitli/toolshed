+        if mode == "before" {
+            continue;
+        }
+        if mode == "write_failure" {
+            db.close().await;
+        }
+        // Volatile receipts deliberately remain empty: durable identity correlates the event.
+        manager
+            .observe_core_item_completed(thread, &fixture.event)
