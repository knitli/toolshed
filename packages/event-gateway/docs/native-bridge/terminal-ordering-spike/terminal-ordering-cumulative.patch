+        status: NativeTurnTerminalStatus,
+    ) -> anyhow::Result<Option<NativeTurnTerminalProof>> {
+        let mut transaction = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let row = sqlx::query("SELECT * FROM native_turn_start_receipts WHERE thread_id = ? AND client_user_message_id = ?")
+            .bind(thread_id).bind(turn_id).fetch_optional(&mut *transaction).await?;
+        let Some(row) = row else {
+            return Ok(None);
+        };
+        let identity = identity_from_row(&row)?;
+        validate_terminal_identity(&identity)?;
+        validate_started_turn(&identity, turn_id)?;
+        if terminal_proof_from_row(&row)?.is_some() {
+            let proof = commit_terminal_proof(&mut transaction, &row, status).await?;
+            transaction.commit().await?;
+            return Ok(Some(proof));
+        }
+        let candidate = row.try_get::<Option<String>, _>("terminal_candidate_status")?;
+        // A conflict is durable and never promoted, including after restart.
+        let candidate = if candidate
+            .as_deref()
+            .is_some_and(|candidate| candidate != terminal_status_name(status))
+        {
+            "conflict"
+        } else {
+            terminal_status_name(status)
