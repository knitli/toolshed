+#[tokio::test]
+async fn native_terminal_candidate_orders_with_start_and_input_across_restart() -> anyhow::Result<()>
+{
+    for input_first in [false, true] {
+        for terminal_first in [false, true] {
+            let home = unique_temp_dir();
+            let db = runtime(&home).await?;
+            let mut request = identity(50);
+            request.bridge_client_id = Some("bridge".into());
+            request.bridge_client_generation = Some(1);
+            let turn = &request.client_user_message_id;
+            let status = NativeTurnTerminalStatus::Completed;
+            assert_eq!(
+                db.observe_native_turn_terminal(&request.thread_id, turn, status)
+                    .await?,
+                None
+            );
+            db.begin_native_turn_start(&request, &[]).await?;
+            assert_eq!(
+                db.observe_native_turn_terminal("wrong-thread", turn, status)
+                    .await?,
+                None
+            );
+            if terminal_first {
+                for _ in 0..2 {
+                    assert_eq!(
+                        db.observe_native_turn_terminal(&request.thread_id, turn, status)
+                            .await?,
+                        None
+                    );
+                }
+            }
+            db.close().await;
+            let db = runtime(&home).await?;
+            assert_eq!(db.get_native_turn_terminal_proof(&request).await?, None);
+            if input_first {
+                db.record_native_turn_input(&request, turn, "00000000-0000-7000-8000-000000000099")
+                    .await?;
+            } else {
+                db.record_native_turn_started(&request, turn).await?;
+            }
+            assert_eq!(
+                db.get_native_turn_terminal_proof(&request).await?.is_some(),
+                terminal_first
+            );
+            let proof = db
+                .observe_native_turn_terminal(&request.thread_id, turn, status)
+                .await?
+                .expect("anchored terminal");
+            assert_eq!(
+                db.get_native_turn_terminal_proof(&request).await?,
+                Some(proof.clone())
+            );
+            assert!(
+                db.observe_native_turn_terminal(
+                    &request.thread_id,
+                    turn,
+                    NativeTurnTerminalStatus::Failed
+                )
+                .await
+                .is_err()
+            );
+            assert_eq!(
+                db.observe_native_turn_terminal(&request.thread_id, turn, status)
+                    .await?,
+                Some(proof.clone())
+            );
+            db.close().await;
+            let db = runtime(&home).await?;
+            assert_eq!(
+                db.get_native_turn_terminal_proof(&request).await?,
