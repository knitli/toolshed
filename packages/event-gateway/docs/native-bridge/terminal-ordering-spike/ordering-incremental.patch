+        let skills = SkillsWatcher::new(manager.skills_service(), &home_path, outgoing.clone());
+        let receipts = Arc::new(Mutex::new(ReceiptStore::default()));
+        install_native_receipt_observer(&states, &receipts, Some(db.clone()));
+        ensure_listener_task_running(ListenerTaskContext {
