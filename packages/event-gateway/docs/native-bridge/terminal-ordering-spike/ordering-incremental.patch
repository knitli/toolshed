+
+fn terminal_status_name(status: NativeTurnTerminalStatus) -> &'static str {
+    match status {
+        NativeTurnTerminalStatus::Completed => "completed",
+        NativeTurnTerminalStatus::Failed => "failed",
+        NativeTurnTerminalStatus::Canceled => "canceled",
+    }
+}
+
+async fn commit_terminal_proof(
+    transaction: &mut sqlx::Transaction<'_, sqlx::Sqlite>,
+    row: &sqlx::sqlite::SqliteRow,
+    status: NativeTurnTerminalStatus,
+) -> anyhow::Result<NativeTurnTerminalProof> {
+    if let Some(proof) = terminal_proof_from_row(row)? {
+        if proof.status != status {
+            bail!("native terminal status conflicts with committed proof");
+        }
+        return Ok(proof);
+    }
+    let proof = NativeTurnTerminalProof {
+        turn_id: row.try_get("turn_id")?,
+        receipt_id: Uuid::new_v4().to_string(),
+        status,
+    };
+    sqlx::query("UPDATE native_turn_start_receipts SET terminal_status = ?, terminal_receipt_id = ? WHERE attempt_id = ?")
+        .bind(terminal_status_name(status)).bind(&proof.receipt_id)
+        .bind(row.try_get::<String, _>("attempt_id")?).execute(&mut **transaction).await?;
+    Ok(proof)
+}
+
+async fn promote_terminal_candidate(
+    transaction: &mut sqlx::Transaction<'_, sqlx::Sqlite>,
+    identity: &NativeTurnStartIdentity,
+) -> anyhow::Result<Option<NativeTurnTerminalProof>> {
+    let row = exact_native_receipt_row(transaction, identity).await?;
+    let status = match row
+        .try_get::<Option<String>, _>("terminal_candidate_status")?
+        .as_deref()
+    {
+        None | Some("conflict") => return Ok(None),
+        Some("completed") => NativeTurnTerminalStatus::Completed,
+        Some("failed") => NativeTurnTerminalStatus::Failed,
+        Some("canceled") => NativeTurnTerminalStatus::Canceled,
+        Some(_) => bail!("invalid native terminal candidate"),
+    };
+    validate_terminal_identity(identity)?;
+    if matches!(proof_from_row(&row)?, NativeTurnStartProof::Pending) {
+        return Ok(None);
+    }
+    Ok(Some(
+        commit_terminal_proof(transaction, &row, status).await?,
+    ))
 }
 
