+                    NativeTurnTerminalStatus::Failed => "failed",
+                    NativeTurnTerminalStatus::Canceled => "canceled",
+                })
+                .bind(&proof.receipt_id)
+                .bind(&identity.attempt_id)
+                .execute(&mut *transaction)
+                .await?;
+            proof
+        };
+        transaction.commit().await?;
+        Ok(proof)
+    }
