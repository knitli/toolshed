+fn install_native_receipt_observer(
+    manager: &crate::thread_state::ThreadStateManager,
+    receipts: &Arc<Mutex<ReceiptStore>>,
+    state_db: Option<StateDbHandle>,
+) {
+    let receipts = Arc::clone(receipts);
+    manager.set_core_item_completed_observer(Arc::new(move |thread_id, event| {
+        let receipts = Arc::clone(&receipts);
+        let state_db = state_db.clone();
+        Box::pin(async move {
+            persist_core_terminal(&receipts, state_db.as_ref(), thread_id, &event).await;
+            persist_core_item_completed(receipts, state_db, event).await;
+        })
+    }));
+}
+
+async fn persist_core_terminal(
+    receipts: &Arc<Mutex<ReceiptStore>>,
+    state_db: Option<&StateDbHandle>,
+    thread_id: ThreadId,
+    event: &EventMsg,
+) {
+    use codex_state::NativeTurnTerminalStatus as Status;
+    let (turn_id, status) = match event {
+        EventMsg::TurnComplete(event) => (
+            &event.turn_id,
+            if event.error.is_some() {
+                Status::Failed
+            } else {
+                Status::Completed
+            },
+        ),
+        EventMsg::TurnAborted(event) => {
+            let Some(turn_id) = event.turn_id.as_ref() else {
+                return;
+            };
+            (turn_id, Status::Canceled)
+        }
+        _ => return,
+    };
+    let identity = {
+        let receipts = lock(receipts);
+        let Some(delivery) = receipts.by_client_user_message_id.get(turn_id) else {
+            return;
+        };
+        let Some(receipt) = receipts.by_delivery.get(delivery) else {
+            return;
+        };
+        if receipt.thread_id != thread_id.to_string() || receipt.turn_id != *turn_id {
+            return;
+        }
+        identity_from_receipt(receipt)
+    };
+    if let Some(state_db) = state_db {
+        // Only the committed database row is terminal authority; notification loss stays unknown.
+        let _ = state_db
+            .record_native_turn_terminal(&identity, turn_id, status)
+            .await;
+    }
+}
