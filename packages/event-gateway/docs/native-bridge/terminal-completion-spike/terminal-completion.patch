+        let turn_id = turn.sub_id.clone();
+        if outcome == "canceled" {
+            session.spawn_task(turn, Vec::new(), PendingTask).await;
+            session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+        } else {
+            session
+                .spawn_task(turn, Vec::new(), TerminalFixtureTask(outcome == "failed"))
+                .await;
+        }
+        let mut event = tokio::time::timeout(std::time::Duration::from_secs(10), async {
+            loop {
+                let event = receiver.recv().await.expect("Core event channel open");
+                if matches!(
+                    event.msg,
+                    EventMsg::TurnComplete(_) | EventMsg::TurnAborted(_)
+                ) {
+                    break event.msg;
+                }
+            }
+        })
+        .await
+        .expect("Core emits terminal event");
+        match &event {
+            EventMsg::TurnComplete(terminal) => {
+                assert_eq!(terminal.turn_id, turn_id);
+                assert_ne!(outcome, "canceled");
+                assert_eq!(terminal.error.is_some(), outcome == "failed");
+            }
+            EventMsg::TurnAborted(terminal) => {
+                assert_eq!(terminal.turn_id.as_deref(), Some(turn_id.as_str()));
+                assert_eq!(outcome, "canceled");
+                assert_eq!(terminal.reason, TurnAbortReason::Interrupted);
+            }
+            _ => unreachable!(),
+        }
+        if rollout_failure {
+            assert!(session.flush_rollout().await.is_err());
+            assert!(
+                !session
+                    .persist_rollout_items(&[codex_history::RolloutItem::EventMsg(event.clone())])
+                    .await
+            );
+        }
+        if let EventMsg::TurnComplete(terminal) = &mut event
+            && let Some(error) = &mut terminal.error
+        {
+            error.message = "[fixture error redacted]".to_string();
+        }
+        fixtures.push(serde_json::json!({
+            "status": outcome, "threadId": thread_id, "turnId": turn_id, "event": event,
+        }));
+    }
+    std::fs::write(path, serde_json::to_vec_pretty(&fixtures).unwrap())
+        .expect("write genuine Core terminal fixtures");
+}
 
