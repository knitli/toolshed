+
+fn terminal_proof_from_row(
+    row: &sqlx::sqlite::SqliteRow,
+) -> anyhow::Result<Option<NativeTurnTerminalProof>> {
+    let status: Option<String> = row.try_get("terminal_status")?;
+    let receipt_id: Option<String> = row.try_get("terminal_receipt_id")?;
+    match (status, receipt_id) {
+        (None, None) => Ok(None),
+        (Some(status), Some(receipt_id)) => {
+            let status = match status.as_str() {
+                "completed" => NativeTurnTerminalStatus::Completed,
+                "failed" => NativeTurnTerminalStatus::Failed,
+                "canceled" => NativeTurnTerminalStatus::Canceled,
+                _ => bail!("invalid native terminal status"),
+            };
+            Uuid::parse_str(&receipt_id).context("invalid native terminal receipt ID")?;
+            let turn_id = match proof_from_row(row)? {
+                NativeTurnStartProof::Started { turn_id }
+                | NativeTurnStartProof::InputRecorded { turn_id, .. } => turn_id,
+                NativeTurnStartProof::Pending => bail!("terminal receipt has no start proof"),
+            };
+            Ok(Some(NativeTurnTerminalProof {
+                turn_id,
+                receipt_id,
+                status,
+            }))
+        }
+        _ => bail!("incomplete native terminal proof"),
     }
 }
 
