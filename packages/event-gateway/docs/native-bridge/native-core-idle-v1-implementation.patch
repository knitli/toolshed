+#[test]
+fn witness_view_rounds_fractional_lease_age_down() {
+    let thread = ThreadId::new();
+    let binding = NativeBinding {
+        enabled: true,
+        response: Some(ClientSelectionUpdateResponse {
+            status: ClientSelectionUpdateStatus::Updated,
+            server_instance_id: Uuid::new_v4().to_string(),
+            generation: 7,
+            thread_id: Some(thread.to_string()),
+            ready: true,
+            lease_ms: 750,
+            native_core_turn_state: NativeCoreTurnState::Busy,
+        }),
+        sent_at: Some(Instant::now() - Duration::from_micros(/*micros*/ 500)),
+    };
+
+    let mut view = binding.view().unwrap();
+    view.refresh_lease();
+    let view = serde_json::to_value(view).unwrap();
+    assert!(
+        view["leaseMs"].as_u64().unwrap() < 750,
+        "fractional sample age must not be rounded away"
+    );
+}
+
+#[test]
+fn witness_view_fails_closed_when_selection_lease_expired() {
+    let thread = ThreadId::new();
+    let binding = NativeBinding {
+        enabled: true,
+        response: Some(ClientSelectionUpdateResponse {
+            status: ClientSelectionUpdateStatus::Updated,
+            server_instance_id: Uuid::new_v4().to_string(),
+            generation: 7,
+            thread_id: Some(thread.to_string()),
+            ready: true,
+            lease_ms: 750,
+            native_core_turn_state: NativeCoreTurnState::Idle,
+        }),
+        sent_at: Some(Instant::now() - Duration::from_millis(/*millis*/ 800)),
+    };
+
+    let mut view = binding.view().unwrap();
+    view.refresh_lease();
+    let view = serde_json::to_value(view).unwrap();
+    assert_eq!(view["leaseMs"], 0);
+    assert!(!binding.matches(Some(thread)));
+}
+
+#[test]
+fn witness_view_fails_closed_without_request_send_time() {
+    let thread = ThreadId::new();
+    let binding = NativeBinding {
+        enabled: true,
+        response: Some(ClientSelectionUpdateResponse {
+            status: ClientSelectionUpdateStatus::Updated,
+            server_instance_id: Uuid::new_v4().to_string(),
+            generation: 7,
+            thread_id: Some(thread.to_string()),
+            ready: true,
+            lease_ms: 750,
+            native_core_turn_state: NativeCoreTurnState::Idle,
+        }),
+        sent_at: None,
+    };
+
+    let mut view = binding.view().unwrap();
+    view.refresh_lease();
+    let view = serde_json::to_value(view).unwrap();
+    assert_eq!(view["leaseMs"], 0);
+}
