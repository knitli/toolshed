+#[tokio::test]
+async fn native_receipt_0059_row_survives_bridge_identity_migration_as_v2_null_identity()
+-> anyhow::Result<()> {
+    let codex_home = unique_temp_dir();
+    tokio::fs::create_dir_all(&codex_home).await?;
+    let sqlite = SqliteConfig::new_for_testing(codex_home.as_path().abs());
+    let pool = sqlite.open_read_write_pool(&sqlite.state_db_path()).await?;
+    let legacy_migrator = Migrator::with_migrations(
+        crate::migrations::STATE_MIGRATOR
+            .migrations
+            .iter()
+            .filter(|migration| migration.version <= 59)
+            .cloned()
+            .collect(),
+    );
+    legacy_migrator.run(&pool).await?;
+
+    let historical = identity(30);
+    sqlx::query(
+        "INSERT INTO native_turn_start_receipts (delivery_id, server_instance_id, selection_generation, attempt_id, thread_id, client_user_message_id, permit_id, permit_issued_at, permit_expires_at, input, stage, turn_id, input_item_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'started', ?, NULL)",
+    )
+    .bind(&historical.delivery_id)
+    .bind(&historical.server_instance_id)
+    .bind(historical.selection_generation.to_string())
+    .bind(&historical.attempt_id)
+    .bind(&historical.thread_id)
+    .bind(&historical.client_user_message_id)
+    .bind(&historical.permit_id)
+    .bind(historical.permit_issued_at.to_string())
+    .bind(historical.permit_expires_at.to_string())
+    .bind(&historical.input)
+    .bind(&historical.client_user_message_id)
+    .execute(&pool)
+    .await?;
+    assert_eq!(
+        sqlx::query_scalar::<_, i64>("SELECT MAX(version) FROM _sqlx_migrations")
+            .fetch_one(&pool)
+            .await?,
+        59
+    );
+    pool.close().await;
+
+    let migrated = runtime(&codex_home).await?;
+    assert_eq!(
+        sqlx::query_scalar::<_, i64>("SELECT MAX(version) FROM _sqlx_migrations")
+            .fetch_one(migrated.pool.as_ref())
+            .await?,
+        60
+    );
+    assert_eq!(
+        sqlx::query_scalar::<_, Option<String>>(
+            "SELECT bridge_client_id FROM native_turn_start_receipts WHERE attempt_id = ?",
+        )
+        .bind(&historical.attempt_id)
+        .fetch_one(migrated.pool.as_ref())
+        .await?,
+        None
+    );
+    assert_eq!(
+        sqlx::query_scalar::<_, Option<String>>(
+            "SELECT bridge_client_generation FROM native_turn_start_receipts WHERE attempt_id = ?",
+        )
+        .bind(&historical.attempt_id)
+        .fetch_one(migrated.pool.as_ref())
+        .await?,
+        None
+    );
+    assert_eq!(
+        migrated.get_native_turn_start_proof(&historical).await?,
+        Some(NativeTurnStartProof::Started {
+            turn_id: historical.client_user_message_id.clone()
+        })
+    );
+    migrated.close().await;
+
+    let reopened = runtime(&codex_home).await?;
+    assert_eq!(
+        reopened.get_native_turn_start_proof(&historical).await?,
+        Some(NativeTurnStartProof::Started {
+            turn_id: historical.client_user_message_id.clone()
+        })
+    );
+    assert_eq!(
+        sqlx::query_scalar::<_, Option<String>>(
+            "SELECT bridge_client_generation FROM native_turn_start_receipts WHERE attempt_id = ?",
+        )
+        .bind(&historical.attempt_id)
+        .fetch_one(reopened.pool.as_ref())
+        .await?,
+        None
+    );
+    Ok(())
+}
