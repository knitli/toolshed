+    let mut receipt = receipt_for(&params);
+    receipt.turn_id = "stable-turn".to_string();
+    let item_id = uuid::Uuid::now_v7().to_string();
+    let cases = [
+        (
+            uuid::Uuid::now_v7().to_string(),
+            "stable-turn".to_string(),
+            params.client_user_message_id.clone(),
+            params.input.clone(),
+        ),
+        (
+            params.thread_id.clone(),
+            "different-turn".to_string(),
+            params.client_user_message_id.clone(),
+            params.input.clone(),
+        ),
+        (
+            params.thread_id.clone(),
+            "stable-turn".to_string(),
+            uuid::Uuid::now_v7().to_string(),
+            params.input.clone(),
+        ),
+        (
+            params.thread_id.clone(),
+            "stable-turn".to_string(),
+            params.client_user_message_id.clone(),
+            "hook-rewritten input".to_string(),
+        ),
+    ];
+
+    for (thread_id, turn_id, client_id, input) in cases {
+        let receipts = Arc::new(Mutex::new(ReceiptStore::default()));
+        insert_committed_receipt(&receipts, &params, receipt.clone());
+        let event = item_completed_event(&thread_id, &turn_id, &client_id, &input, &item_id);
