+#[tokio::test]
+async fn native_receipt_proof_requires_the_exact_bridge_identity() -> anyhow::Result<()> {
+    let runtime = runtime(&unique_temp_dir()).await?;
+    let mut bound = identity(7);
+    bound.bridge_client_id = Some("bridge-7".to_string());
+    bound.bridge_client_generation = Some(7);
+    assert_eq!(
+        runtime.begin_native_turn_start(&bound, &[]).await?,
+        NativeTurnStartBegin::Created
+    );
+    runtime
+        .record_native_turn_started(&bound, &bound.client_user_message_id)
+        .await?;
+
+    let mut unbound = bound.clone();
+    unbound.bridge_client_id = None;
+    unbound.bridge_client_generation = None;
+    assert_eq!(runtime.get_native_turn_start_proof(&unbound).await?, None);
+    assert_eq!(
+        runtime.begin_native_turn_start(&unbound, &[]).await?,
+        NativeTurnStartBegin::Conflict
+    );
+
+    let historical = identity(8);
+    assert_eq!(
+        runtime.begin_native_turn_start(&historical, &[]).await?,
+        NativeTurnStartBegin::Created
+    );
+    runtime
+        .record_native_turn_started(&historical, &historical.client_user_message_id)
+        .await?;
+    let mut reconstructed = historical.clone();
+    reconstructed.bridge_client_id = Some("bridge-8".to_string());
+    reconstructed.bridge_client_generation = Some(8);
+    assert_eq!(
+        runtime.get_native_turn_start_proof(&reconstructed).await?,
+        None,
+        "a bridge identity must not be synthesized for a historical NULL row"
+    );
+    assert_eq!(
+        runtime.get_native_turn_start_proof(&historical).await?,
+        Some(NativeTurnStartProof::Started {
+            turn_id: historical.client_user_message_id.clone()
+        })
+    );
+    assert_eq!(
+        runtime.begin_native_turn_start(&reconstructed, &[]).await?,
+        NativeTurnStartBegin::Conflict
+    );
+
+    let mut partial = identity(9);
+    partial.bridge_client_id = Some("bridge-9".to_string());
+    assert!(
+        runtime
+            .begin_native_turn_start(&partial, &[])
+            .await
+            .is_err()
+    );
+    assert!(runtime.get_native_turn_start_proof(&partial).await.is_err());
+    Ok(())
+}
