+async fn native_start_stays_unknown_when_core_registration_cannot_be_durably_recorded() -> Result<()>
+{
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let codex_home = TempDir::new()?;
+    create_config_toml(codex_home.path(), &server.uri(), "", "")?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized()
+        .await?;
+    let ThreadStartResponse { thread, .. } = app
+        .start_thread(ThreadStartParams {
+            model: Some("gpt-5.2".to_string()),
+            ..Default::default()
+        })
+        .await?;
+    let ClientSelectionUpdateResponse {
+        server_instance_id,
+        generation,
+        ..
+    } = app
+        .request(|request_id| ClientRequest::ClientSelectionUpdate {
+            request_id,
+            params: ClientSelectionUpdateParams {
+                expected_generation: 0,
+                thread_id: Some(thread.id.clone()),
+                ready: true,
+            },
+        })
+        .await?;
+    let now_ms = SystemTime::now().duration_since(UNIX_EPOCH)?.as_millis() as u64;
+    let params = ThreadStartIfIdleParams {
+        server_instance_id,
+        expected_generation: generation,
+        thread_id: thread.id,
+        attempt_id: uuid::Uuid::now_v7().to_string(),
+        delivery_id: format!("native-db-failure-{}", uuid::Uuid::now_v7()),
+        client_user_message_id: uuid::Uuid::now_v7().to_string(),
+        permit_id: format!("permit-{}", uuid::Uuid::now_v7()),
+        permit_issued_at: now_ms,
+        permit_expires_at: now_ms + 5_000,
+        input: "Core may start, but this receipt write will fail".to_string(),
+        bridge_client_id: None,
+        bridge_client_generation: None,
+    };
+
+    let sqlite = codex_state::SqliteConfig::new_for_testing(codex_home.path().abs());
+    let state_db = sqlite.open_read_write_pool(&sqlite.state_db_path()).await?;
+    sqlx::query(
+        "CREATE TRIGGER fail_native_turn_start_receipt_update BEFORE UPDATE OF stage ON native_turn_start_receipts BEGIN SELECT RAISE(ABORT, 'durable receipt unavailable'); END",
+    )
+    .execute(&state_db)
+    .await?;
+    state_db.close().await;
+
+    let first_start: ThreadStartIfIdleResponse = app
+        .request(|request_id| ClientRequest::ThreadStartIfIdle {
+            request_id,
+            params: params.clone(),
+        })
+        .await?;
+    assert_eq!(
+        first_start,
+        ThreadStartIfIdleResponse::Unknown,
+        "an in-memory Core registration cannot be advertised after its durable write fails"
+    );
+    timeout(
+        DEFAULT_READ_TIMEOUT,
+        app.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let initial_count = server
+        .received_requests()
+        .await
+        .context("mock server should receive the actual Core turn")?
+        .len();
+    assert_eq!(initial_count, 1);
+
+    let after_failed_write: ThreadStartReceiptResponse = app
+        .request(|request_id| ClientRequest::ThreadStartReceipt {
+            request_id,
+            params: params.clone(),
+        })
+        .await?;
+    assert_eq!(
+        after_failed_write,
+        ThreadStartReceiptResponse::Unknown,
+        "Core completion without a successful durable write is not receipt evidence"
+    );
+
+    let retry_start: ThreadStartIfIdleResponse = app
+        .request(|request_id| ClientRequest::ThreadStartIfIdle {
+            request_id,
+            params: params.clone(),
+        })
+        .await?;
+    assert_eq!(
+        retry_start,
+        ThreadStartIfIdleResponse::Unknown,
+        "a pending DB reservation remains ambiguous and cannot submit again"
+    );
+    let after_ambiguous_retry: ThreadStartReceiptResponse = app
+        .request(|request_id| ClientRequest::ThreadStartReceipt { request_id, params })
+        .await?;
+    assert_eq!(
+        after_ambiguous_retry,
+        ThreadStartReceiptResponse::Unknown,
+        "an ambiguous reservation must remain fail-closed after retry"
+    );
+    assert_eq!(
+        server
+            .received_requests()
+            .await
+            .context("mock server should retain requests after ambiguous retry")?
+            .len(),
+        initial_count
+    );
+    app.shutdown_gracefully().await?;
+    Ok(())
+}
