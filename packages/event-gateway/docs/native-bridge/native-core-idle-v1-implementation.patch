+#[tokio::test]
+async fn periodic_metadata_selection_gate_keeps_recovery_and_other_origins_fenced() {
+    let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+    let thread_id = ThreadId::new();
+    let session = test_thread_session(thread_id, test_path_buf("/tmp/project"));
+    app.chat_widget.handle_thread_session(session.clone());
+    app.thread_event_channels.insert(
+        thread_id,
+        ThreadEventChannel::new_with_session(THREAD_EVENT_CHANNEL_CAPACITY, session, Vec::new()),
+    );
+    app.activate_thread_channel(thread_id).await;
+    while events.try_recv().is_ok() {}
+    assert!(app.selection_witness_ready());
+    let response = account_rate_limits_response(rate_limit_snapshot(25, None, None));
+    let event = |origin, generation| AppEvent::RateLimitsLoaded {
+        request_id: 1,
+        origin,
+        hard_stop_generation: generation,
+        result: Ok(response.clone()),
+    };
+    assert!(app.periodic_rate_limits_preserve_selection(
+        &event(RateLimitRefreshOrigin::Periodic, 0),
+        events.is_empty()
+    ));
+    let metadata = event(RateLimitRefreshOrigin::Periodic, 0);
+    assert!(app.selection_ready_with_app_events(Some(&metadata), events.is_empty()));
+    assert!(!app.selection_ready_with_app_events(Some(&AppEvent::FollowTranscript), true));
+    app.app_event_tx.send(AppEvent::FollowTranscript);
+    assert!(
+        !app.selection_ready_with_app_events(Some(&metadata), events.is_empty()),
+        "a newly queued event must invalidate the pre-await readiness snapshot"
+    );
+    assert!(
+        !app.periodic_rate_limits_preserve_selection(&metadata, events.is_empty()),
+        "a prefetched periodic response must revoke when a semantic event arrives during the selection acknowledgment await"
+    );
+    assert!(events.try_recv().is_ok());
+    assert!(app.periodic_rate_limits_preserve_selection(&metadata, events.is_empty()));
+
+    assert!(!app.periodic_rate_limits_preserve_selection(
+        &event(RateLimitRefreshOrigin::Recovery, 0),
+        events.is_empty()
+    ));
+    assert!(!app.periodic_rate_limits_preserve_selection(
+        &event(RateLimitRefreshOrigin::Periodic, 1),
+        events.is_empty()
+    ));
+    app.rate_limit_refresh_state.start(
+        RateLimitRefreshOrigin::Recovery,
+        &mut app.rate_limit_hard_stop_generation,
+    );
+    assert!(!app.periodic_rate_limits_preserve_selection(
+        &event(
+            RateLimitRefreshOrigin::Periodic,
+            app.rate_limit_hard_stop_generation
+        ),
+        events.is_empty()
+    ));
+    app.rate_limit_refresh_state.invalidate_recovery();
+    app.reconnect.offline = true;
+    assert!(!app.periodic_rate_limits_preserve_selection(
+        &event(
+            RateLimitRefreshOrigin::Periodic,
+            app.rate_limit_hard_stop_generation
+        ),
+        events.is_empty()
+    ));
+}
