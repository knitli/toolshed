+        last_poll: Instant::now(),
+        binding: NativeBinding::default(),
+        attempts: AttemptLedger::default(),
+    };
+    witness.state.connected(Some(123));
+    witness.state.select(Some(ThreadId::new()), true);
+    witness.binding.response = Some(codex_app_server_protocol::ClientSelectionUpdateResponse {
+        status: codex_app_server_protocol::ClientSelectionUpdateStatus::Updated,
+        server_instance_id: private_payload.to_string(),
+        generation: 17,
+        thread_id: Some(private_payload.to_string()),
+        ready: true,
+        lease_ms: 750,
+        native_core_turn_state: codex_app_server_protocol::NativeCoreTurnState::Idle,
+    });
+    tracing::subscriber::with_default(subscriber, || {
+        witness.trace_revocation(SelectionWitness::server_event_category(Some(&mcp)));
+        witness.state.eligible = false;
+        witness.binding.response.as_mut().unwrap().ready = false;
+        witness.trace_revocation("selection-state-not-ready");
+        witness.state.select(Some(ThreadId::new()), true);
+        witness.last_poll = Instant::now() - Duration::from_millis(/*millis*/ 750);
+        witness.emit("poll");
+        assert!(!witness.state.eligible);
+        let (parent, child) = UnixStream::pair().expect("private transport");
+        drop(parent);
+        witness.transport = Some(Transport::from_stream(child));
+        witness.state.select(Some(ThreadId::new()), true);
+        witness.last_poll = Instant::now();
+        witness.emit("poll");
+        assert!(!witness.state.eligible);
+        assert!(witness.transport.is_none());
+    });
+    let trace = std::fs::read_to_string(output.path()).expect("captured trace");
+    assert!(trace.contains("native selection revocation trigger"));
+    assert!(trace.contains("category=\"server-mcp-status\""));
+    assert!(trace.contains("generation="));
+    assert!(trace.contains("server_generation=17"));
+    assert_eq!(
+        trace
+            .lines()
+            .filter(|line| line.contains("native selection revocation trigger"))
+            .count(),
+        3,
+        "already-unready state must not flood logs"
+    );
+    assert!(trace.contains("category=\"loop-gap\""));
+    assert!(trace.contains("category=\"native-transport-unavailable\""));
+    assert!(!trace.contains(private_payload));
+    assert!(!trace.contains("thread_id"));
+    assert!(!trace.contains("request_id"));
+}
