+fn insert_committed_receipt(
+    receipts: &Arc<Mutex<ReceiptStore>>,
+    params: &ThreadStartIfIdleParams,
+    receipt: NativeReceipt,
+) {
+    let mut receipts = lock(receipts);
+    receipts.by_client_user_message_id.insert(
+        params.client_user_message_id.clone(),
+        params.delivery_id.clone(),
+    );
