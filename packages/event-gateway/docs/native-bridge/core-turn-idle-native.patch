+            request_id,
+            params: ClientSelectionUpdateParams {
+                expected_generation: busy_generation,
+                thread_id: Some(thread.id),
+                ready: true,
+            },
+        })
+        .await?;
+    assert_eq!(native_core_turn_state, NativeCoreTurnState::Idle);
+    server.shutdown().await;
+    Ok(())
