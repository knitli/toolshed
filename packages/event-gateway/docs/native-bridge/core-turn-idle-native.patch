+#[test]
+fn delayed_challenge_refreshes_from_original_sample_deadline() {
+    use std::os::fd::IntoRawFd;
+    let (mut parent, child) = UnixStream::pair().expect("private channel");
+    let transport = Transport::from_inherited_fd(child.into_raw_fd()).expect("adopt capability");
+    let thread = Some(ThreadId::new());
+    let mut witness = SelectionWitness {
+        transport: Some(transport),
+        receipt_version: Some(ReceiptVersion::V2),
+        state: SelectionState::new(),
+        last_poll: Instant::now(),
+        binding: NativeBinding {
+            enabled: true,
+            response: Some(codex_app_server_protocol::ClientSelectionUpdateResponse {
+                status: codex_app_server_protocol::ClientSelectionUpdateStatus::Updated,
+                server_instance_id: Uuid::new_v4().to_string(),
+                generation: 7,
+                thread_id: thread.map(|id| id.to_string()),
+                ready: true,
+                lease_ms: 750,
+                native_core_turn_state: codex_app_server_protocol::NativeCoreTurnState::Busy,
+            }),
+            sent_at: Some(Instant::now() - Duration::from_millis(/*millis*/ 100)),
+        },
+        attempts: AttemptLedger::default(),
+    };
+    witness.state.connected(Some(123));
+    witness.publish(thread, true);
+    let stale_view = witness.binding.view();
+    std::thread::sleep(Duration::from_millis(/*millis*/ 50));
+    parent
+        .write_all(b"{\"nonce\":1}\n")
+        .expect("delayed challenge");
+    witness
+        .transport
+        .as_mut()
+        .expect("witness transport")
+        .poll(&mut witness.state, stale_view)
+        .unwrap_or_else(|_| panic!("challenge response"));
+
+    let mut response = [0; 2048];
+    let count = parent.read(&mut response).expect("challenge response");
+    let row: serde_json::Value = serde_json::from_slice(&response[..count]).expect("response JSON");
+    assert!(
+        row["leaseMs"].as_u64().unwrap() <= 600,
+        "a view captured before the challenge must expire from its original sample deadline"
+    );
 }
 
