{
  "name": "@knitli/openapi-mcp",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "description": "Wraps any openapi schema of any size into an MCP-servable sqlite database for 'code mode' style deployments.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/knitli/toolshed",
    "directory": "packages/openapi-mcp"
  },
  "keywords": [
    "openapi",
    "mcp",
    "model-context-protocol",
    "sqlite",
    "api",
    "codegen"
  ],
  "bin": {
    "openapi-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "catalog:",
    "bun": "catalog:"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "check": "bunx biome check ."
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "typescript": "catalog:typing"
  },
  "devEngines":{
    "node": "catalog:",
    "bun": "catalog:"    
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "@knitli/openapi-mcp-v${version}",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "breaking": true,
              "scope": "openapi-mcp",
              "release": "major"
            },
            {
              "scope": "openapi-mcp",
              "type": "feat",
              "release": "minor"
            },
            {
              "scope": "openapi-mcp",
              "type": "fix",
              "release": "patch"
            },
            {
              "scope": "openapi-mcp",
              "type": "perf",
              "release": "patch"
            },
            {
              "release": true
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": true
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  }
}
